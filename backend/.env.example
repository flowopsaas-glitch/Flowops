# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://flowops:password@localhost:5432/flowops?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_64_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://app.flowops.example

# ── Cloudflare R2 (S3-compatible) ─────────────────────────────────────────
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=flowops-waybills
# Public URL for the bucket (set up a custom domain on the R2 bucket)
CLOUDFLARE_R2_PUBLIC_URL=https://assets.flowops.example

# ── WhatsApp (Meta Business Cloud API) ────────────────────────────────────
# Get from: Meta for Developers → Your App → WhatsApp → API Setup
#
# 1. PHONE_NUMBER_ID: Found in WhatsApp → API Setup (numeric ID, not the phone number itself)
# 2. ACCESS_TOKEN: Permanent system-user token from Business Manager
#    (Settings → Business Settings → System Users → Generate Token)
# 3. WEBHOOK_VERIFY_TOKEN: Any random string you choose — used to verify your webhook
#    endpoint when you register it in Meta Developers → WhatsApp → Configuration
# 4. APP_SECRET: From Meta App → Settings → Basic → App Secret (used to verify webhook signatures)
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_YOUR_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_YOUR_PERMANENT_ACCESS_TOKEN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_ANY_RANDOM_STRING
WHATSAPP_APP_SECRET=CHANGE_ME_YOUR_META_APP_SECRET
WHATSAPP_API_VERSION=v19.0

# ── Paystack ──────────────────────────────────────────────────────────────
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
#
# 1. SECRET_KEY: Server-side only — NEVER expose to frontend
# 2. PUBLIC_KEY: Used in frontend (already handled there)
# 3. WEBHOOK_SECRET: Set in Paystack Dashboard → Settings → API Keys → Webhooks
#    as the "IP Whitelist" secret (Paystack uses this to sign webhook requests)
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME_COPY_FROM_PAYSTACK_DASHBOARD
PAYSTACK_PUBLIC_KEY=pk_test_fa7d0085df63bad80b49faefefb
# Paystack plan codes (Flowops Holdings, ID: 1839930):
# Starter is FREE — no Paystack plan (activated instantly without billing)
# Professional: ZAR 14,999 / month
PAYSTACK_PROFESSIONAL_PLAN_CODE=PLN_l3kobthzahnkpf3
# Enterprise:   ZAR 29,999 / month
PAYSTACK_ENTERPRISE_PLAN_CODE=PLN_9at9kn2ra8jtae0
# Optional: restrict webhooks to Paystack IPs (comma-separated) — see Paystack docs
PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220

# ── SendGrid (transactional email) ────────────────────────────────────────
SENDGRID_API_KEY=SG.CHANGE_ME
SENDGRID_FROM_EMAIL=noreply@flowops.example
SENDGRID_FROM_NAME=FlowOps

# ── OpenTelemetry (optional) ──────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=flowops-backend

# ── Sentry (optional) ─────────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ── Owner (platform super-admin) ──────────────────────────────────────────
# Set this to seed the initial owner account on first boot
OWNER_SEED_EMAIL=owner@flowops.example
OWNER_SEED_PASSWORD=CHANGE_ME_STRONG_PASSWORD


# ── Geocoding (address -> coordinates; powers routing, map, ETA, tracking) ──
# Provider: "nominatim" (default, free OpenStreetMap — no key), "google", or "mapbox".
GEOCODER_PROVIDER=nominatim
# Only needed if GEOCODER_PROVIDER=google
GOOGLE_MAPS_API_KEY=
# Only needed if GEOCODER_PROVIDER=mapbox
MAPBOX_TOKEN=
# Default ISO country code used to bias geocoding results (e.g. za, us, gb)
DEFAULT_COUNTRY=za


# ── AI Accounting Bridge (Xero / Sage) — optional ────────────────────────────
# Connect your accounting system for two-way invoice/credit-note sync.
# Pastel needs nothing here (it's a file export). Xero & Sage need a developer
# app each, with the redirect/callback URL set to:
#   <API_PUBLIC_URL>/accounting/integrations/callback
# API_PUBLIC_URL must be your backend's public base incl. /api/v1
API_PUBLIC_URL=https://api.flowop.work/api/v1
# APP_URL is where users are sent back after connecting (the web app)
APP_URL=https://app.flowop.work
# Xero developer app (https://developer.xero.com) — scopes: accounting.transactions, accounting.contacts
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Sage Accounting developer app (https://developer.sage.com)
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=


# ── CLAW Build Planner → GitHub Issue handoff (optional) ──────────────────────
# Lets the owner console open a real GitHub Issue from a CLAW build plan.
# Use a fine-grained Personal Access Token scoped to ONLY this repo with
# "Issues: Read and write" permission. Server-side only — never exposed to the UI.
GITHUB_REPO=flowopsaas-glitch/Flowops
GITHUB_TOKEN=
