# .env.example - Template for team members (NO REAL SECRETS)

# Core
APP_ENV=production
NODE_ENV=production
APP_KEY=change_me_in_production
JWT_SECRET=your_32+_char_secret_here
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://your-domain.com

# Database (Docker service names)
DATABASE_URL="postgresql://user:pass@flowops-pooler:5432/flowops_engine?schema=public"

# Redis (Docker service names)
REDIS_HOST=flowops-redis
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://:password@flowops-redis:6379

# AI (Groq)
GROQ_API_KEY=

# AI Models (task-based routing for cost optimization)
AI_CHAT_MODEL=llama-3.1-8b-instant
AI_EXTRACT_MODEL=llama-3.3-70b-versatile
AI_REPAIR_MODEL=llama-3.3-70b-versatile
AI_ANALYSIS_MODEL=llama-3.3-70b-versatile
AI_VISION_MODEL=llama-3.2-11b-vision-instruct
AI_FAST_MODEL=llama-3.1-8b-instant
AI_DEFAULT_MODEL=llama-3.1-8b-instant

# AI Behavior
AI_REPAIR_ENABLED=true
AI_DRIVER_ASSIST_LEVEL=FULL_AUTONOMOUS
CLAW_AGGRESSION_LEVEL=HIGH

# Email
SENDGRID_API_KEY=
MAIL_FROM=noreply@your-domain.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
VITE_PAYSTACK_PUBLIC_KEY=

# WhatsApp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_URL=

# Geo
NEUTRINO_API_KEY=
MAPTILER_KEY=

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=flowops-backend

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
FEATURE_NEW_DASHBOARD=false
FEATURE_AI_AUTO_REPLY=true
FEATURE_WHATSAPP_INTEGRATION=true
