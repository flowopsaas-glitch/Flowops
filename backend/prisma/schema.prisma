// ═══════════════════════════════════════════════════════════════════════════
// DAILY HANDSHAKE (Transnet Network Statement — Annexure 28)
//
// Under rail open-access, every 24 hours the Infrastructure Manager (IM) and
// each Train Operating Company (TOC) must reconcile all deviations from the
// planned schedule (ITP) over the past 24h. Each deviation is linked to a
// Train/Slot + Order number, categorised, given a root cause and a responsible
// party (IM | this TOC | another IM | external | force majeure). The IM builds
// a daily 08:00 report; the TOC reviews and either agrees or flags OPEN items;
// unresolved red-flagged items climb an escalation ladder (24h → 48h → 72h →
// Route Logistics Forum → Regulator dispute). FlowOps gives the TOC the clean,
// timestamped, defensible audit trail to win those disputes and avoid paying
// for delays it did not cause.
//
// This is TOC-side (our tenant's view). It does NOT replace the IM's TOMS.
// ═══════════════════════════════════════════════════════════════════════════

model RailHandshakeReport {
  id            String                @id @default(cuid())
  reportNumber  String // HS-2026-00042 (unique per tenant)
  status        HandshakeReportStatus @default(DRAFT)

  // The 24h window this report reconciles (IM issues at 08:00 daily).
  reportDate    DateTime              // the operating day being reconciled
  windowStart   DateTime
  windowEnd     DateTime

  // Counterparty context (who we are handshaking with).
  railOperator  String?               // IM / TOC counterparty name (e.g. TRIM)
  corridor      String?               // North / Cape / Ore / Container ...

  // Sign-off (Annexure 28 steps 11-12).
  signedOffAt   DateTime?
  signedOffBy   String?               // name/role of TOC signatory
  imReference   String?               // IM's TOL report reference

  notes         String?               @db.Text

  companyId     String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  deviations    RailHandshakeDeviation[]

  @@unique([reportNumber, companyId])
  @@index([companyId, status])
  @@index([companyId, reportDate])
  @@map("rail_handshake_reports")
}

model RailHandshakeDeviation {
  id            String   @id @default(cuid())
  reportId      String
  report        RailHandshakeReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Linkage (Annexure 28: every deviation ties to Train/Slot + Order).
  trainSlotRef  String   // Train / Slot reference
  orderNumber   String?  // TOC order number
  consignmentId String?  // optional link to a RailConsignment we already track

  // What happened.
  category      DeviationCategory   @default(OTHER)
  reason        String              @db.Text   // preliminary reason
  rootCause     String?             @db.Text   // determined root cause
  location      String?
  occurredAt    DateTime?
  delayMinutes  Int?                // total delay attributed to this deviation

  // Accountability (Annexure 28: allocated responsible party).
  responsibleParty ResponsibleParty @default(UNDETERMINED)

  // Impact on slots (Annexure 28 step 6).
  slotImpact    SlotImpact          @default(NONE)

  // NS §6.6.1.3.3 mandates ten capture fields per deviation. Two of the ten had
  // no counterpart here (gaps G-4 and G-5) and are added as free text:
  //
  // Other Train Paths impacted — a list of Train/Slot references.
  // SLA KPIs impacted — which of the KPIs the IM measures are affected.
  //
  // Both are evidence obligations on the day-of-operation reconciliation, so an
  // absent field is a completeness gap rather than a cosmetic one. Free text is
  // deliberate: the Annexure 43 KPI set is not yet captured, and inventing an
  // enum for it would encode something the source has not supplied.
  otherTrainPathsImpacted String?             @db.Text
  slaKpisImpacted         String?             @db.Text

  // Financial resolution (Annexure 28: debited within 24h of resolution).
  costZar       Float?              // rand impact / charge under dispute
  costRecovered Boolean             @default(false)

  // Handshake agreement + escalation ladder.
  status        DeviationStatus     @default(LOGGED)
  escalationStage EscalationStage   @default(NONE)
  disputeReason String?             @db.Text   // TOC's reason for flagging OPEN
  resolutionNote String?            @db.Text
  resolvedAt    DateTime?

  // Deadlines derived from the report window (24/48/72/96h ladder).
  escalatedAt   DateTime?           // when it last moved up the ladder
  // Annexure 28: escalated to the Head of Network Service Planning and
  // Operations at 72h, who must resolve within 96h. Set when the item reaches
  // the 72h rung; expiry of this deadline is what moves it to the Forum.
  resolveByAt   DateTime?

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([reportId])
  @@index([status])
  @@index([escalationStage])
  @@map("rail_handshake_deviations")
}

enum HandshakeReportStatus {
  DRAFT        // being assembled / deviations being logged
  PENDING_TOC  // IM issued, awaiting TOC review + sign-off
  SIGNED_OFF   // TOC signed off (may still contain OPEN items)
  DISPUTED     // one or more items lodged with the Regulator
  CLOSED       // all items resolved and filed
}

enum DeviationCategory {
  CANCELLATION       // slot cancelled
  DELAY              // slot delayed
  NO_SHOW            // slot not taken up / not used
  RESCHEDULE         // slot re-scheduled
  INFRASTRUCTURE     // track / signalling / power fault
  ROLLING_STOCK      // loco / wagon fault
  OPERATIONAL        // crew / yard / handover
  SECURITY           // theft / vandalism / cable
  WEATHER            // environmental
  OTHER
}

enum ResponsibleParty {
  UNDETERMINED
  IM              // Infrastructure Manager (Transnet)
  THIS_TOC        // our tenant
  ANOTHER_TOC     // a different operator's knock-on
  EXTERNAL        // parties external to Transnet
  FORCE_MAJEURE
}

enum SlotImpact {
  NONE
  NOT_USED     // slot not taken up
  CANCELLED    // slot cancelled
  RESCHEDULED  // slot moved
  DELAYED      // slot ran late
}

enum DeviationStatus {
  LOGGED       // captured, not yet agreed
  AGREED       // both parties agree cause/party/impact
  OPEN         // TOC disagrees — red-flagged open item
  RESOLVED     // agreement reached after escalation
  DISPUTED     // lodged with the Regulator
}

// The Daily Handshake escalation ladder — Annexure 28, read with
// NS §6.6.1.14.1, §6.6.1.15.3 and §6.6.1.16.
//
//   ≤24h  → TRIM Access Seeker Liaison Manager
//   ≤48h  → TRIM Head of Access Seeker Service
//   ≤96h  → TRIM Head of Network Service Planning and Operations, escalated
//           at 72h and holding the item until a 96h resolve-by deadline
//   >96h  → Route Logistics Forum — a later referral, NOT the third rung
//
// Earlier revisions compressed this ladder: the 72h rung was assigned to the
// Route Logistics Forum and the 96h resolve-by had no counterpart at all. That
// is a substantive error, not a naming quibble — it moves an item to the Forum
// a full day early and drops the deadline that creates the right to escalate.
//
// REGULATOR_DISPUTE is never reached by the clock. It is set explicitly by
// lodgeDispute() once the item has been through the Forum.
//
// The 48h rung carries a name drift that is recorded rather than resolved: the
// Network Statement says "Head of Access Seeker Service", the S5 working says
// "Manager: Customer Service", and the previous code comment said "Head of
// Customer Liaison". See EXC-017 — picking one belongs to the owner and the
// independent reviewer, so no single variant is encoded as the rule here.
enum EscalationStage {
  NONE                    // within tolerance / agreed
  LIAISON_MANAGER_24H     // 24h: TRIM Access Seeker Liaison Manager
  HEAD_LIAISON_48H        // 48h: TRIM Head of Access Seeker Service (name drift, EXC-017)
  HEAD_NSPO_72H           // 72h: TRIM Head of Network Service Planning and Operations
  ROUTE_LOGISTICS_FORUM   // >96h unresolved: referral to the Route Logistics Forum
  REGULATOR_DISPUTE       // after the Forum: dispute with the Regulator
}



// Persisted delivery-intelligence snapshot — written by the daily
// rebuildIntelligence cron so the "learning" is durable (queryable trends over
// time) instead of only being logged. One row per company per rebuild.
model DeliveryIntelligenceStat {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  windowDays    Int      @default(90)   // rolling window the stats were computed over
  totalDeliveries Int    @default(0)
  delivered     Int      @default(0)
  failed        Int      @default(0)
  returned      Int      @default(0)
  successRate   Float    @default(0)    // delivered / total × 100

  computedAt    DateTime @default(now())

  @@index([companyId, computedAt])
  @@map("delivery_intelligence_stats")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PROCESS CONTROL — Process Book (versioned SOPs) → execution → evidence →
// exception ownership → outcome → controlled improvement.
//
// Design rules (see docs/PROCESS-STANDARDISATION-MASTER-DATA-IMPLEMENTATION-
// CHARTER-DRAFT-2026-09-26.md):
//   • An APPROVED ProcessVersion is immutable — changes are made by creating a
//     new version, never by editing history.
//   • Every execution is a ProcessInstance keyed by a tenant-scoped business key
//     that is never reused, so re-delivered events cannot create a second
//     instance for the same physical event.
//   • Evidence, incidents, solutions, outcomes and change proposals are records,
//     not free text, so they can be measured and audited.
//   • Automation is draft/assist-only for high-consequence steps: a rule may
//     raise an incident or notify, but a human resolves it.
// ═══════════════════════════════════════════════════════════════════════════════

enum ProcessLifecycleStatus {
  DRAFT
  PILOT
  APPROVED
  RETIRED
}

enum ProcessStepType {
  MANUAL
  AUTOMATED
  DECISION
  INSPECTION
  APPROVAL
  HANDOFF
  WAIT
}

enum ProcessInstanceStatus {
  IN_PROGRESS
  BLOCKED        // a blocking incident is open — the process cannot advance
  COMPLETED
  ABANDONED
  FAILED
}

enum ProcessStepInstanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  FAILED
  BLOCKED
}

enum ProcessIncidentSeverity {
  MINOR
  MAJOR
  BLOCKING
  CRITICAL
}

enum ProcessIncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  ESCALATED
}

enum ProcessSolutionStatus {
  PROPOSED
  APPROVED
  IMPLEMENTED
  REJECTED
}

enum ProcessOutcomeStatus {
  COMPLETED
  COMPLETED_WITH_EXCEPTIONS
  ABANDONED
  FAILED
}

enum ChangeProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
}

enum ProductApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETIRED
}

enum VariantApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETIRED
}

model ProcessDefinition {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code        String   // stable SOP key, e.g. "WMS.GOODS_RECEIPT"
  name        String
  description String?  @db.Text

  // Display / grouping only — never used as an identity key.
  category    String?
  ownerRole   String?  // role accountable for the standard

  isActive    Boolean  @default(true)

  currentVersionId String?         @unique
  currentVersion   ProcessVersion? @relation("CurrentProcessVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions        ProcessVersion[]
  instances       ProcessInstance[]
  changeProposals ProcessChangeProposal[]
  auditEvents     ProcessAuditEvent[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("process_definitions")
}

model ProcessVersion {
  id           String   @id @default(cuid())
  companyId    String
  definitionId String
  definition   ProcessDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  versionNumber Int                    // sequential per definition, never reused
  status        ProcessLifecycleStatus @default(DRAFT)

  // SHA-256 over the ordered step definitions + automation rules. Lets an audit
  // prove exactly what standard was in force when a process executed.
  contentHash String

  // Lifecycle facts (who/when), kept alongside the status so the Process Book
  // can show provenance instead of just a flag.
  createdById     String?
  submittedForApprovalAt DateTime?
  approvedById    String?
  approvedAt      DateTime?
  pilotStartedAt  DateTime?
  retiredAt       DateTime?
  retiredById     String?

  // Immutability marker. Set when the version reaches APPROVED; the service
  // refuses step/rule edits on an immutable version.
  isImmutable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps            ProcessStepDefinition[]
  automationRules  ProcessAutomationRule[]
  instances        ProcessInstance[]
  implementedProposals ProcessChangeProposal[] @relation("ImplementedInVersion")
  currentForDefinitions ProcessDefinition[]    @relation("CurrentProcessVersion")
  auditEvents      ProcessAuditEvent[]

  @@unique([definitionId, versionNumber])
  @@index([companyId, status])
  @@map("process_versions")
}

model ProcessStepDefinition {
  id        String   @id @default(cuid())
  companyId String
  versionId String
  version   ProcessVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  stepNumber  Int                     // 1..n, execution order within the version
  code        String                  // stable per version, e.g. "INSPECT_QUANTITY"
  name        String
  description String?                 @db.Text
  type        ProcessStepType         @default(MANUAL)

  // Automation intent. `requiresHumanApproval` defaults to true: for
  // high-consequence warehouse/rail decisions the system may prepare an action
  // but a human must confirm it.
  isAutomated          Boolean @default(false)
  requiresHumanApproval Boolean @default(true)

  // Evidence contract and completion rules evaluated by the service.
  requiresEvidence Boolean @default(false)
  evidenceSchema   Json?   // JSON Schema-ish description of accepted evidence
  validationRules  Json?   // machine-checkable completion rules

  // Transitions (step codes within the same version).
  nextStepOnSuccess   String?
  nextStepOnFailure   String?
  nextStepOnException String?

  allowedRoles String[] @default([])
  slaMinutes   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stepInstances       ProcessStepInstance[]
  currentStepForInstances ProcessInstance[] @relation("CurrentProcessStep")
  automationRules     ProcessAutomationRule[]

  @@unique([versionId, stepNumber])
  @@unique([versionId, code])
  @@index([companyId])
  @@map("process_step_definitions")
}

model ProcessAutomationRule {
  id        String   @id @default(cuid())
  companyId String
  versionId String
  version   ProcessVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  stepDefinitionId String?
  stepDefinition   ProcessStepDefinition? @relation(fields: [stepDefinitionId], references: [id], onDelete: Cascade)

  code        String   // e.g. "AUTO_RAISE_VARIANCE_INCIDENT"
  name        String
  description String?  @db.Text

  triggerType   String // STEP_COMPLETED | STEP_FAILED | EVIDENCE_SUBMITTED | TIMEOUT | INCIDENT_RAISED
  triggerConfig Json

  actionType   String // RAISE_INCIDENT | NOTIFY_ROLE | ADVANCE_STEP | CREATE_TASK
  actionConfig Json

  // Guardrails.
  maxRunsPerInstance Int     @default(1)
  requiresHumanApproval Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs AutomationRun[]

  @@unique([versionId, code])
  @@index([companyId, isActive])
  @@map("process_automation_rules")
}

model ProcessInstance {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  definitionId String
  definition   ProcessDefinition @relation(fields: [definitionId], references: [id])

  versionId String
  version   ProcessVersion @relation(fields: [versionId], references: [id])

  // Idempotency: one instance per real-world event, per tenant, forever.
  // The service returns the existing instance when this key is replayed.
  businessKey String

  status ProcessInstanceStatus @default(IN_PROGRESS)

  currentStepId String?
  currentStep   ProcessStepDefinition? @relation("CurrentProcessStep", fields: [currentStepId], references: [id])

  // Snapshot of the inputs that started the instance (goodsReceiptId, PO number,
  // supplier, warehouse …). Written once, never mutated by step execution.
  context Json?

  startedById String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  blockedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stepInstances ProcessStepInstance[]
  incidents     ProcessIncident[]
  automationRuns AutomationRun[]
  outcome       ProcessOutcome?
  auditEvents   ProcessAuditEvent[]

  // Optional bridge to the WMS goods-receipt record this instance governs.
  goodsReceiptId String?       @unique
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])

  @@unique([companyId, businessKey])
  @@index([companyId, definitionId])
  @@index([versionId])
  @@index([companyId, status])
  @@map("process_instances")
}

model ProcessStepInstance {
  id        String   @id @default(cuid())
  companyId String

  instanceId String
  instance   ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  stepDefinitionId String
  stepDefinition   ProcessStepDefinition @relation(fields: [stepDefinitionId], references: [id])

  stepNumber Int
  code       String
  name       String

  // Rework loops are normal in operations, so a step can be executed more than
  // once; `attempt` keeps each execution distinct and auditable.
  attempt Int @default(1)

  status ProcessStepInstanceStatus @default(PENDING)

  startedAt   DateTime?
  completedAt DateTime?
  executedById String?
  executedByName String?

  evidence Json?   // captured per the step's evidenceSchema
  result   Json?   // structured result of the step
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents ProcessIncident[]

  @@unique([instanceId, stepDefinitionId, attempt])
  @@index([instanceId, stepNumber])
  @@index([companyId])
  @@map("process_step_instances")
}

model ProcessIncident {
  id        String   @id @default(cuid())
  companyId String

  instanceId String
  instance   ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  // The step execution that surfaced the incident (null = raised against the
  // instance as a whole, e.g. by an automation rule or a supervisor).
  stepInstanceId String?
  stepInstance   ProcessStepInstance? @relation(fields: [stepInstanceId], references: [id])

  code        String // e.g. "QUANTITY_VARIANCE", "DAMAGED_GOODS", "PUT_AWAY_MISSING"
  name        String
  description String? @db.Text

  severity ProcessIncidentSeverity @default(MINOR)
  status   ProcessIncidentStatus   @default(OPEN)

  // A blocking incident stops the process; the instance moves to BLOCKED and
  // step execution is refused until a human resolves it.
  isBlocking Boolean @default(false)

  evidence   Json?
  detectedBy String? // user id or "AUTOMATION"
  detectedAt DateTime @default(now())

  resolvedById   String?
  resolvedByName String?
  resolvedAt     DateTime?
  resolution     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solutions       ProcessSolution[]
  changeProposals ProcessChangeProposal[]

  @@index([instanceId, status])
  @@index([companyId, severity])
  @@map("process_incidents")
}

model ProcessSolution {
  id        String   @id @default(cuid())
  companyId String

  incidentId String
  incident   ProcessIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String @db.Text

  proposedById   String?
  proposedByName String?
  proposedAt     DateTime @default(now())

  status ProcessSolutionStatus @default(PROPOSED)

  approvedById    String?
  approvedAt      DateTime?
  implementedById String?
  implementedAt   DateTime?
  evidence        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incidentId])
  @@index([companyId, status])
  @@map("process_solutions")
}

model ProcessOutcome {
  id        String   @id @default(cuid())
  companyId String

  instanceId String         @unique
  instance   ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  status ProcessOutcomeStatus @default(COMPLETED)

  // Measured facts — the raw material for proactive operations.
  completedSteps         Int     @default(0)
  totalSteps             Int     @default(0)
  incidentCount          Int     @default(0)
  blockingIncidentCount  Int     @default(0)
  durationMinutes        Int?
  firstTimeRight         Boolean @default(false)

  evidence  Json?
  artifacts Json?

  lessonsLearned String? @db.Text

  completedById   String?
  completedByName String?
  completedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changeProposals ProcessChangeProposal[]

  @@index([companyId, status])
  @@index([companyId, completedAt])
  @@map("process_outcomes")
}

model ProcessChangeProposal {
  id        String   @id @default(cuid())
  companyId String

  definitionId String
  definition   ProcessDefinition @relation(fields: [definitionId], references: [id])

  // What triggered the proposal: a measured outcome, a recurring incident, or
  // both. Proposals are the only sanctioned route to changing a standard.
  outcomeId String?
  outcome   ProcessOutcome? @relation(fields: [outcomeId], references: [id])

  incidentId String?
  incident   ProcessIncident? @relation(fields: [incidentId], references: [id])

  title           String
  description     String @db.Text
  proposedChanges Json   // structured diff of steps / rules

  proposedById   String?
  proposedByName String?
  proposedAt     DateTime @default(now())

  status ChangeProposalStatus @default(DRAFT)

  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNotes    String? @db.Text

  implementedInVersionId String?
  implementedInVersion   ProcessVersion? @relation("ImplementedInVersion", fields: [implementedInVersionId], references: [id])
  implementedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([definitionId, status])
  @@index([companyId, status])
  @@map("process_change_proposals")
}

model AutomationRun {
  id        String   @id @default(cuid())
  companyId String

  ruleId String
  rule   ProcessAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  instanceId String
  instance   ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  stepInstanceId String?

  triggerData  Json
  actionResult Json?
  success      Boolean
  error        String? @db.Text

  executedAt DateTime @default(now())

  @@index([instanceId])
  @@index([ruleId])
  @@index([companyId, executedAt])
  @@map("automation_runs")
}

model ProcessAuditEvent {
  id        String   @id @default(cuid())
  companyId String

  definitionId String?
  definition   ProcessDefinition? @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  versionId    String?
  version      ProcessVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  instanceId   String?
  instance     ProcessInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  // CREATED | VERSION_CREATED | VERSION_SUBMITTED | VERSION_APPROVED | VERSION_PILOTED
  // | VERSION_RETIRED | INSTANCE_STARTED | STEP_STARTED | STEP_COMPLETED | STEP_FAILED
  // | INCIDENT_RAISED | INCIDENT_RESOLVED | SOLUTION_PROPOSED | SOLUTION_APPROVED
  // | OUTCOME_RECORDED | CHANGE_PROPOSED | CHANGE_APPROVED | CHANGE_IMPLEMENTED
  // | AUTOMATION_RUN | ACCESS_DENIED
  eventType String

  actorId   String // user id, or "SYSTEM" / "AUTOMATION"
  actorName String?

  beforeState Json?
  afterState  Json?

  description String  @db.Text
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([definitionId])
  @@index([instanceId])
  @@map("process_audit_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRODUCT MASTER — Product / ProductVariant / SKU separation with approval and
// immutable audit history.
//
// Design rules:
//   • A Product is the commercial item; a ProductVariant is the physical thing
//     that carries stock; a SKU is a tenant-scoped allocated number that is
//     never reused once issued.
//   • No rows are pre-created for future stock — a variant exists when someone
//     onboards it, not when a spreadsheet predicts it.
//   • Approved master data is changed through a new state, never by silently
//     rewriting the old one; every change writes a MasterDataAuditEvent.
// ═══════════════════════════════════════════════════════════════════════════════

model Product {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code        String // tenant-scoped product code, e.g. "PROD-001"
  name        String
  description String? @db.Text

  category      String?
  subCategory   String?
  brand         String?
  unitOfMeasure String  @default("EA")

  status ProductApprovalStatus @default(DRAFT)

  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?

  // Master-data revisions: a material change creates a new revision linked to
  // the one it supersedes, so history is never overwritten.
  revision         Int      @default(1)
  previousRevisionId String?  @unique
  previousRevision   Product? @relation("ProductRevisions", fields: [previousRevisionId], references: [id])
  supersededBy       Product? @relation("ProductRevisions")

  // Normalised fingerprint of the defining attributes (name/category/brand/UoM)
  // used to detect near-duplicate onboarding.
  attributeFingerprint String?

  weightKg   Float?
  volumeCbm  Float?
  dimensions String?

  isActive               Boolean @default(true)
  isHazardous            Boolean @default(false)
  hazardousClass         String?
  requiresBatchTracking  Boolean @default(false)
  requiresSerialTracking Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants    ProductVariant[]
  aliases     ProductAlias[]
  auditEvents MasterDataAuditEvent[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, attributeFingerprint])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  companyId String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  code        String // tenant-scoped variant code, e.g. "PROD-001-RED-L"
  name        String
  description String? @db.Text

  // Defining attributes (colour, size, pack size, spec …). The fingerprint is a
  // SHA-256 over the *normalised* attribute set so that "RED " and "red" do not
  // create two variants of the same thing.
  attributes           Json
  attributeFingerprint String

  // SKU is allocated from a tenant-scoped sequence and is never reused.
  sku            String?
  skuAllocatedAt DateTime?

  status VariantApprovalStatus @default(DRAFT)

  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?

  weightKg   Float?
  volumeCbm  Float?
  dimensions String?

  isActive        Boolean @default(true)
  reorderPoint    Int?
  reorderQuantity Int?

  // Optimistic concurrency guard — master-data edits are rejected when the
  // caller's revision is stale.
  revision Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases        ProductAlias[]
  inventoryItems InventoryItem[]
  auditEvents    MasterDataAuditEvent[]

  @@unique([companyId, code])
  @@unique([companyId, sku])
  @@unique([companyId, attributeFingerprint])
  @@index([companyId, productId])
  @@index([companyId, status])
  @@map("product_variants")
}

model ProductAlias {
  id        String   @id @default(cuid())
  companyId String

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // BARCODE | SUPPLIER_CODE | CUSTOMER_CODE | INTERNAL | LEGACY
  type  String
  value String

  // Optional context — the same supplier code can mean different things for
  // different suppliers, resolved by supplierRef.
  supplierRef String?
  customerRef String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, type, value, supplierRef, customerRef])
  @@index([companyId, productId])
  @@index([companyId, variantId])
  @@map("product_aliases")
}

// Tenant-scoped SKU allocator. One row per tenant; `nextNumber` only ever moves
// forward. Allocation happens inside a transaction with a row lock, so two
// concurrent onboardings can never be handed the same SKU.
model SkuSequence {
  id        String @id @default(cuid())
  companyId String @unique

  nextNumber Int    @default(1)
  prefix     String @default("SKU")
  // e.g. "SKU-00001"
  format     String @default("SKU-{number:05d}")

  updatedAt DateTime @updatedAt

  @@map("sku_sequences")
}

model MasterDataAuditEvent {
  id        String   @id @default(cuid())
  companyId String

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // PRODUCT_CREATED | PRODUCT_UPDATED | PRODUCT_SUBMITTED | PRODUCT_APPROVED
  // | PRODUCT_REJECTED | PRODUCT_RETIRED | VARIANT_CREATED | VARIANT_UPDATED
  // | VARIANT_APPROVED | VARIANT_REJECTED | VARIANT_RETIRED | SKU_ALLOCATED
  // | ALIAS_ADDED | ALIAS_REMOVED | DUPLICATE_FINGERPRINT_BLOCKED
  // | CONCURRENT_EDIT_REJECTED | ACCESS_DENIED
  eventType String

  actorId   String
  actorName String?

  beforeState Json?
  afterState  Json?

  description String  @db.Text
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([productId])
  @@index([variantId])
  @@map("master_data_audit_events")
}


// ═══════════════════════════════════════════════════════════════════════════
// RAIL — REFERENCE DATA, SLOT APPLICATIONS & OPERATOR COMPLIANCE  (Wave 2)
//
// Requirements: RAIL-005 (access application + Annexure 25 self-screening),
// RAIL-006 (access prerequisites / controlled documents), RAIL-008, RAIL-012
// (train-path management). Evidence ledger: docs/RAIL-RASA-AUDIT-2026-10-02.md.
//
// Strictly additive. Deliberately NO foreign keys: like the older rail tables
// (RailHandshakeDeviation.consignmentId), links are plain scalar references that the
// service layer verifies per tenant, so this migration contains only CREATE TYPE,
// CREATE TABLE, CREATE INDEX and ALTER TABLE ... ADD COLUMN.
//
// Reference tables (rail_corridor_nodes, rail_yard_specs) are PLATFORM-WIDE and
// read-only to tenants. Every technical field is nullable: NULL means "not in any
// supplied source" — it is never zero and never "unlimited".
// ═══════════════════════════════════════════════════════════════════════════

enum RailGauge {
  CAPE_1067MM      // 1067 mm
  NARROW_610MM     // 610 mm
  STANDARD_1435MM  // 1435 mm
}

enum RailElectrification {
  DC_3KV   // 3 kV DC
  AC_25KV  // 25 kV AC
  AC_50KV  // 50 kV AC
  DIESEL
}

enum RailVehicleProfile {
  A
  B
  B_PLUS_1  // "B+1"
}

enum RailDataStatus {
  SOURCE_PENDING  // identity known; technical data not yet loaded from a cited source
  VERIFIED        // loaded from a cited source and reviewed
}

enum RailComplianceDocType {
  RSR_PERMIT
  INSURANCE
  ROLLING_STOCK_CERT
  TRAIN_CREW_CERT
  DANGEROUS_GOODS
  INTERFACE_AGREEMENT
  ACCESS_CONTRACT
  SECURITY_DEPOSIT
}

enum RailComplianceDocStatus {
  PENDING_REVIEW  // entered, not yet verified by an authorised representative
  VALID
  EXPIRED
  REVOKED
}

enum RailSlotApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_ASSESSMENT
  CAPACITY_CONFLICT
  ALLOCATED
  REJECTED
  EXPIRED
}

// One of the V4 corridors (Container, Cape, Ore, North, North-East, Central).
model RailCorridorNode {
  id                String               @id @default(cuid())
  code              String               @unique // e.g. COR-ORE
  name              String               // V4 corridor name
  aliases           String[]             @default([]) // pre-V4 names (register EXC-020)
  workbookRoutes    String[]             @default([]) // Annexure 33b route names (indicative, SRC §11.4)
  sortOrder         Int                  @default(0)

  // Technical envelope — NULL / empty = not supplied.
  gauge             RailGauge?
  electrification   String[]             @default([]) // RailElectrification values supported
  maxAxleLoadTonnes Float?
  vehicleProfile    RailVehicleProfile?
  maxTrainLengthM   Int?

  contacts          Json?                // role mailboxes / functions only — no personal data (POPIA)
  dataStatus        RailDataStatus       @default(SOURCE_PENDING)
  sourceRef         String?
  verifiedBy        String?
  verifiedAt        DateTime?
  notes             String?              @db.Text
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("rail_corridor_nodes")
}

// A transfer yard. corridorCode is a soft reference to rail_corridor_nodes.code.
model RailYardSpec {
  id                   String               @id @default(cuid())
  code                 String               @unique
  name                 String
  corridorCode         String?
  isTransferYard       Boolean              @default(true)

  gauge                RailGauge?
  electrification      String[]             @default([])
  maxAxleLoadTonnes    Float?
  vehicleProfile       RailVehicleProfile?
  maxTrainLengthM      Int?
  sidingCapacityWagons Int?

  contacts             Json?
  dataStatus           RailDataStatus       @default(SOURCE_PENDING)
  sourceRef            String?
  verifiedBy           String?
  verifiedAt           DateTime?
  notes                String?              @db.Text
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([corridorCode])
  @@map("rail_yard_specs")
}

// A tenant's controlled document for the access prerequisites (RSR permit, insurance, …).
// Several rows per type are normal (renewals); the gate asks "is there a VALID one covering today?".
model RailOperatorComplianceDoc {
  id               String                  @id @default(cuid())
  companyId        String
  docType          RailComplianceDocType
  status           RailComplianceDocStatus @default(PENDING_REVIEW)
  referenceNumber  String?
  issuer           String?
  validFrom        DateTime
  validUntil       DateTime
  documentUrl      String?                 // pointer to controlled storage — never the binary
  notes            String?                 @db.Text
  verifiedAt       DateTime?
  verifiedById     String?
  verifiedByEmail  String?
  revokedAt        DateTime?
  revokedReason    String?                 @db.Text
  createdById      String?
  createdByEmail   String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([companyId, docType])
  @@index([companyId, validUntil])
  @@map("rail_operator_compliance_docs")
}

// A TOC's application for Train Path (slot) capacity — recorded, never granted, by FlowOps.
model RailSlotApplication {
  id                       String                    @id @default(cuid())
  companyId                String
  applicationNumber        String                    // SA-2026-00042 (unique per tenant)
  status                   RailSlotApplicationStatus @default(DRAFT)

  // What is being applied for
  corridorCode             String                    // soft reference to rail_corridor_nodes.code
  originName               String?
  destinationName          String?
  originYardCode           String?
  destinationYardCode      String?
  railOperator             String?
  imReference              String?                   // the IM's TOL reference
  tractionType             RailElectrification?
  commodity                String?
  isDangerousGoods         Boolean                   @default(false)
  trainsPerWeek            Int?
  wagonsPerTrain           Int?
  annualTonnes             Float?

  // Rolling-stock particulars used by the corridor-envelope check
  gauge                    RailGauge?
  axleLoadTonnes           Float?
  vehicleProfile           RailVehicleProfile?
  trainLengthM             Int?

  // Validity window — requested, then allocated (each at most 5 years)
  requestedFrom            DateTime
  requestedUntil           DateTime
  validFrom                DateTime?
  validUntil               DateTime?

  // Annexure 25 self-screening (cover page of the application)
  selfScreening            Json?
  selfScreeningAccessType  String?                   // "Network A" | "Network B"
  selfScreeningCompletedAt DateTime?

  // Gate snapshots taken at submission
  envelopeCheckStatus      String?                   // COMPATIBLE | INCOMPATIBLE | UNVERIFIED
  envelopeCheck            Json?
  complianceSnapshot       Json?

  // Lifecycle
  submittedAt              DateTime?
  assessmentStartedAt      DateTime?
  conflictFlaggedAt        DateTime?
  conflictNote             String?                   @db.Text
  allocatedAt              DateTime?
  mobilizeBy               DateTime?                 // allocatedAt + 60 days
  firstOperatedAt          DateTime?
  forfeitureFlaggedAt      DateTime?                 // set automatically if unoperated at mobilizeBy
  rejectedAt               DateTime?
  rejectionReason          String?                   @db.Text
  expiredAt                DateTime?

  consignmentId            String?                   // optional link to a RailConsignment
  createdById              String?
  createdByEmail           String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([companyId, applicationNumber])
  @@index([companyId, status])
  @@index([companyId, corridorCode])
  @@index([status, mobilizeBy])
  @@map("rail_slot_applications")
}


// ═══════════════════════════════════════════════════════════════════════════
// RAIL — CANCELLATION / RESCHEDULING, POSSESSIONS, OCCURRENCES, DANGEROUS GOODS  (Wave 3)
//
// Requirements: RAIL-007 (flexing), RAIL-009 (reserved in the register — the brief assigns it here),
// RAIL-010, RAIL-011, RAIL-013 (cancellation consequences), RAIL-015 (occurrences).
// Sources: Annexure 20a (process), 20b (82 reasons), 21 (Clearinghouse windows) — all supplied;
// Annexures 13 / 23 / 24 / 41 were NOT supplied, so possession and occurrence parameters that the
// brief attributes to them are modelled generically and flagged unverified in the audit ledger.
//
// Strictly additive, and again NO foreign keys (scalar references verified by the service layer).
// rail_cancellation_codes is PLATFORM-WIDE reference data; the other three tables are tenant-scoped.
// ═══════════════════════════════════════════════════════════════════════════

enum RailCancellationParty {
  RAIL_OPERATIONS         // Annexure 20b "Rail Operations" — the train-operating side (TOC)
  INFRASTRUCTURE_MANAGER  // TRIM
  FORCE_MAJEURE
  ALLOCATION_REQUIRED     // the annexure says "Could be …": decided at the Clearinghouse
}

enum RailAttribution {
  TRIM
  TOC
  FORCE_MAJEURE
  UNDETERMINED
}

enum RailChangeKind {
  CANCEL
  RESCHEDULE
  REPLAN
}

enum RailChangeInitiator {
  TOC
  YARD_OPERATOR
  TRIM
  PORT_TERMINAL_OPERATOR
  PRASA_OTHER_IM
}

enum RailChangeStatus {
  SUBMITTED
  ACKNOWLEDGED
  ALTERNATIVE_PROPOSED
  ACCEPTED
  CANCELLED_CONFIRMED
  CLOSED
}

enum RailPossessionKind {
  ANNUAL_PLAN
  LOCKED_60_DAY
  AD_HOC_EMERGENCY
}

enum RailPossessionStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RailOccurrenceType {
  DERAILMENT
  COLLISION
  OHTE_CABLE_THEFT
  SPAD
  HAZMAT_SPILL
  OTHER
}

enum RailOccurrenceLevel {
  LEVEL_1_CODE_GREEN   // minor
  LEVEL_2_CODE_ORANGE  // major
  LEVEL_3_CODE_RED     // disaster
}

enum RailOccurrenceStatus {
  REPORTED
  UNDER_INVESTIGATION
  PRELIMINARY_REPORT_FILED
  CLOSED
}

// Annexure 20b, one row per source row (FlowOps-assigned code CNX-nnn). Platform-wide.
model RailCancellationCode {
  id               String                @id @default(cuid())
  code             String                @unique // CNX-001
  sourceRow        Int
  reason           String
  responsibleParty RailCancellationParty
  possibleParties  String[]              @default([]) // for ALLOCATION_REQUIRED rows
  sourceText       String                // the "Responsible Party" cell, verbatim
  annexureVersion  String
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("rail_cancellation_codes")
}

// A cancel / reschedule / re-plan of a TOC train (Annexure 20a), with its 20b reason, attribution and commercial
// consequence. Snapshots the reason text and the 20b allocation so history survives a catalog change.
model RailSlotChangeRequest {
  id                    String                @id @default(cuid())
  companyId             String
  requestNumber         String                // CR-2026-00042 (unique per tenant)
  kind                  RailChangeKind
  status                RailChangeStatus      @default(SUBMITTED)
  initiatedBy           RailChangeInitiator

  cancellationCode      String                // soft reference to rail_cancellation_codes.code
  cancellationReason    String
  codeResponsibleParty  RailCancellationParty // the 20b allocation, as it was when logged
  attribution           RailAttribution       @default(UNDETERMINED)
  isForceMajeure        Boolean               @default(false)
  isPlannedOccupation   Boolean               @default(false)

  trainSlotRef          String
  slotApplicationId     String?
  consignmentId         String?
  handshakeReportId     String?
  handshakeDeviationId  String?

  originalDeparture     DateTime?
  proposedDeparture     DateTime?
  eventOccurredAt       DateTime?             // when the cause happened (15-minute notice clock)
  requestedAt           DateTime              @default(now())
  acknowledgedAt        DateTime?             // the IM must acknowledge within 1 hour
  noticeLateMinutes     Int?                  // minutes beyond the 15-minute notice, when late
  hoursBeforeDeparture  Float?
  noticeBand            String                // SHORT_NOTICE | PLANNING_VERSION | AFTER_DEPARTURE | UNKNOWN
  commercialWindow      String                // INSIDE_72H | OUTSIDE_72H | UNKNOWN

  consequence           String                // see rail-change.rules.ts
  penaltyApplicable     Boolean               @default(false)
  penaltyAgainst        String?               // TOC | TRIM
  penaltyBasis          String?               @db.Text
  requiresStaging       Boolean               @default(false)
  replacementAccepted   Boolean?
  note                  String?               @db.Text
  closedAt              DateTime?
  createdById           String?
  createdByEmail        String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([companyId, requestNumber])
  @@index([companyId, status])
  @@index([companyId, consignmentId])
  @@index([companyId, trainSlotRef])
  @@map("rail_slot_change_requests")
}

// An IM possession / occupation window on a corridor, recorded by the tenant.
model RailPossessionWindow {
  id              String               @id @default(cuid())
  companyId       String
  corridorCode    String               // soft reference to rail_corridor_nodes.code
  kind            RailPossessionKind
  status          RailPossessionStatus @default(PLANNED)
  title           String
  location        String?
  description     String?              @db.Text
  imReference     String?
  startsAt        DateTime
  endsAt          DateTime
  noticeGivenAt   DateTime?
  createdById     String?
  createdByEmail  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([companyId, corridorCode, startsAt])
  @@index([companyId, status])
  @@map("rail_possession_windows")
}

// A safety / security occurrence (derailment, collision, OHTE / cable theft, SPAD, hazmat spill …).
model RailOccurrenceReport {
  id                       String               @id @default(cuid())
  companyId                String
  occurrenceNumber         String               // OR-2026-00042 (unique per tenant)
  type                     RailOccurrenceType
  level                    RailOccurrenceLevel
  status                   RailOccurrenceStatus @default(REPORTED)
  corridorCode             String?
  location                 String?
  trainSlotRef             String?
  consignmentId            String?
  deviationId              String?              // the Daily Handshake deviation it was logged as
  auditLogId               String?              // the audit_logs row written when it was reported
  occurredAt               DateTime
  description              String               @db.Text
  responsibleParty         RailAttribution      @default(UNDETERMINED)
  fatalities               Boolean              @default(false)
  hazmatInvolved           Boolean              @default(false)
  reportedToTcoAt          DateTime?
  reportedToRsrAt          DateTime?
  preliminaryReportDueAt   DateTime?            // occurredAt + 48 hours
  preliminaryReportFiledAt DateTime?
  investigationNote        String?              @db.Text
  closedAt                 DateTime?
  createdById              String?
  createdByEmail           String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@unique([companyId, occurrenceNumber])
  @@index([companyId, status])
  @@index([companyId, occurredAt])
  @@map("rail_occurrence_reports")
}

// ═════════════════════════════════════════════════════════════════════════════
// Wave 4 — tariffs, ancillary services, weighbridge overload hold (RAIL-013 / 014 / 015)
// Strictly additive. Money is Float, as everywhere else in this schema; arithmetic goes through common/money.util.
// NOTHING below is priced by default: every rate is nullable and stays NULL until it is loaded from a cited source.
// ═════════════════════════════════════════════════════════════════════════════

enum RailHoldStatus {
  NONE
  HOLD_FOR_LOAD_ADJUSTMENT // an overloaded wagon has not been re-weighed within its limit
}

enum RailPriceStatus {
  NOT_PUBLISHED // the annexure lists the service without a price
  TBD           // the annexure says "TBD" — not zero, not free
  PUBLISHED     // a rate was loaded from a published tariff (requires unitRateZar and rateSourceRef)
}

enum RailAncillaryGroup {
  RAIL
  TELECOMS
  SAFETY_EMERGENCY
  PROPERTY
}

enum RailLimitSource {
  CORRIDOR // the VERIFIED corridor's maximum axle load
  MANUAL   // entered with the reading; not checked against the corridor
  NONE     // no limit known — the reading cannot be checked
}

enum RailWeighStatus {
  WITHIN_LIMIT
  OVERLOADED
  UNVERIFIED // no limit (or axle count) known, so the reading cannot be judged — never a pass
}

enum RailTariffCalcStatus {
  PRICED     // every line has an amount
  INCOMPLETE // saved, but at least one line has no loaded rate — no invoice draft until it does
}

// Platform-wide. One row per corridor and financial year. NO ROW IS SEEDED: the c/GTK tables (Network Statement
// Section 5) were not supplied. The calculator prices only from a VERIFIED row that has a loaded rate.
model RailTariffSchedule {
  id                         String         @id @default(cuid())
  corridorCode               String         // soft reference to rail_corridor_nodes.code
  financialYear              String         // "2026/27"
  loadedCentsPerGtk          Float?         // cents per gross tonne-kilometre, loaded train
  emptyCentsPerGtk           Float?         // cents per GTK, empty return
  dieselLitresPer1000Gtk     Float?         // consumption factor (not supplied)
  electricKwhPer1000Gtk      Float?         // consumption factor (not supplied)
  dieselPricePerLitreZar     Float?         // when NULL the calculator uses the brief's base price and says so
  electricityPricePerKwhZar  Float?         // NULL ⇒ electric traction cannot be priced
  overloadPenaltyPerTonneZar Float?         // NULL ⇒ the overload penalty line stays unpriced
  currency                   String         @default("ZAR")
  dataStatus                 RailDataStatus @default(SOURCE_PENDING)
  sourceRef                  String?        // where the rates came from (required for VERIFIED)
  notes                      String?        @db.Text
  isActive                   Boolean        @default(true)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@unique([corridorCode, financialYear])
  @@index([financialYear])
  @@map("rail_tariff_schedules")
}

// Platform-wide: Annexure 40, one row per priced line (113). The annexure publishes NO prices: unitRateZar is NULL
// and stays NULL until a published tariff is loaded.
model RailAncillaryServiceCatalog {
  id              String             @id @default(cuid())
  code            String             @unique // ANX40-01, ANX40-04-02
  serviceNumber   Int
  serviceName     String
  name            String
  sourceLabel     String?
  section         String?
  description     String?            @db.Text
  unitOfMeasure   String             // verbatim from the annexure
  tier            Int
  tierName        String
  serviceGroup    RailAncillaryGroup
  isCompulsory    Boolean            @default(false)
  priceStatus     RailPriceStatus
  unitRateZar     Float?
  rateSourceRef   String?
  annexureVersion String             // "2026/27"
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([serviceNumber])
  @@index([tier])
  @@map("rail_ancillary_services")
}

// Append-only. The most recently RECORDED reading of a wagon decides whether its consignment is held.
model RailWeighbridgeReading {
  id                String          @id @default(cuid())
  companyId         String
  consignmentId     String
  wagonId           String?
  wagonNumber       String
  weighbridge       String?
  weighedAt         DateTime
  actualTonnes      Float           // gross mass of the wagon on the weighbridge
  axles             Int?
  maxAxleLoadTonnes Float?          // the limit this reading was judged against
  limitSource       RailLimitSource @default(NONE)
  corridorCode      String?
  allowedTonnes     Float?          // maxAxleLoadTonnes × axles
  excessTonnes      Float?          // actualTonnes − allowedTonnes, when overloaded
  status            RailWeighStatus
  note              String?         @db.Text
  createdById       String?
  createdByEmail    String?
  createdAt         DateTime        @default(now())

  @@index([companyId, consignmentId, createdAt])
  @@map("rail_weighbridge_readings")
}

// A saved tariff calculation for one consignment. A BLOCKED calculation (no loaded rate, no weights …) is never saved.
model RailTariffCalculation {
  id                String               @id @default(cuid())
  companyId         String
  calculationNumber String               // TC-2026-00042 (unique per tenant)
  consignmentId     String
  consignmentNumber String
  corridorCode      String
  financialYear     String
  scheduleId        String?              // the rail_tariff_schedules row the rates came from
  status            RailTariffCalcStatus
  inputs            Json
  lines             Json
  blockers          Json
  warnings          Json
  gtkLoaded         Float?
  gtkEmpty          Float?
  subtotalZar       Float
  currency          String               @default("ZAR")
  holdTriggered     Boolean              @default(false)
  invoiceDraftId    String?              // set once, atomically — this is what makes "Generate Invoice Draft" idempotent
  invoiceDraftedAt  DateTime?
  createdById       String?
  createdByEmail    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([companyId, calculationNumber])
  @@index([companyId, consignmentId])
  @@map("rail_tariff_calculations")
}

// ── Terminal truck appointments (road side of the road<->rail handoff) ──────
// lapo gap: terminals absorb variability because trucks arrive unscheduled
// and queue. An appointment is a booked window at a terminal/yard gate,
// owned by the terminal workflow in this tenant, worked through
// BOOKED -> ARRIVED -> LOADING -> COMPLETED with NO_SHOW / CANCELLED exits.
// Wait and dwell figures are computed from recorded timestamps only.

enum TruckAppointmentStatus {
  BOOKED
  ARRIVED
  LOADING
  COMPLETED
  NO_SHOW
  CANCELLED
}

model TerminalTruckAppointment {
  id            String                 @id @default(cuid())
  companyId     String
  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  consignmentId String?
  consignment   RailConsignment?       @relation(fields: [consignmentId], references: [id], onDelete: SetNull)
  legId         String?
  leg           IntermodalLeg?         @relation(fields: [legId], references: [id], onDelete: SetNull)

  terminalName  String                 // terminal / yard name (operator-entered)
  haulierName   String                 // haulier company (operator-entered)
  vehicleReg    String
  // `driverName` is the operator-typed label and stays as the display value.
  // `driverId` is the resolved link to a Driver row in THIS tenant — it is what
  // makes "notify the assigned driver" a real recipient instead of a guess, and
  // what lets the closed loop say DRIVER NOT ASSIGNED when there is none.
  driverName    String?
  driverId      String?
  driver        Driver?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  purpose       String                 @default("DELIVERY") // DELIVERY | COLLECTION

  windowStart   DateTime
  windowEnd     DateTime
  arrivedAt     DateTime?
  loadingAt     DateTime?
  completedAt   DateTime?

  // Current window version. 1 = the window as booked; every published window
  // change increments it and writes a TerminalTruckWindowChange row, so the
  // appointment's window is never silently overwritten — the superseded values
  // live on the change history.
  windowVersion Int                    @default(1)

  // Versioned window-change history + acknowledgement fan-out (newest first).
  windowChanges    TerminalTruckWindowChange[]
  windowRecipients TerminalTruckWindowRecipient[]

  status        TruckAppointmentStatus @default(BOOKED)
  bookedBy      String?
  note          String?                @db.Text

  // Unguessable token for the read-only counterparty (haulier/terminal)
  // shared view. Null = not shared. Revoking sets it back to null.
  //
  // `shareTokenExpiresAt` is enforced on every token issued from 2026-10-28
  // onward. Links issued before that have it null: they stay READABLE (so a
  // link already in a haulier's inbox does not break) but they can no longer be
  // used to ACKNOWLEDGE a window change — an unauthenticated mutation on a
  // token with no recorded expiry is exactly what the closed loop must not
  // allow. The operator rotates the link to restore acknowledgement.
  shareToken         String?   @unique
  shareTokenIssuedAt DateTime?
  shareTokenExpiresAt DateTime?

  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([companyId, windowStart])
  @@index([companyId, status])
  @@index([consignmentId])
  @@index([driverId])
  @@map("terminal_truck_appointments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Terminal truck window changes — the closed loop (2026-10-28)
//
// Operator rule this implements (validated in conversation by a terminal
// operator, not a customer endorsement):
//   "A window can be changed by the terminal operator, but hauliers must be
//    informed quickly during the transportation flow. Terminal operators are
//    the guide of the whole process."
//
// Before this, `reschedule` / `replan-day` overwrote windowStart/windowEnd in
// place and appended a text marker to `note`. The old window was gone: nothing
// could show a haulier what changed, nothing could be acknowledged, and no
// change→acknowledgement time could be measured. These tables make a window
// change a versioned EVENT with named recipients and observed delivery states.
//
// Honesty rules encoded in the shape:
//  - one ACTIVE change per appointment, enforced by a unique index on
//    `activeAppointmentId` (null once superseded, and Postgres does not collide
//    nulls) — so "never two active windows" is a database property, not a
//    convention a service has to remember;
//  - superseded rows keep the old window forever, never overwritten;
//  - deliveryState only ever holds a state we actually observed. SENT (we
//    dispatched) is not DELIVERED (the client confirmed receipt) is not
//    ACKNOWLEDGED (a human confirmed) — those are three different columns;
//  - a recipient with no channel gets UNAVAILABLE plus a reason
//    (DRIVER_NOT_ASSIGNED / NO_SHARE_TOKEN / PUSH_NOT_CONFIGURED). We never
//    invent a recipient to make the fan-out look complete.
// ─────────────────────────────────────────────────────────────────────────────

/// What the terminal operator did to the window.
enum TruckWindowChangeKind {
  /// Moved to a new window (single appointment).
  RESCHEDULED
  /// Moved by a day replan (every BOOKED window at a terminal on a day).
  REPLANNED
  /// The window was cancelled — there is no new window, and the recipient view
  /// must say so instead of showing a stale time.
  CANCELLED
}

/// A change is ACTIVE until a newer version supersedes it.
enum TruckWindowChangeStatus {
  ACTIVE
  SUPERSEDED
}

/// Who the change has to reach. Separate rows, separate acknowledgement states:
/// a dispatcher confirming is NOT the driver confirming.
enum TruckWindowRecipientType {
  HAULIER
  DRIVER
}

/// Transport actually used. Only recorded when we really dispatched on it.
enum TruckWindowChannel {
  /// socket.io company room (terminal/dispatcher sessions).
  REALTIME
  /// Web-push tickle to the driver's device. Payload-less by design: it wakes
  /// the PWA, which then reads the change. A tickle is a wake-up, not the
  /// message, so it can only ever justify SENT — never DELIVERED.
  PUSH
  /// The expiring/revocable counterparty share link (pull channel).
  SHARE_LINK
  /// The driver portal's own gate list (pull channel, polled + offline-cached).
  DRIVER_PORTAL
  /// Tenant notification bell.
  IN_APP
  /// Transactional outbox → tenant webhook.
  WEBHOOK
  /// No channel existed for this recipient.
  NONE
}

/// Delivery fidelity, highest observed wins. Never display a state we did not
/// observe: a socket.io emit with no client receipt is SENT, not DELIVERED.
enum TruckWindowDeliveryState {
  /// Recorded, dispatch not attempted yet.
  QUEUED
  /// Available on a pull channel the recipient controls (share link). We did
  /// not push anything, so claiming SENT would be a fabrication.
  PUBLISHED
  /// We dispatched on a push channel and the transport accepted it.
  SENT
  /// The client confirmed receipt (socket.io ack callback fired).
  DELIVERED
  /// Dispatch attempted and rejected/errored.
  FAILED
  /// No channel exists for this recipient. `deliveryReason` says which.
  UNAVAILABLE
}

/// Acknowledgement is a human act, tracked separately from delivery.
enum TruckWindowAckState {
  UNACKED
  ACKNOWLEDGED
}

/// Which credential produced the acknowledgement — an ack is only as trustworthy
/// as the identity behind it.
enum TruckWindowAckSource {
  /// Authenticated tenant user (dispatcher / terminal operator).
  TENANT_USER
  /// Authenticated driver-portal session (phone + PIN, single active session).
  DRIVER_PORTAL
  /// Holder of a valid, unexpired share token.
  SHARE_TOKEN
}

/// Escalation ladder for an unacknowledged change. Recomputed from the clock on
/// read (the rail-handshake pattern), so it is never stale and needs no cron.
enum TruckWindowEscalation {
  NONE
  REMINDER
  ESCALATED
}

/// One published window change = one version. The appointment's
/// windowStart/windowEnd always hold the ACTIVE version's window; every prior
/// version stays here, visibly SUPERSEDED.
model TerminalTruckWindowChange {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   TerminalTruckAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// Per-appointment version number, 1-based and monotonic.
  version       Int

  changeKind    TruckWindowChangeKind
  status        TruckWindowChangeStatus @default(ACTIVE)

  /// Set to `appointmentId` while ACTIVE, nulled on supersede. The unique index
  /// on it is what makes "never two active windows" a database guarantee.
  activeAppointmentId String? @unique

  /// The window as it was BEFORE this change. Never rewritten.
  previousWindowStart DateTime
  previousWindowEnd   DateTime
  /// The window this change published. Null for CANCELLED — there is no new
  /// window, and the UI must not render one.
  newWindowStart DateTime?
  newWindowEnd   DateTime?

  /// Required by the existing cut-off rule when the change lands inside the
  /// per-company gate cut-off; optional (but always recorded) otherwise.
  reason        String?  @db.Text
  forced        Boolean  @default(false)
  insideCutoff  Boolean  @default(false)
  cutoffHours   Int

  /// The appointment's status when the change was made — the context that
  /// decides whether "the truck already knew" is even a meaningful question.
  truckStatusAtChange TruckAppointmentStatus
  /// True when the window had already closed at change time. Recorded, never
  /// hidden: a change made after the fact is a fact.
  windowAlreadyClosed Boolean @default(false)

  changedById    String?
  changedByEmail String?
  changedByRole  String?
  changedAt      DateTime @default(now())

  supersededAt DateTime?
  supersededById String?

  /// Client-supplied duplicate-submit guard. Unique per tenant; a replayed
  /// submit returns the ORIGINAL change instead of publishing a new version.
  idempotencyKey String?

  recipients TerminalTruckWindowRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, idempotencyKey])
  // PostgreSQL truncates the original migration's 65-byte index name to 63
  // bytes. Map it explicitly so Prisma preserves the already-deployed name.
  @@index([companyId, appointmentId, version], map: "terminal_truck_window_changes_companyId_appointmentId_version_i")
  @@index([companyId, status])
  @@index([companyId, changedAt])
  @@map("terminal_truck_window_changes")
}

/// One change, one recipient, one acknowledgement state. The terminal's
/// "does that truck know?" board reads this table.
model TerminalTruckWindowRecipient {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  changeId      String
  change        TerminalTruckWindowChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   TerminalTruckAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  recipientType TruckWindowRecipientType
  /// Stable non-null identity for the unique index: `HAULIER` or `DRIVER:<id>`.
  /// (A plain unique on a nullable driverId would let Postgres accept any number
  /// of null-keyed rows, which is how duplicate acknowledgements sneak in.)
  recipientKey  String
  /// Human label shown on the board — the haulier name, or the driver's name.
  recipientLabel String

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  /// Channels actually attempted, in order.
  deliveryChannels TruckWindowChannel[] @default([])
  /// Highest-fidelity state OBSERVED across those channels.
  deliveryState    TruckWindowDeliveryState @default(QUEUED)
  /// Why there is no delivery, when there is none. Machine-readable so the UI
  /// can render DRIVER NOT ASSIGNED rather than a blank cell.
  deliveryReason   String?
  /// Per-channel breakdown: [{ channel, state, at, reason }]. The headline state
  /// is a summary; this is the evidence behind it.
  deliveryDetail   Json?
  dispatchedAt     DateTime?
  /// Set ONLY when a client confirmed receipt. Never inferred from a dispatch.
  deliveredAt      DateTime?

  ackState     TruckWindowAckState @default(UNACKED)
  /// Server-observed acknowledgement time — the one the KPIs use.
  ackedAt      DateTime?
  /// Client-reported time for an ack queued offline (PENDING SYNC on the device)
  /// and flushed later. Labelled as device-reported wherever it is shown, and
  /// never used in place of `ackedAt` for measurement.
  ackDeviceAt  DateTime?
  ackSource    TruckWindowAckSource?
  ackedByLabel String?
  /// Duplicate-ack guard for a replayed offline flush.
  ackIdempotencyKey String?

  escalation      TruckWindowEscalation @default(NONE)
  reminderSentAt  DateTime?
  escalatedAt     DateTime?
  /// Minutes after the change at which this recipient's ack became overdue,
  /// frozen from the terminal policy at change time so a later policy edit does
  /// not retroactively move the goalposts.
  ackDueMinutes   Int
  /// When this recipient's acknowledgement clock starts.
  ///
  /// NULL means "the moment the change was published", which is true of every
  /// recipient created with the change — so this column changes nothing about
  /// the rows that already exist. It is set only for a recipient attached
  /// LATER: the driver assigned after the window had already moved, who could
  /// not have been told before they were assigned. The deadline, the escalation
  /// ladder and the stale-unacked count all run from here, so a late assignment
  /// never reads as a driver ignoring a change nobody had told them about.
  ///
  /// An explicit column rather than an inference from `createdAt`: inferring it
  /// would make every escalation depend on two clocks agreeing, and a wrong
  /// `createdAt` would silently stop a ladder from ever climbing.
  toldAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([changeId, recipientKey])
  @@index([companyId, ackState])
  @@index([companyId, appointmentId])
  @@index([driverId, ackState])
  @@map("terminal_truck_window_recipients")
}

/// Per-terminal acknowledgement thresholds. Falls back to documented defaults
/// when a terminal has no row, so a new terminal is never unconfigurable — but
/// the defaults are constants in code, not measurements.
model TerminalGatePolicy {
  id           String  @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  terminalName String

  /// Minutes after a change before an unacknowledged recipient counts as stale.
  ackDueMinutes Int @default(30)
  /// Minutes after a change before a reminder is due.
  reminderAfterMinutes Int @default(15)
  /// Minutes after a change before the terminal + dispatcher see an escalation.
  escalateAfterMinutes Int @default(45)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, terminalName])
  @@index([companyId])
  @@map("terminal_gate_policies")
}

/// ── WP3: Cross-border dwell measurement ───────────────────────────────────────
/// Border post reference data — official crossing identity, hand-compiled reference.
/// These are the named crossing points where dwell can be measured.
/// Provenance: every figure is STATIC_REFERENCE until measured by FlowOps.
model BorderPost {
  id                 String   @id @default(cuid())
  companyId          String
  code               String   // "BEIT_BRIDGE", "CHIRUNDU", "LEBOMBO"
  name               String   // "Beitbridge Border Post"
  countries          String   // "ZA,ZW" — comma-separated ISO codes for both sides
  lat                Float
  lng                Float
  is24Hour           Boolean  @default(false)
  referenceAvgWaitHours Float?   // reference only, not measured by FlowOps
  referenceCongestion   String?    // reference only
  referenceCompiledAsOf  DateTime?  // null = not recorded

  geofences     BorderGeofence[]
  dwellSessions BorderDwellSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("border_posts")
}

/// Border geofence — measurement boundary at a border post.
/// Separate from SafetyZone: a measurement boundary is not a danger zone,
/// and driver-reported safety zones must never enter dwell statistics.
model BorderGeofence {
  id          String   @id @default(cuid())
  companyId   String
  postId      String
  post        BorderPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  code        String   // "BEIT_BRIDGE_ZA", "BEIT_BRIDGE_ZW", "CHIRUNDU"
  name        String   // "Beitbridge Border (SA side)"
  lat         Float
  lng         Float
  radiusM     Int      @default(1000) // radius in metres
  side        String   // "EXPORT" | "IMPORT" | "TRANSIT" | "BOTH"
  isActive    Boolean  @default(true)
  provenance  String   // "SEED" | "OPERATOR_REVIEW" | "SURVEYED"

  dwellSessions BorderDwellSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive])
  @@index([postId])
  @@map("border_geofences")
}

/// Border dwell session — one visit to a border geofence.
/// Entry and exit derived from GPS fixes, not a track.
/// Two timestamps per crossing, tied to driver/vehicle/post — not a breadcrumb store.
model BorderDwellSession {
  id                String   @id @default(cuid())
  companyId         String
  postId            String
  post              BorderPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  geofenceId        String
  geofence          BorderGeofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  driverId          String?    // nullable: dwell survives a driver change mid-trip
  vehicleReg        String?
  enteredAt         DateTime?    // first observed inside fix (entry bounded, not exact)
  enteredFromFixAt  DateTime?    // actual fix timestamp that first placed driver inside
  exitedAt          DateTime?    // last observed outside fix bounds exit
  exitedFromFixAt   DateTime?    // actual fix timestamp that first placed driver outside
  state             String   // "CLOSED" | "OPEN" | "GAPPED"
  sampleCount       Int      @default(0)
  precisionSeconds  Int?     // observed entry/exit uncertainty bound in seconds
  gapLargestSeconds Int?     // largest gap between consecutive samples inside session
  direction         String?  // "INBOUND" | "OUTBOUND" | "TRANSIT"
  source            String   // "GPS_PORTAL"

  // Back-relation: trip legs derived from this dwell session
  tripLegs          TripLeg[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, state])
  @@index([postId, state])
  @@index([driverId])
  @@map("border_dwell_sessions")
}

/// ── WP3 Stage 4: Trip corridor split with provenance labels ───────────────────
/// A Trip is a cross-border movement (terminal → rail operator → haulier →
/// forwarder) split into legs. Each leg carries a provenance label so a trip
/// total is MEASURED only when every leg is MEASURED — REFERENCE legs are
/// planning-only and never summed into a measured total.
model Trip {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference   String   // customer-facing trip reference (e.g. T-2026-0001)
  driverId    String?
  driver      Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleReg  String?
  origin      String?
  destination String?
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  status      TripStatus @default(PLANNED)

  legs        TripLeg[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([driverId, createdAt])
  @@index([companyId, createdAt])
  @@map("trips")
}

/// One leg of a trip with an explicit provenance label.
/// BORDER legs are MEASURED from a CLOSED dwell session, DECLARED when a
/// dispatcher keys in a duration, or absent for GAPPED/OPEN sessions (which
/// produce a MEASURED leg with durationMinutes = null + confidenceNote).
/// REFERENCE legs come from the static corridor table — planning only.
model TripLeg {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  kind           TripLegKind // LINEHAUL | BORDER | CLEARING | BOND | EMPTY_RETURN
  postId         String?    // border post for BORDER legs
  post           BorderPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  dwellSessionId String?    // source dwelling session for MEASURED BORDER legs
  dwellSession   BorderDwellSession? @relation(fields: [dwellSessionId], references: [id], onDelete: SetNull)
  startedAt      DateTime?
  endedAt        DateTime?
  durationMinutes Int?      // derived from startedAt/endedAt, or null when unknown
  provenance     TripLegProvenance @default(REFERENCE) // MEASURED | DECLARED | REFERENCE
  source         String?    // crossing-session id | actor | reference-table code
  confidenceNote String?    // e.g. "GAPPED session — dwell at post unknown"
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, kind])
  @@index([companyId, kind])
  @@index([postId])
  @@map("trip_legs")
}

enum TripStatus {
  PLANNED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum TripLegKind {
  LINEHAUL
  BORDER
  CLEARING
  BOND
  EMPTY_RETURN
}

enum TripLegProvenance {
  MEASURED   // derived from observed dwell session
  DECLARED   // keyed in by a dispatcher/operator
  REFERENCE  // from static corridor table — planning only, never summed
}

/// ── WP3 Stage 3: Cross-border document pack + expiry alerts ─────────────────
/// Per-trip document pack. Each document is captured by a dispatcher or the
/// driver in the portal, with the actor recorded. The pack records what the
/// operator holds — it does not file anything with any authority.
/// Statuses: HELD (in hand), MISSING (not yet obtained), EXPIRED (past expiry),
/// NOT_APPLICABLE (not required for this corridor/country).
model TripDocumentPack {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  documentType String  // e.g. "Carnet de Passage", "TIR Carnet", "COMESA Certificate of Origin"
  status      DocumentPackStatus @default(HELD)
  issuedAt    DateTime?
  expiresAt   DateTime?
  capturedBy  String?   // userId of dispatcher/driver who captured it
  evidenceRef String?   // reference to uploaded evidence (waybill scan, photo, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([tripId])
  @@index([companyId, status])
  @@index([expiresAt])
  @@map("trip_document_pack")
}

enum DocumentPackStatus {
  HELD            // document is in hand
  MISSING         // not yet obtained
  EXPIRED         // past expiry date
  NOT_APPLICABLE  // not required for this corridor/country
}

/// Per-company expiry alert thresholds (days before expiry).
/// Defaults: 30 / 14 / 3 days. Configurable downwards only per company.
model DocumentExpiryThreshold {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType   String?  // null = applies to all document types
  thresholdDays  Int      @default(30) // days before expiry to alert
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, documentType])
  @@index([companyId, isActive])
  @@map("document_expiry_thresholds")
}
