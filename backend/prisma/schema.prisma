generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  COMPANY_ADMIN
  MANAGER
  DISPATCH
  WAREHOUSE
  AGENT
  USER
  DRIVER
  VIEWER
}

enum WaybillStatus {
  PENDING
  COLLECTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
}

enum CollectionStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COLLECTED
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum DriverStatus {
  AVAILABLE
  ON_ROUTE
  OFFLINE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum DigestFrequency {
  INSTANT
  DAILY
  WEEKLY
}

// ─── Platform Owner (super-admin, separate from tenant users) ─────────────

model OwnerUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens OwnerRefreshToken[]

  @@map("owner_users")
}

model OwnerRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  ownerId   String
  owner     OwnerUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@map("owner_refresh_tokens")
}

// ─── Tenant Company ────────────────────────────────────────────────────────

model Company {
  id          String  @id @default(cuid())
  name        String
  tradingName String?
  email       String? @unique
  phone       String?
  address     String?
  city        String?
  country     String  @default("ZA")
  vatNumber   String?

  // WhatsApp — tenant's own mobile number used for click-to-chat (wa.me) links.
  // No Business API token needed; agents send from this number via WhatsApp Web/app.
  whatsappNumber String?

  // Branding
  logoUrl            String?
  brandName          String?
  primaryColor       String?
  secondaryColor     String?
  invoiceHeaderColor String?

  // Customer-facing booking portal
  portalBrandName    String?
  portalSubdomain    String? @unique
  portalPrimaryColor String?
  portalLogoUrl      String?

  // SLA thresholds (minutes)
  slaWarningMinutes  Int @default(30)
  slaBreachMinutes   Int @default(60)
  slaEscalateMinutes Int @default(120)

  // Billing plan
  plan          String   @default("starter")
  trialStartedAt DateTime @default(now())
  trialEndsAt   DateTime?
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  waybills           Waybill[]
  waybillInboxItems  WaybillInboxItem[]
  collections        Collection[]
  shipments          Shipment[]
  drivers            Driver[]
  driverChatMessages DriverChatMessage[] @relation("CompanyDriverChats")
  branches           Branch[]
  manifests          Manifest[]
  invoices           Invoice[]
  invoiceDrafts      InvoiceDraft[]
  rateCards          RateCard[]
  quotes             Quote[]
  notifications      Notification[]
  whatsappThreads    WhatsAppThread[]
  payments           Payment[]
  leads              Lead[]
  bookingPortalLinks BookingPortalLink[]
  aiEvents           AiEvent[]
  emailHubItems      EmailHubItem[]
  workflows          Workflow[]
  approvalRequest    ApprovalRequest?
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  codTransactions    CodTransaction[]
  clients            Client[]
  returns            Return[]
  creditNotes        CreditNote[]
  debitNotes         DebitNote[]
  salespeople        Salesperson[]
  commissions        Commission[]

  @@map("companies")
}

// ─── Users ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  name         String
  phone        String?
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true)

  // Per-user nav/feature permission overrides (key -> boolean). When set,
  // these take precedence over the role defaults for sidebar + route access.
  permissions  Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Email verification
  emailVerified     Boolean   @default(false)
  verifyToken       String?
  verifyTokenExpiry DateTime?

  // Password reset
  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens          RefreshToken[]
  notificationPreference NotificationPreference?
  assignedCollections    Collection[]            @relation("AssignedAgent")
  assignedShipments      Shipment[]
  // Optional link to a Driver record so DRIVER-role users see only their own jobs
  linkedDriver           Driver?

  @@unique([email, companyId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─── Public API & Webhooks (tenant integrations: Shopify, etc.) ───────────

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  // Only the SHA-256 hash is stored; the plaintext key is shown once at creation.
  keyHash    String    @unique
  prefix     String // first chars, for display ("fok_live_ab12…")
  lastUsedAt DateTime?
  revokedAt  DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("api_keys")
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  secret    String // used to HMAC-sign deliveries so receivers can verify
  events    String[] // e.g. ["waybill.status_changed", "waybill.delivered"]
  active    Boolean  @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model ApprovalRequest {
  id       String         @id @default(cuid())
  status   ApprovalStatus @default(PENDING)
  fullName String
  email    String
  phone    String
  company  String
  notes    String?

  // Linked once approved
  companyId     String?  @unique
  tenantCompany Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("approval_requests")
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Master channel toggles
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)
  pushEnabled  Boolean @default(true)

  // Per-category × channel
  operationsEmail Boolean @default(true)
  operationsSms   Boolean @default(false)
  operationsPush  Boolean @default(true)
  billingEmail    Boolean @default(true)
  billingPush     Boolean @default(false)
  securityEmail   Boolean @default(true)
  securityPush    Boolean @default(true)
  systemEmail     Boolean @default(false)
  systemPush      Boolean @default(false)

  // Digest
  digestFrequency DigestFrequency @default(INSTANT)

  // Quiet hours
  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String  @default("22:00")
  quietHoursEnd     String  @default("07:00")
  timezone          String  @default("Africa/Johannesburg")

  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// ─── Drivers ──────────────────────────────────────────────────────────────

model Driver {
  id          String       @id @default(cuid())
  name        String
  phone       String
  email       String?
  vehicleType String       @default("motorbike")
  vehicleReg  String?
  status      DriverStatus @default(OFFLINE)
  isActive    Boolean      @default(true)

  // ── Customer delivery rating ──────────────────────────────────────────
  customerRating      Int?
  customerRatingNote  String?
  ratingToken         String?   @unique
  ratingRequestedAt   DateTime?

  // Last known GPS position
  lastLat  Float?
  lastLng  Float?
  lastSeen DateTime?

  // Driver portal auth (phone + hashed 4-digit PIN)
  driverPin String?

  // Optional link to a User account — enables role-scoped job delivery
  userId    String? @unique
  user      User?   @relation(fields: [userId], references: [id])

  // Fleet / vehicle maintenance
  currentKm       Int?       // current odometer reading
  nextServiceKm   Int?       // odometer reading at which next service is due
  nextServiceDate DateTime?  // calendar-based service due date
  vehicleNotes    String?    // free-form notes (tyre condition, defects etc.)

  chatMessages    DriverChatMessage[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections Collection[]
  shipments   Shipment[]
  manifests   Manifest[]
  wallet      DriverWallet?
  services    VehicleService[]
  returns     Return[]

  @@map("drivers")
}

// ─── Branches ─────────────────────────────────────────────────────────────

model Branch {
  id      String  @id @default(cuid())
  name    String
  address String?
  city    String?
  lat     Float?
  lng     Float?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivers   Driver[]
  manifests Manifest[]
  waybills  Waybill[]  @relation("OriginBranch")

  @@map("branches")
}

// ─── Waybills ─────────────────────────────────────────────────────────────

model Waybill {
  id             String        @id @default(cuid())
  trackingNumber String
  status         WaybillStatus @default(PENDING)

  // Parties
  senderName       String
  senderPhone      String
  senderAddress    String
  recipientName    String
  recipientPhone   String
  recipientAddress String
  recipientEmail   String?

  // Geocoded coordinates (populated by the geocoding pipeline) — power routing,
  // the live map, ETA, and the public tracking page.
  senderLat    Float?
  senderLng    Float?
  recipientLat Float?
  recipientLng Float?

  // Parcel
  weight      Float?
  dimensions  String?
  description String?
  totalAmount Float?
  codAmount   Float?
  codCollected    Boolean   @default(false)   // driver has physically collected the cash
  codCollectedAt  DateTime?

  // Customer delivery rating (requested via /waybills/:id/rate-request after delivery)
  customerRating      Int?
  customerRatingNote  String?
  ratingToken         String?   @unique
  ratingRequestedAt   DateTime?

  // Risk assessment
  riskLevel RiskLevel @default(LOW)
  riskScore Float?
  riskNotes String?

  // Proof of delivery
  podSignatureUrl String?
  podImageUrl     String?
  podRecipient    String?
  podDeliveredAt  DateTime?

  // Uploaded scan file (Cloudflare R2 key)
  fileUrl String?
  fileKey String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  originBranchId String?
  originBranch   Branch? @relation("OriginBranch", fields: [originBranchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments        Shipment[]
  manifestWaybills ManifestWaybill[]
  invoiceItems     InvoiceItem[]
  inboxItem        WaybillInboxItem?
  codTransactions  CodTransaction[]
  returns          Return[]

  @@unique([trackingNumber, companyId])
  @@map("waybills")
}

model WaybillInboxItem {
  id     String @id @default(cuid())
  // PENDING | EXTRACTING | READY | COMMITTED | FAILED
  status String @default("PENDING")

  fileUrl  String?
  fileKey  String?
  mimeType String?

  // AI-extracted fields + confidence scores
  extractedData Json?
  aiConfidence  Float?
  aiError       String?

  waybillId String?  @unique
  waybill   Waybill? @relation(fields: [waybillId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waybill_inbox_items")
}

// ─── Collections ──────────────────────────────────────────────────────────

model Collection {
  id     String           @id @default(cuid())
  status CollectionStatus @default(PENDING)

  clientName    String
  clientPhone   String
  clientEmail   String?
  pickupAddress String
  notes         String?

  // Geocoded pickup coordinates (populated by the geocoding pipeline).
  pickupLat Float?
  pickupLng Float?

  scheduledAt DateTime?
  pickedUpAt  DateTime?

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  agentId String?
  agent   User?   @relation("AssignedAgent", fields: [agentId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collections")
}

// ─── Shipments ────────────────────────────────────────────────────────────

model Shipment {
  id     String         @id @default(cuid())
  status ShipmentStatus @default(PENDING)

  waybillId String
  waybill   Waybill @relation(fields: [waybillId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  currentLat Float?
  currentLng Float?

  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipments")
}

// ─── Manifests ────────────────────────────────────────────────────────────

model Manifest {
  id   String @id @default(cuid())
  code String

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  dispatched   Boolean   @default(false)
  dispatchedAt DateTime?
  pdfKey       String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waybills ManifestWaybill[]

  @@map("manifests")
}

model ManifestWaybill {
  manifestId String
  manifest   Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  waybillId String
  waybill   Waybill  @relation(fields: [waybillId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@id([manifestId, waybillId])
  @@map("manifest_waybills")
}

// ─── Invoices ─────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)

  clientName  String
  clientEmail String?

  subtotal Float @default(0)
  tax      Float @default(0)
  total    Float @default(0)

  dueDate DateTime?
  paidAt  DateTime?
  sentAt  DateTime?

  notes String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  commissions Commission[]

  @@unique([invoiceNumber, companyId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  waybillId String?
  waybill   Waybill? @relation(fields: [waybillId], references: [id])

  @@map("invoice_items")
}

model InvoiceDraft {
  id    String  @id @default(cuid())
  title String?

  // Flexible JSON for AI-assisted drafting
  draftData  Json?
  aiAnalysis Json?

  finalized   Boolean   @default(false)
  finalizedAt DateTime?
  invoiceId   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_drafts")
}

// ─── Rate Cards & Quotes ──────────────────────────────────────────────────

model RateCard {
  id         String  @id @default(cuid())
  name       String
  fromZone   String?
  toZone     String?
  minWeight  Float?
  maxWeight  Float?
  basePrice  Float
  pricePerKg Float   @default(0)
  isActive   Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rate_cards")
}

model Quote {
  id          String  @id @default(cuid())
  fromAddress String
  toAddress   String
  clientName  String?   // optional — who the quote is for
  weight      Float
  price       Float
  breakdown   Json?
  accepted    Boolean   @default(false)
  expiresAt   DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("quotes")
}

// ─── Notifications ────────────────────────────────────────────────────────

model Notification {
  id    String  @id @default(cuid())
  title String
  body  String
  type  String  @default("info")
  read  Boolean @default(false)
  readAt DateTime?
  link  String?

  // null = broadcast to whole company
  userId String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// ─── WhatsApp ─────────────────────────────────────────────────────────────

model WhatsAppThread {
  id            String    @id @default(cuid())
  phone         String
  name          String?
  lastMessage   String?
  lastMessageAt DateTime?
  unreadCount   Int       @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages WhatsAppMessage[]

  @@unique([phone, companyId])
  @@map("whatsapp_threads")
}

model WhatsAppMessage {
  id        String           @id @default(cuid())
  content   String
  direction MessageDirection

  // Meta WABA tracking
  wabaMessageId String?
  // sent | delivered | read | failed
  status        String  @default("sent")

  mediaUrl  String?
  mediaType String?

  threadId String
  thread   WhatsAppThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  sentAt DateTime @default(now())

  @@map("whatsapp_messages")
}

// ─── Payments (Paystack) ──────────────────────────────────────────────────

model Payment {
  id        String        @id @default(cuid())
  reference String        @unique
  status    PaymentStatus @default(PENDING)
  amount    Float
  currency  String        @default("ZAR")
  description String?

  paystackReference String?
  paystackChannel   String?

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  customerEmail String?
  customerName  String?

  paidAt DateTime?

  // Full webhook payload kept for audit trail
  webhookPayload Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

// ─── Booking Portal ───────────────────────────────────────────────────────

model BookingPortalLink {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  label     String?
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  requests BookingRequest[]

  @@map("booking_portal_links")
}

model BookingRequest {
  id     String @id @default(cuid())
  status String @default("pending")

  senderName       String
  senderPhone      String
  senderAddress    String
  recipientName    String
  recipientPhone   String
  recipientAddress String
  notes            String?

  linkId String
  link   BookingPortalLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("booking_requests")
}

// ─── AI & Email Hub ───────────────────────────────────────────────────────

model AiEvent {
  id       String @id @default(cuid())
  type     String
  title    String
  body     String
  severity String @default("info")

  resolved   Boolean   @default(false)
  dismissed  Boolean   @default(false)
  resolvedAt DateTime?

  sourceType String?
  sourceId   String?
  metadata   Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("ai_events")
}

model EmailHubItem {
  id       String  @id @default(cuid())
  subject  String
  from     String
  to       String
  body     String? @db.Text
  read     Boolean @default(false)
  resolved Boolean @default(false)
  category String?

  // ── Triage / classification (matches frontend contract) ──
  type      String @default("GENERAL") // COLLECTION_REQUEST|POD|QUOTE|FEEDBACK|NOTIFICATION|AI_MONITOR|GENERAL
  status    String @default("NEW") // NEW|TRIAGED|IN_PROGRESS|WAITING|RESOLVED|ARCHIVED
  priority  String @default("MEDIUM") // LOW|MEDIUM|HIGH|CRITICAL
  direction String @default("INBOUND") // INBOUND|OUTBOUND

  senderName     String?
  senderEmail    String?
  recipientEmail String?

  waybillNumber String?
  podNumber     String?

  // ── AI monitoring ──
  aiSummary         String? @db.Text
  aiConfidence      Float?
  aiCategory        String?
  aiSuggestedAction String?
  opsNote           String? @db.Text

  isRead         Boolean  @default(false)
  needsOpsAction Boolean  @default(false)
  receivedAt     DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  attachments EmailAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("email_hub_items")
}

model EmailAttachment {
  id             String       @id @default(cuid())
  emailHubItemId String
  emailHubItem   EmailHubItem @relation(fields: [emailHubItemId], references: [id], onDelete: Cascade)

  filename String
  mimeType String?
  size     Int     @default(0)
  fileKey  String? // object key in Cloudflare R2
  fileUrl  String? // resolved (signed/public) URL

  // ── AI threat scan ──
  scanStatus   String    @default("PENDING") // PENDING|CLEAN|THREAT|SKIPPED|ERROR
  threatLevel  String    @default("NONE") // NONE|LOW|MEDIUM|HIGH|CRITICAL
  threatReason String?
  scanEngine   String? // heuristic | clamav | virustotal
  scannedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([emailHubItemId])
  @@map("email_attachments")
}

// ─── Leads ────────────────────────────────────────────────────────────────

model Lead {
  id    String  @id @default(cuid())
  email String
  notes String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("leads")
}

// ─── Workflows ────────────────────────────────────────────────────────────

model Workflow {
  id       String  @id @default(cuid())
  name     String
  script   String  @db.Text
  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  databases WorkflowDatabase[]

  @@map("workflows")
}

model WorkflowDatabase {
  id         String   @id @default(cuid())
  name       String
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  columns    Json
  rows       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workflow_databases")
}



// ── Platform audit trail ───────────────────────────────────────────────────
// Immutable record of privileged owner/platform actions: tenant approve/reject/
// suspend, plan changes, and "view-as-tenant" impersonation. Surfaced in the
// owner console for compliance + accountability.
model AuditLog {
  id         String   @id @default(cuid())
  actorType  String   @default("owner") // owner | tenant | system
  actorId    String?
  actorEmail String?
  action     String // e.g. tenant.approve, tenant.suspend, tenant.plan_change, tenant.impersonate
  targetType String? // company | user | request
  targetId   String?
  targetName String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@map("audit_logs")
}



// ── MRR history (true revenue movement) ────────────────────────────────────
// A daily point-in-time snapshot of platform MRR plus a per-tenant price map,
// so the owner console can compute real MRR movement (new / expansion /
// contraction / churn) by diffing consecutive snapshots — instead of the
// window approximation used before.
model MrrSnapshot {
  id            String   @id @default(cuid())
  date          DateTime @unique // midnight of the snapshot day
  mrr           Float
  activeTenants Int
  payingTenants Int
  perTenant     Json // { [companyId]: monthlyPrice }
  createdAt     DateTime @default(now())

  @@index([date])
  @@map("mrr_snapshots")
}



// ── Platform alerts (owner alerting engine) ────────────────────────────────
// Generated by the alerting cron when churn, SLA-exception spikes, or payment
// failures are detected. `dedupeKey` makes generation idempotent so the owner
// is notified once per condition rather than on every cron tick.
model PlatformAlert {
  id         String    @id @default(cuid())
  type       String // churn | sla_spike | payment_failure
  severity   String    @default("warning") // info | warning | critical
  title      String
  message    String
  tenantId   String?
  tenantName String?
  metadata   Json?
  dedupeKey  String    @unique
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolved])
  @@index([createdAt])
  @@map("platform_alerts")
}


// ─── COD Reconciliation ────────────────────────────────────────────────────

model DriverWallet {
  id             String    @id @default(cuid())
  driverId       String    @unique
  balance        Float     @default(0)
  totalCollected Float     @default(0)
  totalSettled   Float     @default(0)
  lastSettledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver       Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  transactions CodTransaction[]

  @@map("driver_wallets")
}

model CodTransaction {
  id        String             @id @default(cuid())
  walletId  String
  waybillId String?
  companyId String
  type      CodTransactionType
  amount    Float
  balance   Float              // running balance after this entry
  note      String?

  createdAt DateTime @default(now())

  wallet  DriverWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  waybill Waybill?    @relation(fields: [waybillId], references: [id])
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("cod_transactions")
}

enum CodTransactionType {
  COLLECTION   // driver collected cash from a recipient
  SETTLEMENT   // driver remitted cash to the company
  ADJUSTMENT   // manual balance correction
}

// ─── Webhook Delivery Log ──────────────────────────────────────────────────

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  event          String
  payload        String                // JSON-serialised event body
  status         WebhookDeliveryStatus @default(PENDING)
  responseStatus Int?
  responseBody   String?
  attempts       Int                   @default(0)
  nextRetryAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
  EXHAUSTED
}


// ─── Vehicle / Fleet Maintenance ──────────────────────────────────────────

model VehicleService {
  id          String   @id @default(cuid())
  driverId    String
  serviceType String   // e.g. "Oil Change", "Tyre Rotation", "Annual Service"
  notes       String?
  kmAtService Int?
  cost        Float?
  servicedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, servicedAt])
  @@map("vehicle_services")
}


// ─── Client Directory ─────────────────────────────────────────────────────
// Proper client records with billing types — separate from the waybill-derived
// read-only directory. COD, prepaid, and contract clients each have different
// defaults (COD amount policy, credit limit, or contract terms).

enum ClientBillingType {
  COD        // Cash on delivery — driver collects per waybill
  PREPAID    // Client pays before dispatch
  CONTRACT   // Monthly invoiced account with credit terms
  CASH       // Walk-in / once-off cash payer
}

model Client {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Identity
  name          String
  tradingName   String?
  phone         String?
  email         String?
  address       String?

  // Billing
  billingType   ClientBillingType @default(COD)
  creditLimit   Float?            // for CONTRACT clients
  paymentTerms  Int?              // days — e.g. 30 for net-30
  vatNumber     String?
  accountCode   String?

  // Contract
  contractStart DateTime?
  contractEnd   DateTime?
  notes         String?

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, billingType])
  @@index([companyId, name])
  @@map("clients")
}


// ── Driver ↔ Dispatch real-time chat ─────────────────────────────────────────

model DriverChatMessage {
  id             String    @id @default(cuid())
  driverId       String
  driver         Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company   @relation("CompanyDriverChats", fields: [companyId], references: [id], onDelete: Cascade)
  /// 'driver' | 'dispatch'
  senderType     String
  message        String
  attachmentUrl  String?
  attachmentType String?   // 'image' | 'document'
  readAt         DateTime? // null = unread
  createdAt      DateTime  @default(now())

  @@index([driverId, createdAt])
  @@index([companyId, createdAt])
  @@map("driver_chat_messages")
}


// ─── Returns Management ────────────────────────────────────────────────────
// Full RMA lifecycle: a customer/agent logs a return against an original
// waybill (or ad-hoc), it gets triaged + approved, a driver collects it, it's
// received and inspected at the warehouse, then resolved (refund / replace /
// restock / dispose). Mirrors the courier-industry returns workflow that
// incumbents like Parcel Perfect ship, with COD-aware refunds + restocking.

enum ReturnStatus {
  REQUESTED   // logged, awaiting triage/approval
  APPROVED    // approved for collection
  REJECTED    // return refused
  SCHEDULED   // collection booked / driver assigned
  IN_TRANSIT  // being returned to the warehouse
  RECEIVED    // physically back at the warehouse
  INSPECTING  // QA inspection in progress
  COMPLETED   // resolved (refund/replace/restock/dispose done)
  CANCELLED   // withdrawn by customer/agent
}

enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  MISSING_PARTS
  NO_LONGER_NEEDED
  FAILED_DELIVERY
  LATE_DELIVERY
  OTHER
}

enum ReturnResolution {
  PENDING
  REFUND
  REPLACEMENT
  REPAIR
  STORE_CREDIT
  RESTOCK
  DISPOSE
}

enum ReturnCondition {
  RESELLABLE
  MINOR_DAMAGE
  DAMAGED
  UNUSABLE
}

model Return {
  id        String @id @default(cuid())
  rmaNumber String // human-friendly return reference (e.g. RMA-2406-0007)

  // Link back to the original outbound waybill (optional — supports ad-hoc returns).
  // trackingNumber is denormalised so search/history survives if the waybill is gone.
  waybillId      String?
  waybill        Waybill? @relation(fields: [waybillId], references: [id])
  trackingNumber String?

  // Who is returning
  customerName  String
  customerPhone String?
  customerEmail String?
  pickupAddress String?
  pickupLat     Float?
  pickupLng     Float?

  reason     ReturnReason     @default(OTHER)
  reasonNote String?
  status     ReturnStatus     @default(REQUESTED)
  resolution ReturnResolution @default(PENDING)

  // Financials (COD-aware: a returned COD parcel may owe the customer a refund)
  refundAmount Float?
  restockFee   Float?
  currency     String @default("ZAR")

  // Logistics — reuse the existing driver fleet for collection
  assignedDriverId String?
  assignedDriver   Driver?   @relation(fields: [assignedDriverId], references: [id])
  scheduledAt      DateTime?
  collectedAt      DateTime?
  receivedAt       DateTime?

  // Inspection / QA
  inspectionNotes String?
  condition       ReturnCondition?
  restocked       Boolean          @default(false)

  // Audit trail
  approvedById String?
  approvedAt   DateTime?
  resolvedAt   DateTime?

  items ReturnItem[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rmaNumber, companyId])
  @@index([companyId])
  @@index([status])
  @@index([waybillId])
  @@map("returns")
}

model ReturnItem {
  id          String  @id @default(cuid())
  returnId    String
  return      Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  description String
  sku         String?
  quantity    Int     @default(1)
  unitValue   Float?
  condition   ReturnCondition?
  restocked   Boolean @default(false)

  @@index([returnId])
  @@map("return_items")
}


// ─── Accounting: Credit / Debit Notes, Statements, Sales Commission ─────────
// Adjustment documents and salesperson commission tracking that close the
// accounting-depth gap vs incumbents (credit/debit notes, age analysis,
// statements, Pastel/CSV export, sales commission).

enum CreditNoteStatus {
  DRAFT    // being prepared
  ISSUED   // finalised + numbered, owed back to the client
  APPLIED  // offset against an invoice / fully consumed
  VOID     // cancelled
}

enum DebitNoteStatus {
  DRAFT
  ISSUED
  SETTLED
  VOID
}

enum CommissionStatus {
  PENDING   // calculated, awaiting approval
  APPROVED  // approved for payout
  PAID      // paid out to the salesperson
  VOID
}

model CreditNote {
  id         String           @id @default(cuid())
  number     String           // CN-YYYY-#### per company
  status     CreditNoteStatus @default(DRAFT)

  clientName  String
  clientEmail String?

  // Optional link to the invoice this credit adjusts
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  reason   String?
  subtotal Float  @default(0)
  tax      Float  @default(0)
  total    Float  @default(0)
  // How much of `total` has been applied/offset so far
  appliedAmount Float @default(0)

  issuedAt  DateTime?
  appliedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items CreditNoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([number, companyId])
  @@index([companyId, status])
  @@index([companyId, clientName])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  description  String
  quantity     Int        @default(1)
  unitPrice    Float
  total        Float
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@map("credit_note_items")
}

model DebitNote {
  id         String          @id @default(cuid())
  number     String          // DN-YYYY-#### per company
  status     DebitNoteStatus @default(DRAFT)

  clientName  String
  clientEmail String?

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  reason   String?
  subtotal Float @default(0)
  tax      Float @default(0)
  total    Float @default(0)

  issuedAt  DateTime?
  settledAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items DebitNoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([number, companyId])
  @@index([companyId, status])
  @@index([companyId, clientName])
  @@map("debit_notes")
}

model DebitNoteItem {
  id          String    @id @default(cuid())
  description String
  quantity    Int       @default(1)
  unitPrice   Float
  total       Float
  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@map("debit_note_items")
}

model Salesperson {
  id                  String  @id @default(cuid())
  name                String
  email               String?
  // Default commission rate (percent of invoice value) used when generating
  // commission records. Can be overridden per generated record.
  defaultCommissionPct Float  @default(0)
  isActive            Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("salespeople")
}

model Commission {
  id            String           @id @default(cuid())
  salespersonId String
  salesperson   Salesperson      @relation(fields: [salespersonId], references: [id], onDelete: Cascade)

  // Source of the commissionable amount
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  periodMonth String           // YYYY-MM the commission belongs to
  baseAmount  Float            // commissionable base (e.g. invoice total ex-VAT)
  ratePct     Float            // percent applied
  amount      Float            // computed commission payout
  status      CommissionStatus @default(PENDING)
  note        String?

  approvedAt DateTime?
  paidAt     DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, periodMonth])
  @@index([salespersonId, status])
  @@map("commissions")
}
