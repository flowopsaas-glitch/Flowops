enum CustomsDeclarationStatus {
  DRAFT
  SUBMITTED
  QUERY
  RELEASED
  REJECTED
}

// Per-tenant SARS transmission method. FlowOps holds NO SARS credentials and is
// never the declarant — the tenant brings their own path (see the
// sars-edi-customs-bridge spec).
enum CustomsEdiPath {
  DIRECT_EDI             // tenant is a registered SARS EDI user
  SERVICE_PROVIDER       // tenant uses a SARS-approved VAN / EDI service provider
  CLEARING_AGENT_HANDOFF // no live wire — package handed to the tenant's agent
}

enum CustomsEdiCredentialStatus {
  UNVERIFIED
  VERIFIED
  DISABLED
}

// SAD (Single Administrative Document) declaration workflow (Phase 3). Holds a
// CUSDEC-style structured payload and a lifecycle. NOTE: actual SARS EDI wire
// submission requires SARS accreditation + a registered EDI gateway — this
// models the workflow + payload; submission is a pluggable stub for now.
model CustomsDeclaration {
  id     String                   @id @default(cuid())
  fileId String
  file   ShipmentFile             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type   String // IMPORT | EXPORT
  status CustomsDeclarationStatus @default(DRAFT)

  lrn String? // local reference number (our side)
  mrn String? // movement/customs reference (from SARS)

  payload           Json?  // CUSDEC-style declaration data
  customsValueTotal Float?
  dutyTotal         Float?
  vatTotal          Float?

  // Which transmission path actually lodged this (null until submitted live).
  lodgementProvider String?

  submittedAt  DateTime?
  responseAt   DateTime?
  responseNote String?

  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ediMessages CustomsEdiMessage[]

  @@index([fileId])
  @@index([companyId, status])
  @@map("customs_declarations")
}

// Per-tenant customs transmission credentials. One active record per company.
// Secret material is AES-256-GCM encrypted at rest and never returned to clients
// (masked on read). FlowOps never stores a platform-wide SARS credential.
model CustomsEdiCredential {
  id     String                     @id @default(cuid())
  companyId String
  path   CustomsEdiPath
  status CustomsEdiCredentialStatus  @default(UNVERIFIED)

  customsClientCode String? // tenant's SARS CCN (not secret — appears on the SAD)
  providerName      String? // VAN/provider label or agent name
  endpointUrl       String? // provider gateway / agent webhook
  agentEmail        String? // CLEARING_AGENT_HANDOFF target

  // Encrypted secret (AES-256-GCM). Never serialized to clients or logs.
  secretCiphertext String? @db.Text
  secretIv         String?
  secretAuthTag    String?

  lastVerifiedAt DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId]) // one credential record per tenant
  @@map("customs_edi_credentials")
}

// CUSDEC/CUSRES message log — audit trail + LRN-based idempotency for the bridge.
model CustomsEdiMessage {
  id            String             @id @default(cuid())
  declarationId String
  declaration   CustomsDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  companyId     String
  direction     String   // OUTBOUND | INBOUND
  messageType   String   // CUSDEC | CUSRES | VERIFY
  status        String   // SENT | ACK | ERROR | RECEIVED
  reference     String?  // provider/SARS message ref
  payload       Json?
  error         String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([declarationId])
  @@index([companyId, createdAt])
  @@map("customs_edi_messages")
}

// ─── Carriers & Procurement (buy-side) ─────────────────────────────────────
// Shipping lines, airlines, road carriers and broker/vendor partners a forwarder
// books space with — plus their negotiated buy-rates. Distinct from the sell-side
// RateCard. Scoped per tenant.
enum CarrierType {
  OCEAN_LINE
  AIRLINE
  ROAD_CARRIER
  COURIER
  CUSTOMS_BROKER
  OTHER
}

model Carrier {
  id            String      @id @default(cuid())
  companyId     String
  name          String
  type          CarrierType @default(OTHER)
  code          String?     // SCAC / IATA / internal code
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  accountNumber String?     // our account number with this carrier
  notes         String?     @db.Text
  isActive      Boolean     @default(true)

  rates     CarrierRate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive])
  @@map("carriers")
}

model CarrierRate {
  id            String   @id @default(cuid())
  carrierId     String
  carrier       Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  companyId     String
  lane          String?  // e.g. "CNSHA → ZADUR"
  mode          String?  // OCEAN | AIR | ROAD
  containerType String?  // 20GP | 40HC | LCL | AIR
  buyRate       Float    @default(0)
  currency      String   @default("USD")
  validFrom     DateTime?
  validTo       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([carrierId])
  @@map("carrier_rates")
}

// ─── Disbursements (clearing-agent finance) ────────────────────────────────
// Duties / VAT / port & line charges a forwarder pays to an authority ON BEHALF
// of a client, then recovers. Tracks paid-out vs recovered for the import/export
// finance desk. Scoped per tenant.
enum DisbursementStatus {
  OUTSTANDING // paid out to the authority, not yet recovered from the client
  INVOICED    // billed to the client (recovery invoice raised)
  RECOVERED   // client has reimbursed us
  WRITTEN_OFF // unrecoverable
}

model Disbursement {
  id          String             @id @default(cuid())
  companyId   String
  fileId      String?
  file        ShipmentFile?      @relation(fields: [fileId], references: [id], onDelete: SetNull)
  clientName  String?
  authority   String // SARS, port authority, shipping line, airline, etc.
  category    String? // DUTY | VAT | PORT | LINE | STORAGE | OTHER
  reference   String? // receipt / payment reference
  description String?
  amount      Float              @default(0) // amount paid out
  currency    String             @default("ZAR")
  status      DisbursementStatus @default(OUTSTANDING)
  paidAt      DateTime           @default(now())
  recoveredAt DateTime?
  invoiceId   String? // optional link to the same-company recovery invoice
  invoice     Invoice? @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([fileId])
  @@index([invoiceId])
  @@map("disbursements")
}

// ─── Waybills ─────────────────────────────────────────────────────────────


model Waybill {
  id             String        @id @default(cuid())
  trackingNumber String
  status         WaybillStatus @default(PENDING)

  // Proof of delivery for this waybill (0..n attempts; the active one gates billing).
  electronicPods ElectronicPod[]

  // Parties
  senderName       String
  senderPhone      String
  senderEmail      String?
  senderAddress    String
  recipientName    String
  recipientPhone   String
  recipientAddress String
  recipientEmail   String?

  // Geocoded coordinates (populated by the geocoding pipeline) — power routing,
  // the live map, ETA, and the public tracking page.
  senderLat    Float?
  senderLng    Float?
  recipientLat Float?
  recipientLng Float?

  // Parcel
  weight      Float?
  dimensions  String?
  description String?
  totalAmount Float?
  codAmount   Float?
  codCollected    Boolean   @default(false)   // driver has physically collected the cash
  codCollectedAt  DateTime?
  codCollectedAmount Float?                    // Amount ACTUALLY collected at the door (may differ from codAmount)
  codDiscrepancy     Float?                    // collected - owed: negative = short-paid, positive = over-paid, 0/null = exact

  // Customer delivery rating (requested via /waybills/:id/rate-request after delivery)
  customerRating      Int?
  customerRatingNote  String?
  ratingToken         String?   @unique
  ratingRequestedAt   DateTime?

  // Risk assessment
  riskLevel RiskLevel @default(LOW)
  riskScore Float?
  riskNotes String?

  // Proof of delivery (RECEIVER signature at delivery — Leg 7)
  podSignatureUrl String?
  podImageUrl     String?
  podRecipient    String?
  podDeliveredAt  DateTime?
  // Barcodes scanned at handover — audit trail of exactly what was delivered.
  podScannedCodes String[]

  // Proof of collection (SENDER + DRIVER signatures at pickup — Leg 1)
  // Complete chain of custody: sender confirms handover → driver acknowledges receipt
  pocSenderSignatureUrl    String?  // Sender signed on driver's phone at collection
  pocSenderName            String?  // Who signed at collection (sender side)
  pocDriverSignatureUrl    String?  // Driver signed to acknowledge receipt
  pocCollectionPhotoUrl    String?  // Photo of parcels at collection (condition evidence)
  pocCollectedAt           DateTime? // Timestamp of collection signatures

  // Provenance: the Collection row this waybill was created from. Set exactly
  // once, inside the same transaction that marks the collection COLLECTED, so a
  // replayed offline confirmation finds its waybill instead of creating a second.
  sourceCollectionId       String? @unique
  sourceCollection         Collection? @relation(fields: [sourceCollectionId], references: [id], onDelete: SetNull)

  // Delivery attempts (3x retry before return-to-sender)
  attemptCount    Int       @default(0)   // Number of delivery attempts made
  maxAttempts     Int       @default(3)   // Max attempts before return (configurable)
  nextAttemptAt   DateTime?               // Scheduled next attempt (auto-set on failure)
  lastAttemptNote String?                 // Free-text note for last failed attempt
  lastAttemptReasonCode FailedDeliveryReason? // Structured reason for the last failed attempt (for analytics)
  returnToSender  Boolean   @default(false) // True when max attempts exhausted

  // Uploaded scan file (Cloudflare R2 key)
  fileUrl String?
  fileKey String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  railConsignmentId String?
  railConsignment RailConsignment? @relation(fields: [railConsignmentId], references: [id], onDelete: SetNull)

  originBranchId String?
  originBranch   Branch? @relation("OriginBranch", fields: [originBranchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments        Shipment[]
  manifestWaybills ManifestWaybill[]
  tripCostEntries  TripCostEntry[]
  invoiceItem      InvoiceItem?
  inboxItem        WaybillInboxItem?
  codTransactions  CodTransaction[]
  returns          Return[]
  railHandoffEvidence RailHandoffEvidence[]

  @@unique([trackingNumber, companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, updatedAt])
  @@index([railConsignmentId])
  @@index([status, updatedAt])
  @@map("waybills")
}

model WaybillInboxItem {
  id     String @id @default(cuid())
  // PENDING | EXTRACTING | READY | COMMITTED | FAILED
  status String @default("PENDING")

  fileUrl  String?
  fileKey  String?
  mimeType String?

  // AI-extracted fields + confidence scores
  extractedData Json?
  aiConfidence  Float?
  aiError       String?

  waybillId String?  @unique
  waybill   Waybill? @relation(fields: [waybillId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waybill_inbox_items")
}

// ─── Collections ──────────────────────────────────────────────────────────

model Collection {
  id     String           @id @default(cuid())
  status CollectionStatus @default(PENDING)

