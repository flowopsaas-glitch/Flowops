// ─────────────────────────────────────────────────────────────────────────────
// RAIL / INTERMODAL OPERATIONS
//
// FlowOps sits ABOVE the rail network as a coordination + intelligence layer —
// it is NOT a signalling / slot-allocation / marshalling control system.
// A RailConsignment is the central record for cargo moving (in whole or part)
// by rail. Wagons/rakes, intermodal legs (road<->rail<->port handoffs) and a
// status event timeline hang off it. Additive; mirrors the ShipmentFile design.
// ─────────────────────────────────────────────────────────────────────────────

enum RailConsignmentStatus {
  PLANNED          // booked / slot requested
  WAGONS_ALLOCATED // rolling stock assigned
  LOADING          // at origin siding / terminal
  DEPARTED         // left origin
  IN_TRANSIT       // on the corridor
  AT_INTERCHANGE   // handoff point (border / yard / port)
  ARRIVED          // reached destination siding / terminal
  OFFLOADED        // cargo discharged
  COMPLETED        // consignment closed
  CANCELLED
}

enum WagonType {
  FLAT           // container / breakbulk
  GONDOLA        // bulk minerals (coal, manganese)
  TANK           // liquids / fuel
  BOXCAR         // covered general freight
  HOPPER         // free-flowing bulk
  CONTAINER_CAR  // intermodal container flats
}

enum IntermodalLegMode {
  ROAD
  RAIL
  PORT
}

enum IntermodalLegStatus {
  PENDING
  IN_PROGRESS
  HANDED_OVER
  COMPLETED
  DELAYED
}

enum HandoffReadinessStatus {
  DRAFT
  BLOCKED
  READY
  HANDED_OVER
}

enum HandoffEvidenceType {
  RAIL_RELEASE
  WAREHOUSE_RECEIPT
  WAYBILL_SCAN
  CARRIER_ACCEPTANCE
  COD_RECONCILIATION
  BILLING_RELEASE
}

enum HandoffEvidenceStatus {
  PENDING
  VERIFIED
  REJECTED
}

model RailConsignment {
  id                String                @id @default(cuid())
  consignmentNumber String // RAIL-2026-00042 (unique per tenant)
  status            RailConsignmentStatus @default(PLANNED)

  // Commercial / cargo
  clientName    String?
  commodity     String  // Copper cathodes | Coal | Manganese | Containers | Fuel...
  tonnage       Float?  // total planned tonnage
  wagonsPlanned Int?    // planned number of wagons/rake size

  // Corridor / routing
  corridor          String? // North-South | Maputo | Copperbelt | Coal Line...
  originSiding      String? // origin terminal / siding / mine
  destinationSiding String? // destination terminal / siding / port
  railOperator      String? // train operating company (TOC)
  serviceRef        String? // rail service / path / slot reference
  interchangePoint  String? // primary handoff (border / yard / port)

  // Schedule
  plannedDeparture DateTime?
  plannedArrival   DateTime?
  actualDeparture  DateTime?
  actualArrival    DateTime?

  // Coordination intelligence (FlowOps' value)
  slaHours     Int?    // target corridor transit SLA
  riskLevel    RiskLevel?
  riskNote     String? @db.Text

  // Dangerous goods (Wave 3). When isDangerousGoods is true the dispatch gate blocks departure
  // until every mandatory field below is present and well-formed (consignment value, or the
  // wagon's own where a wagon is flagged individually).
  isDangerousGoods    Boolean @default(false)
  unNumber            String? // UN1234
  imdgClass           String? // 3, 2.1, 6.1, 1.4S …
  placardRef          String?
  emergencyContact24h String?
  msdsDocumentUrl     String? // https link to the controlled safety data sheet

  // Weighbridge hold (Wave 4). While HOLD_FOR_LOAD_ADJUSTMENT the dispatch gate blocks departure. Derived from
  // the LATEST weighbridge reading of each wagon: it clears when every wagon has been re-weighed within its limit.
  holdStatus    RailHoldStatus @default(NONE)
  holdReason    String?        @db.Text
  holdSetAt     DateTime?
  holdClearedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wagons Wagon[]
  legs   IntermodalLeg[]
  events RailConsignmentEvent[]
  waybills Waybill[]
  handoffReadinesses RailHandoffReadiness[]
  truckAppointments  TerminalTruckAppointment[]

  @@unique([consignmentNumber, companyId])
  @@index([companyId, status])
  @@map("rail_consignments")
}

model Wagon {
  id             String    @id @default(cuid())
  consignmentId  String
  consignment    RailConsignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  wagonNumber    String    // rolling-stock ID e.g. SAR-064213
  type           WagonType @default(CONTAINER_CAR)
  tareTonnes     Float?    // empty weight
  loadedTonnes   Float?    // cargo weight on this wagon
  commodity      String?
  sealNumbers    String?
  lastKnownSiding String?  // location snapshot (coordination, not signalling)
  loadedAt       DateTime?
  offloadedAt    DateTime?

  // Corridor-envelope particulars (Wave 2). NULL = not declared, which the envelope check
  // reports as UNVERIFIED — never as "fits".
  axles          Int?               // axle count (axle load = (tare + loaded) / axles)
  gauge          RailGauge?
  vehicleProfile RailVehicleProfile?

  // Dangerous goods carried by THIS wagon (Wave 3). A field left empty inherits the consignment's.
  isDangerousGoods    Boolean @default(false)
  unNumber            String?
  imdgClass           String?
  placardRef          String?
  emergencyContact24h String?
  msdsDocumentUrl     String?

  @@index([consignmentId])
  @@map("wagons")
}

// ─── Digital Train Manifest (the departure document) ───────────────────────────
//
// The manifest is the legal record of which wagons moved on which train service.
// A DRAFT manifest is editable; ISSUING it is a formal attestation (signatory
// role), after which the document is IMMUTABLE — exactly like an approved Process
// Book version. An issued manifest can only be corrected by AMENDING it into a new
// revision (revision+1) which supersedes the old one; history is never rewritten.

enum RailTrainManifestStatus {
  DRAFT
  ISSUED
  DEPARTED
  ARRIVED
  CLOSED
  SUPERSEDED
  CANCELLED
}

model RailTrainManifest {
  id              String                  @id @default(cuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manifestNumber  String                  // TM-2026-00001 (unique per tenant per revision)
  revision        Int                     @default(1)
  supersedesId    String?
  status          RailTrainManifestStatus @default(DRAFT)

  // What moved, where, and under whose authority (snapshots at creation)
  consignmentId       String
  consignmentNumber   String
  slotApplicationId   String?
  trainServiceRef     String?
  corridor            String?
  originSiding        String?
  destinationSiding   String?
  railOperator        String?
  locoReference       String?
  plannedDeparture    DateTime?
  plannedArrival      DateTime?

  notes String? @db.Text

  // Lifecycle evidence — who attested what, when (server-verified identities)
  issuedAt        DateTime?
  issuedBy        String?   @db.Text
  departedAt      DateTime?
  departedBy      String?   @db.Text
  arrivedAt       DateTime?
  arrivedBy       String?   @db.Text
  closedAt        DateTime?
  closedBy        String?   @db.Text
  cancelledAt     DateTime?
  cancelledReason String?   @db.Text
  supersededAt    DateTime?
  supersededById  String?

  wagons RailTrainManifestWagon[]

  createdById    String?
  createdByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, manifestNumber, revision])
  @@index([companyId, status])
  @@index([consignmentId])
  @@map("rail_train_manifests")
}

// Frozen copy of the consist as it stood at issue time — a manifest never
// changes when the live wagon register later does.
model RailTrainManifestWagon {
  id         String     @id @default(cuid())
  manifestId String
  manifest   RailTrainManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  position     Int
  wagonNumber  String
  type         WagonType          @default(CONTAINER_CAR)
  tareTonnes   Float?
  loadedTonnes Float?
  commodity    String?
  sealNumbers  String?
  axles        Int?
  gauge        RailGauge?
  vehicleProfile RailVehicleProfile?

  // Dangerous goods carried by THIS wagon (empty fields inherit the consignment's)
  isDangerousGoods    Boolean @default(false)
  unNumber            String?
  imdgClass           String?
  placardRef          String?
  emergencyContact24h String?
  msdsDocumentUrl     String?

  note String?

  @@index([manifestId])
  @@map("rail_train_manifest_wagons")
}

// ─── Telemetry foundations (Phase 3) ───────────────────────────────────────────
//
// Device registry + time-series positions + rule-based health alerts. Ingestion
// authenticates per device (hashed ingest token) so wagon trackers can POST over
// plain HTTPS without a user account — the same contract an MQTT bridge will use
// when hardware partners arrive. Alerts are raised on ingest by the pure rules
// module and deduplicated while open.

enum RailDeviceKind {
  WAGON_TRACKER
  LOCO_TELEMATICS
  WAYBILL_SCANNER
  PORT_SCANNER
}

enum RailDeviceStatus {
  ACTIVE
  INACTIVE
  FAULTY
}

enum RailTelemetryAlertKind {
  SPEED_EXCEEDED
  BATTERY_LOW
  DEVICE_SILENT
  TEMPERATURE
}

enum RailAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model RailDevice {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceCode  String          // WT-000123 — the external id the hardware sends
  kind        RailDeviceKind  @default(WAGON_TRACKER)
  status      RailDeviceStatus @default(ACTIVE)
  label       String?
  wagonNumber String?
  locoReference String?
  simRef      String?
  speedLimitKph     Float?    // null = platform default
  batteryThresholdPct Float?  // null = platform default
  notes       String?         @db.Text

  // Device credential: only the SHA-256 hash is stored; the plaintext is shown
  // exactly once at creation / rotation (like a password reset token).
  tokenHash   String   @unique
  tokenPrefix String

  lastSeenAt    DateTime?
  lastLat       Float?
  lastLng       Float?
  lastSpeedKph  Float?
  lastBatteryPct Float?

  points RailTelemetryPoint[]
  alerts RailTelemetryAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, deviceCode])
  @@index([companyId, status])
  @@map("rail_devices")
}

model RailTelemetryPoint {
  id         String     @id @default(cuid())
  companyId  String
  deviceId   String
  device     RailDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  recordedAt DateTime  // when the hardware measured it
  receivedAt DateTime  @default(now())

  lat          Float
  lng          Float
  speedKph     Float?
  headingDeg   Float?
  odometerKm   Float?
  batteryPct   Float?
  temperatureC Float?
  doorOpen     Boolean?
  raw          Json?

  @@index([deviceId, recordedAt])
  @@index([companyId, recordedAt])
  @@map("rail_telemetry_points")
}

model RailTelemetryAlert {
  id        String                @id @default(cuid())
  companyId String
  deviceId  String
  device    RailDevice            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  kind      RailTelemetryAlertKind
  status    RailAlertStatus       @default(OPEN)

  message   String                @db.Text
  value     Float?
  threshold Float?

  raisedAt        DateTime @default(now())
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  resolvedAt      DateTime?

  @@index([companyId, status])
  @@index([deviceId, raisedAt])
  @@map("rail_telemetry_alerts")
}

// Road <-> Rail <-> Port handoffs — "the gap nobody owns".
model IntermodalLeg {
  id            String              @id @default(cuid())
  consignmentId String
  consignment   RailConsignment     @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  sequence      Int                 // 1,2,3... order of legs in the journey
  mode          IntermodalLegMode
  status        IntermodalLegStatus @default(PENDING)
  fromLocation  String?
  toLocation    String?
  handler       String?             // carrier / operator responsible for this leg
  plannedStart  DateTime?
  plannedEnd    DateTime?
