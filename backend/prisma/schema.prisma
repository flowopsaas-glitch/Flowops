generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  COMPANY_ADMIN
  MANAGER
  DISPATCH
  WAREHOUSE
  AGENT
  USER
  DRIVER
  VIEWER
}

enum WaybillStatus {
  PENDING
  COLLECTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
}

enum CollectionStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COLLECTED
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum DriverStatus {
  AVAILABLE
  ON_ROUTE
  OFFLINE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum DigestFrequency {
  INSTANT
  DAILY
  WEEKLY
}

// ─── Platform Owner (super-admin, separate from tenant users) ─────────────

model OwnerUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens OwnerRefreshToken[]

  @@map("owner_users")
}

model OwnerRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  ownerId   String
  owner     OwnerUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@map("owner_refresh_tokens")
}

// ─── Tenant Company ────────────────────────────────────────────────────────

model Company {
  id          String  @id @default(cuid())
  name        String
  tradingName String?
  email       String? @unique
  phone       String?
  address     String?
  city        String?
  country     String  @default("ZA")
  vatNumber   String?

  // WhatsApp — tenant's own mobile number used for click-to-chat (wa.me) links.
  // No Business API token needed; agents send from this number via WhatsApp Web/app.
  whatsappNumber String?

  // Branding
  logoUrl            String?
  brandName          String?
  primaryColor       String?
  secondaryColor     String?
  invoiceHeaderColor String?

  // Customer-facing booking portal
  portalBrandName    String?
  portalSubdomain    String? @unique
  portalPrimaryColor String?
  portalLogoUrl      String?

  // SLA thresholds (minutes)
  slaWarningMinutes  Int @default(30)
  slaBreachMinutes   Int @default(60)
  slaEscalateMinutes Int @default(120)

  // Billing plan
  plan          String   @default("starter")
  trialStartedAt DateTime @default(now())
  trialEndsAt   DateTime?
  isActive      Boolean  @default(true)

  // ── Owner-managed subscription overrides ──────────────────────────────
  // Per-tenant feature add-ons granted beyond the plan tier (key -> true),
  // e.g. give a Professional tenant `freightForwarding` without a full upgrade.
  // Merged on top of the plan's feature flags by BillingService.
  featureOverrides Json?
  // Custom monthly price (ZAR) the owner negotiated for this tenant. When set,
  // it overrides the plan list price for MRR + billing display. Null = use plan.
  priceOverrideZar Float?

  // CLAW Autopilot for Operations (Enterprise) — when enabled, the autonomy
  // engine may auto-execute safe ops actions (reassign stalled pickups,
  // escalate SLA pre-breaches / COD mismatches). Aggression overrides the
  // global CLAW_AGGRESSION_LEVEL for this tenant when set (LOW|MEDIUM|HIGH).
  autopilotEnabled    Boolean @default(false)
  autopilotAggression String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  waybills           Waybill[]
  waybillInboxItems  WaybillInboxItem[]
  collections        Collection[]
  shipments          Shipment[]
  drivers            Driver[]
  driverChatMessages DriverChatMessage[] @relation("CompanyDriverChats")
  branches           Branch[]
  manifests          Manifest[]
  invoices           Invoice[]
  invoiceDrafts      InvoiceDraft[]
  rateCards          RateCard[]
  quotes             Quote[]
  notifications      Notification[]
  whatsappThreads    WhatsAppThread[]
  payments           Payment[]
  leads              Lead[]
  bookingPortalLinks BookingPortalLink[]
  aiEvents           AiEvent[]
  emailHubItems      EmailHubItem[]
  workflows          Workflow[]
  approvalRequest    ApprovalRequest?
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  codTransactions    CodTransaction[]
  clients            Client[]
  returns            Return[]
  creditNotes        CreditNote[]
  debitNotes         DebitNote[]
  salespeople        Salesperson[]
  commissions        Commission[]
  accountingConnections AccountingConnection[]
  accountingSyncLogs    AccountingSyncLog[]
  ssoConnection         SsoConnection?
  supportTickets        SupportTicket[]
  courierOrders         CourierOrder[]
  integrationCredentials IntegrationCredential[]

  @@map("companies")
}

// ─── Integration credentials (per-tenant, encrypted) ────────────────────────
// Tenant-owned connection secrets for external providers (WhatsApp Business API,
// Shopify, WooCommerce). Secret material is AES-256-GCM encrypted at rest and
// NEVER returned to any client. `externalRef` is the inbound-routing key
// (WhatsApp phone_number_id, Shopify shop domain, WooCommerce source URL) so a
// webhook can be matched to its owning company with a single indexed lookup.
model IntegrationCredential {
  id               String    @id @default(cuid())
  companyId        String
  provider         String    // 'whatsapp' | 'shopify' | 'woocommerce'
  config           Json?     // non-secret fields (phoneNumberId, shopDomain, ...)
  externalRef      String?   // inbound-routing key (lowercased/normalised)
  secretCiphertext String?
  secretIv         String?
  secretAuthTag    String?
  status           String    @default("UNVERIFIED")
  lastVerifiedAt   DateTime?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([provider, externalRef])
  @@map("integration_credentials")
}

// ─── Users ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  name         String
  phone        String?
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true)

  // Per-user nav/feature permission overrides (key -> boolean). When set,
  // these take precedence over the role defaults for sidebar + route access.
  permissions  Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Email verification
  emailVerified     Boolean   @default(false)
  verifyToken       String?
  verifyTokenExpiry DateTime?

  // Password reset
  resetToken       String?
  resetTokenExpiry DateTime?

  // ── Single active session + login audit ───────────────────────────────
  // Only one device may hold a live session at a time. Each login mints a new
  // sessionId (also embedded in the access token as `sid`); the JWT strategy
  // rejects any token whose sid != activeSessionId, so a new login elsewhere
  // immediately invalidates every other device.
  activeSessionId    String?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginUserAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens          RefreshToken[]
  notificationPreference NotificationPreference?
  assignedCollections    Collection[]            @relation("AssignedAgent")
  assignedShipments      Shipment[]
  // Optional link to a Driver record so DRIVER-role users see only their own jobs
  linkedDriver           Driver?

  @@unique([email, companyId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─── Public API & Webhooks (tenant integrations: Shopify, etc.) ───────────

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  // Only the SHA-256 hash is stored; the plaintext key is shown once at creation.
  keyHash    String    @unique
  prefix     String // first chars, for display ("fok_live_ab12…")
  lastUsedAt DateTime?
  revokedAt  DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("api_keys")
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  secret    String // used to HMAC-sign deliveries so receivers can verify
  events    String[] // e.g. ["waybill.status_changed", "waybill.delivered"]
  active    Boolean  @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model ApprovalRequest {
  id       String         @id @default(cuid())
  status   ApprovalStatus @default(PENDING)
  fullName String
  email    String
  phone    String
  company  String
  notes    String?

  // Dedicated field for the bcrypt password hash — never stored in notes/JSON.
  // Set during registration; consumed and cleared after the admin account is
  // created on approval. Kept separate so it is never exposed in approval
  // request listings.
  passwordHash String?

  // Linked once approved
  companyId     String?  @unique
  tenantCompany Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("approval_requests")
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Master channel toggles
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)
  pushEnabled  Boolean @default(true)

  // Per-category × channel
  operationsEmail Boolean @default(true)
  operationsSms   Boolean @default(false)
  operationsPush  Boolean @default(true)
  billingEmail    Boolean @default(true)
  billingPush     Boolean @default(false)
  securityEmail   Boolean @default(true)
  securityPush    Boolean @default(true)
  systemEmail     Boolean @default(false)
  systemPush      Boolean @default(false)

  // Digest
  digestFrequency DigestFrequency @default(INSTANT)

  // Quiet hours
  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String  @default("22:00")
  quietHoursEnd     String  @default("07:00")
  timezone          String  @default("Africa/Johannesburg")

  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// ─── Drivers ──────────────────────────────────────────────────────────────

model Driver {
  id          String       @id @default(cuid())
  name        String
  phone       String
  email       String?
  vehicleType String       @default("motorbike")
  vehicleReg  String?
  status      DriverStatus @default(OFFLINE)
  isActive    Boolean      @default(true)

  // ── Customer delivery rating ──────────────────────────────────────────
  customerRating      Int?
  customerRatingNote  String?
  ratingToken         String?   @unique
  ratingRequestedAt   DateTime?

  // Last known GPS position
  lastLat  Float?
  lastLng  Float?
  lastSeen DateTime?

  // Driver portal auth (phone + hashed 4-digit PIN)
  driverPin String?

  // ── Single active session + login audit (driver portal) ───────────────
  // Mirrors the User model: one device per driver. driver-login mints a new
  // sessionId embedded in the driver token as `sid`.
  activeSessionId    String?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginUserAgent String?

  // Optional link to a User account — enables role-scoped job delivery
  userId    String? @unique
  user      User?   @relation(fields: [userId], references: [id])

  // Fleet / vehicle maintenance
  currentKm       Int?       // current odometer reading
  nextServiceKm   Int?       // odometer reading at which next service is due
  nextServiceDate DateTime?  // calendar-based service due date
  vehicleNotes    String?    // free-form notes (tyre condition, defects etc.)

  chatMessages    DriverChatMessage[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections     Collection[]
  shipments       Shipment[]
  manifests       Manifest[]
  wallet          DriverWallet?
  services        VehicleService[]
  returns         Return[]
  refreshTokens   DriverRefreshToken[]

  @@map("drivers")
}

// Driver refresh tokens — enables silent token rotation (4h access / 7d refresh)
// so drivers don't get kicked out mid-shift when their short-lived access token expires.
model DriverRefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("driver_refresh_tokens")
}

// ─── Branches ─────────────────────────────────────────────────────────────

model Branch {
  id      String  @id @default(cuid())
  name    String
  address String?
  city    String?
  lat     Float?
  lng     Float?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivers   Driver[]
  manifests Manifest[]
  waybills  Waybill[]  @relation("OriginBranch")

  @@map("branches")
}

// ─── Freight Forwarding (import/export) ─────────────────────────────────────
// New product line: ocean/air container import/export. A ShipmentFile is the
// central record per consignment; containers/cargo, routing milestones, charges
// (cost vs sell) and documents hang off it. Additive — no changes to the
// existing courier tables. See .kiro/specs/freight-forwarding.

enum FreightMode {
  OCEAN
  AIR
  ROAD
}

enum FreightDirection {
  IMPORT
  EXPORT
}

enum LoadType {
  FCL
  LCL
  BREAKBULK
  AIR
}

enum ShipmentFileStatus {
  DRAFT
  BOOKED
  CARGO_RECEIVED
  LOADED
  DEPARTED
  ARRIVED
  CUSTOMS_CLEARED
  DELIVERED
  CANCELLED
}

model ShipmentFile {
  id         String              @id @default(cuid())
  fileNumber String // e.g. IMP-2026-00042 (unique per tenant)
  mode       FreightMode
  direction  FreightDirection
  loadType   LoadType
  status     ShipmentFileStatus  @default(DRAFT)
  incoterm   String? // EXW|FOB|CIF|DDP...

  // Parties (denormalised; optional Client links can come later)
  shipperName   String?
  consigneeName String?
  notifyParty   String?
  carrierName   String?
  agentName     String?

  // Cargo summary
  goodsDescription String? @db.Text
  packages         Int?
  grossWeightKg    Float?
  volumeCbm        Float?

  // Routing
  pol          String? // port of loading (UN/LOCODE or name)
  pod          String? // port of discharge
  vesselVoyage String? // or flight number
  etd          DateTime?
  eta          DateTime?

  // AI-derived (demurrage / delay risk)
  aiRiskScore Int?
  aiRiskNote  String? @db.Text

  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  containers ShipmentContainer[]
  cargo      CargoLine[]
  charges    ShipmentCharge[]
  documents  ShipmentDocument[]
  milestones ShipmentMilestone[]
  declarations CustomsDeclaration[]
  disbursements Disbursement[]

  // Consolidation / co-load (Phase 3): house files grouped under a master file.
  isMaster     Boolean        @default(false)
  masterFileId String?
  master       ShipmentFile?  @relation("Consolidation", fields: [masterFileId], references: [id], onDelete: SetNull)
  houseFiles   ShipmentFile[] @relation("Consolidation")

  @@unique([fileNumber, companyId])
  @@index([companyId, status])
  @@map("shipment_files")
}

model ShipmentContainer {
  id          String       @id @default(cuid())
  fileId      String
  file        ShipmentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  containerNo String // e.g. ABCU1234567
  isoType     String // 20GP|40HC|40RF...
  sealNo      String?
  vgmKg       Float?

  // Demurrage / detention (Phase 3)
  freeDays      Int?      // free days before per-diem starts
  perDiemRate   Float?    // demurrage/detention rate per day
  availableFrom DateTime? // clock start (discharge / availability)
  returnedAt    DateTime? // empty-return / gate-in (clock stop)

  @@index([fileId])
  @@map("shipment_containers")
}

model CargoLine {
  id           String       @id @default(cuid())
  fileId       String
  file         ShipmentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  description  String
  pieces       Int?
  weightKg     Float?
  dimensions   String?
  hsCode       String? // tariff heading
  customsValue Float?
  dutyRatePct  Float? // ad valorem duty rate % (operator-set or AI-suggested)

  @@index([fileId])
  @@map("cargo_lines")
}

model ShipmentCharge {
  id          String       @id @default(cuid())
  fileId      String
  file        ShipmentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  description String
  currency    String       @default("ZAR")
  cost        Float        @default(0)
  sell        Float        @default(0)
  invoiceTo   String? // party to bill

  @@index([fileId])
  @@map("shipment_charges")
}

model ShipmentDocument {
  id        String       @id @default(cuid())
  fileId    String
  file      ShipmentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type      String // BILL_OF_LADING|COMMERCIAL_INVOICE|PACKING_LIST|CERT_OF_ORIGIN|SAD500|OTHER
  fileName  String
  fileKey   String // storage key (R2/local)
  createdAt DateTime @default(now())

  @@index([fileId])
  @@map("shipment_documents")
}

model ShipmentMilestone {
  id        String             @id @default(cuid())
  fileId    String
  file      ShipmentFile       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  status    ShipmentFileStatus
  note      String?
  reachedAt DateTime           @default(now())

  @@index([fileId])
  @@map("shipment_milestones")
}

enum CustomsDeclarationStatus {
  DRAFT
  SUBMITTED
  QUERY
  RELEASED
  REJECTED
}

// Per-tenant SARS transmission method. FlowOps holds NO SARS credentials and is
// never the declarant — the tenant brings their own path (see the
// sars-edi-customs-bridge spec).
enum CustomsEdiPath {
  DIRECT_EDI             // tenant is a registered SARS EDI user
  SERVICE_PROVIDER       // tenant uses a SARS-approved VAN / EDI service provider
  CLEARING_AGENT_HANDOFF // no live wire — package handed to the tenant's agent
}

enum CustomsEdiCredentialStatus {
  UNVERIFIED
  VERIFIED
  DISABLED
}

// SAD (Single Administrative Document) declaration workflow (Phase 3). Holds a
// CUSDEC-style structured payload and a lifecycle. NOTE: actual SARS EDI wire
// submission requires SARS accreditation + a registered EDI gateway — this
// models the workflow + payload; submission is a pluggable stub for now.
model CustomsDeclaration {
  id     String                   @id @default(cuid())
  fileId String
  file   ShipmentFile             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type   String // IMPORT | EXPORT
  status CustomsDeclarationStatus @default(DRAFT)

  lrn String? // local reference number (our side)
  mrn String? // movement/customs reference (from SARS)

  payload           Json?  // CUSDEC-style declaration data
  customsValueTotal Float?
  dutyTotal         Float?
  vatTotal          Float?

  // Which transmission path actually lodged this (null until submitted live).
  lodgementProvider String?

  submittedAt  DateTime?
  responseAt   DateTime?
  responseNote String?

  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ediMessages CustomsEdiMessage[]

  @@index([fileId])
  @@index([companyId, status])
  @@map("customs_declarations")
}

// Per-tenant customs transmission credentials. One active record per company.
// Secret material is AES-256-GCM encrypted at rest and never returned to clients
// (masked on read). FlowOps never stores a platform-wide SARS credential.
model CustomsEdiCredential {
  id     String                     @id @default(cuid())
  companyId String
  path   CustomsEdiPath
  status CustomsEdiCredentialStatus  @default(UNVERIFIED)

  customsClientCode String? // tenant's SARS CCN (not secret — appears on the SAD)
  providerName      String? // VAN/provider label or agent name
  endpointUrl       String? // provider gateway / agent webhook
  agentEmail        String? // CLEARING_AGENT_HANDOFF target

  // Encrypted secret (AES-256-GCM). Never serialized to clients or logs.
  secretCiphertext String? @db.Text
  secretIv         String?
  secretAuthTag    String?

  lastVerifiedAt DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId]) // one credential record per tenant
  @@map("customs_edi_credentials")
}

// CUSDEC/CUSRES message log — audit trail + LRN-based idempotency for the bridge.
model CustomsEdiMessage {
  id            String             @id @default(cuid())
  declarationId String
  declaration   CustomsDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  companyId     String
  direction     String   // OUTBOUND | INBOUND
  messageType   String   // CUSDEC | CUSRES | VERIFY
  status        String   // SENT | ACK | ERROR | RECEIVED
  reference     String?  // provider/SARS message ref
  payload       Json?
  error         String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([declarationId])
  @@index([companyId, createdAt])
  @@map("customs_edi_messages")
}

// ─── Carriers & Procurement (buy-side) ─────────────────────────────────────
// Shipping lines, airlines, road carriers and broker/vendor partners a forwarder
// books space with — plus their negotiated buy-rates. Distinct from the sell-side
// RateCard. Scoped per tenant.
enum CarrierType {
  OCEAN_LINE
  AIRLINE
  ROAD_CARRIER
  COURIER
  CUSTOMS_BROKER
  OTHER
}

model Carrier {
  id            String      @id @default(cuid())
  companyId     String
  name          String
  type          CarrierType @default(OTHER)
  code          String?     // SCAC / IATA / internal code
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  accountNumber String?     // our account number with this carrier
  notes         String?     @db.Text
  isActive      Boolean     @default(true)

  rates     CarrierRate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive])
  @@map("carriers")
}

model CarrierRate {
  id            String   @id @default(cuid())
  carrierId     String
  carrier       Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  companyId     String
  lane          String?  // e.g. "CNSHA → ZADUR"
  mode          String?  // OCEAN | AIR | ROAD
  containerType String?  // 20GP | 40HC | LCL | AIR
  buyRate       Float    @default(0)
  currency      String   @default("USD")
  validFrom     DateTime?
  validTo       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([carrierId])
  @@map("carrier_rates")
}

// ─── Disbursements (clearing-agent finance) ────────────────────────────────
// Duties / VAT / port & line charges a forwarder pays to an authority ON BEHALF
// of a client, then recovers. Tracks paid-out vs recovered for the import/export
// finance desk. Scoped per tenant.
enum DisbursementStatus {
  OUTSTANDING // paid out to the authority, not yet recovered from the client
  INVOICED    // billed to the client (recovery invoice raised)
  RECOVERED   // client has reimbursed us
  WRITTEN_OFF // unrecoverable
}

model Disbursement {
  id          String             @id @default(cuid())
  companyId   String
  fileId      String?
  file        ShipmentFile?      @relation(fields: [fileId], references: [id], onDelete: SetNull)
  clientName  String?
  authority   String // SARS, port authority, shipping line, airline, etc.
  category    String? // DUTY | VAT | PORT | LINE | STORAGE | OTHER
  reference   String? // receipt / payment reference
  description String?
  amount      Float              @default(0) // amount paid out
  currency    String             @default("ZAR")
  status      DisbursementStatus @default(OUTSTANDING)
  paidAt      DateTime           @default(now())
  recoveredAt DateTime?
  invoiceId   String? // optional link to the recovery invoice

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([fileId])
  @@map("disbursements")
}

// ─── Waybills ─────────────────────────────────────────────────────────────


model Waybill {
  id             String        @id @default(cuid())
  trackingNumber String
  status         WaybillStatus @default(PENDING)

  // Parties
  senderName       String
  senderPhone      String
  senderAddress    String
  recipientName    String
  recipientPhone   String
  recipientAddress String
  recipientEmail   String?

  // Geocoded coordinates (populated by the geocoding pipeline) — power routing,
  // the live map, ETA, and the public tracking page.
  senderLat    Float?
  senderLng    Float?
  recipientLat Float?
  recipientLng Float?

  // Parcel
  weight      Float?
  dimensions  String?
  description String?
  totalAmount Float?
  codAmount   Float?
  codCollected    Boolean   @default(false)   // driver has physically collected the cash
  codCollectedAt  DateTime?

  // Customer delivery rating (requested via /waybills/:id/rate-request after delivery)
  customerRating      Int?
  customerRatingNote  String?
  ratingToken         String?   @unique
  ratingRequestedAt   DateTime?

  // Risk assessment
  riskLevel RiskLevel @default(LOW)
  riskScore Float?
  riskNotes String?

  // Proof of delivery
  podSignatureUrl String?
  podImageUrl     String?
  podRecipient    String?
  podDeliveredAt  DateTime?

  // Uploaded scan file (Cloudflare R2 key)
  fileUrl String?
  fileKey String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  originBranchId String?
  originBranch   Branch? @relation("OriginBranch", fields: [originBranchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments        Shipment[]
  manifestWaybills ManifestWaybill[]
  invoiceItems     InvoiceItem[]
  inboxItem        WaybillInboxItem?
  codTransactions  CodTransaction[]
  returns          Return[]

  @@unique([trackingNumber, companyId])
  @@map("waybills")
}

model WaybillInboxItem {
  id     String @id @default(cuid())
  // PENDING | EXTRACTING | READY | COMMITTED | FAILED
  status String @default("PENDING")

  fileUrl  String?
  fileKey  String?
  mimeType String?

  // AI-extracted fields + confidence scores
  extractedData Json?
  aiConfidence  Float?
  aiError       String?

  waybillId String?  @unique
  waybill   Waybill? @relation(fields: [waybillId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waybill_inbox_items")
}

// ─── Collections ──────────────────────────────────────────────────────────

model Collection {
  id     String           @id @default(cuid())
  status CollectionStatus @default(PENDING)

  clientName    String
  clientPhone   String
  clientEmail   String?
  pickupAddress String
  notes         String?

  // Geocoded pickup coordinates (populated by the geocoding pipeline).
  pickupLat Float?
  pickupLng Float?

  scheduledAt DateTime?
  pickedUpAt  DateTime?

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  agentId String?
  agent   User?   @relation("AssignedAgent", fields: [agentId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collections")
}

// ─── Shipments ────────────────────────────────────────────────────────────

model Shipment {
  id     String         @id @default(cuid())
  status ShipmentStatus @default(PENDING)

  waybillId String
  waybill   Waybill @relation(fields: [waybillId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  currentLat Float?
  currentLng Float?

  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipments")
}

// ─── Manifests ────────────────────────────────────────────────────────────

model Manifest {
  id   String @id @default(cuid())
  code String

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  dispatched   Boolean   @default(false)
  dispatchedAt DateTime?
  pdfKey       String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waybills ManifestWaybill[]

  @@map("manifests")
}

model ManifestWaybill {
  manifestId String
  manifest   Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  waybillId String
  waybill   Waybill  @relation(fields: [waybillId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@id([manifestId, waybillId])
  @@map("manifest_waybills")
}

// ─── Invoices ─────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)

  clientName  String
  clientEmail String?

  subtotal Float @default(0)
  tax      Float @default(0)
  total    Float @default(0)

  dueDate DateTime?
  paidAt  DateTime?
  sentAt  DateTime?

  notes String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  commissions Commission[]

  @@unique([invoiceNumber, companyId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  waybillId String?
  waybill   Waybill? @relation(fields: [waybillId], references: [id])

  @@map("invoice_items")
}

model InvoiceDraft {
  id    String  @id @default(cuid())
  title String?

  // Flexible JSON for AI-assisted drafting
  draftData  Json?
  aiAnalysis Json?

  finalized   Boolean   @default(false)
  finalizedAt DateTime?
  invoiceId   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_drafts")
}

// ─── Rate Cards & Quotes ──────────────────────────────────────────────────

model RateCard {
  id         String  @id @default(cuid())
  name       String
  fromZone   String?
  toZone     String?
  minWeight  Float?
  maxWeight  Float?
  basePrice  Float
  pricePerKg Float   @default(0)
  isActive   Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rate_cards")
}

model Quote {
  id          String  @id @default(cuid())
  fromAddress String
  toAddress   String
  clientName  String?   // optional — who the quote is for
  weight      Float
  price       Float
  breakdown   Json?
  accepted    Boolean   @default(false)
  expiresAt   DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("quotes")
}

// ─── Notifications ────────────────────────────────────────────────────────

model Notification {
  id    String  @id @default(cuid())
  title String
  body  String
  type  String  @default("info")
  read  Boolean @default(false)
  readAt DateTime?
  link  String?

  // null = broadcast to whole company
  userId String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// ─── WhatsApp ─────────────────────────────────────────────────────────────

model WhatsAppThread {
  id            String    @id @default(cuid())
  phone         String
  name          String?
  lastMessage   String?
  lastMessageAt DateTime?
  unreadCount   Int       @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages WhatsAppMessage[]

  @@unique([phone, companyId])
  @@map("whatsapp_threads")
}

model WhatsAppMessage {
  id        String           @id @default(cuid())
  content   String
  direction MessageDirection

  // Meta WABA tracking
  wabaMessageId String?
  // sent | delivered | read | failed
  status        String  @default("sent")

  mediaUrl  String?
  mediaType String?

  threadId String
  thread   WhatsAppThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  sentAt DateTime @default(now())

  @@map("whatsapp_messages")
}

// ─── Payments (Paystack) ──────────────────────────────────────────────────

model Payment {
  id        String        @id @default(cuid())
  reference String        @unique
  status    PaymentStatus @default(PENDING)
  amount    Float
  currency  String        @default("ZAR")
  description String?

  paystackReference String?
  paystackChannel   String?

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  customerEmail String?
  customerName  String?

  paidAt DateTime?

  // Full webhook payload kept for audit trail
  webhookPayload Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

// ─── Booking Portal ───────────────────────────────────────────────────────

model BookingPortalLink {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  label     String?
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  requests BookingRequest[]

  @@map("booking_portal_links")
}

model BookingRequest {
  id     String @id @default(cuid())
  status String @default("pending")

  senderName       String
  senderPhone      String
  senderAddress    String
  recipientName    String
  recipientPhone   String
  recipientAddress String
  notes            String?

  linkId String
  link   BookingPortalLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("booking_requests")
}

// ─── AI & Email Hub ───────────────────────────────────────────────────────

model AiEvent {
  id       String @id @default(cuid())
  type     String
  title    String
  body     String
  severity String @default("info")

  resolved   Boolean   @default(false)
  dismissed  Boolean   @default(false)
  resolvedAt DateTime?

  sourceType String?
  sourceId   String?
  metadata   Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("ai_events")
}

model EmailHubItem {
  id       String  @id @default(cuid())
  subject  String
  from     String
  to       String
  body     String? @db.Text
  read     Boolean @default(false)
  resolved Boolean @default(false)
  category String?

  // ── Triage / classification (matches frontend contract) ──
  type      String @default("GENERAL") // COLLECTION_REQUEST|POD|QUOTE|FEEDBACK|NOTIFICATION|AI_MONITOR|GENERAL
  status    String @default("NEW") // NEW|TRIAGED|IN_PROGRESS|WAITING|RESOLVED|ARCHIVED
  priority  String @default("MEDIUM") // LOW|MEDIUM|HIGH|CRITICAL
  direction String @default("INBOUND") // INBOUND|OUTBOUND

  senderName     String?
  senderEmail    String?
  recipientEmail String?

  waybillNumber String?
  podNumber     String?

  // ── AI monitoring ──
  aiSummary         String? @db.Text
  aiConfidence      Float?
  aiCategory        String?
  aiSuggestedAction String?
  opsNote           String? @db.Text

  isRead         Boolean  @default(false)
  needsOpsAction Boolean  @default(false)
  receivedAt     DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  attachments EmailAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("email_hub_items")
}

model EmailAttachment {
  id             String       @id @default(cuid())
  emailHubItemId String
  emailHubItem   EmailHubItem @relation(fields: [emailHubItemId], references: [id], onDelete: Cascade)

  filename String
  mimeType String?
  size     Int     @default(0)
  fileKey  String? // object key in Cloudflare R2
  fileUrl  String? // resolved (signed/public) URL

  // ── AI threat scan ──
  scanStatus   String    @default("PENDING") // PENDING|CLEAN|THREAT|SKIPPED|ERROR
  threatLevel  String    @default("NONE") // NONE|LOW|MEDIUM|HIGH|CRITICAL
  threatReason String?
  scanEngine   String? // heuristic | clamav | virustotal
  scannedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([emailHubItemId])
  @@map("email_attachments")
}

// ─── Leads ────────────────────────────────────────────────────────────────

model Lead {
  id    String  @id @default(cuid())
  email String
  notes String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("leads")
}

// ─── Workflows ────────────────────────────────────────────────────────────

model Workflow {
  id       String  @id @default(cuid())
  name     String
  script   String  @db.Text
  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  databases WorkflowDatabase[]

  @@map("workflows")
}

model WorkflowDatabase {
  id         String   @id @default(cuid())
  name       String
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  columns    Json
  rows       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workflow_databases")
}



// ── Platform audit trail ───────────────────────────────────────────────────
// Immutable record of privileged owner/platform actions: tenant approve/reject/
// suspend, plan changes, and "view-as-tenant" impersonation. Surfaced in the
// owner console for compliance + accountability.
model AuditLog {
  id         String   @id @default(cuid())
  actorType  String   @default("owner") // owner | tenant | system
  actorId    String?
  actorEmail String?
  action     String // e.g. tenant.approve, tenant.suspend, tenant.plan_change, tenant.impersonate
  targetType String? // company | user | request
  targetId   String?
  targetName String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@map("audit_logs")
}



// ── MRR history (true revenue movement) ────────────────────────────────────
// A daily point-in-time snapshot of platform MRR plus a per-tenant price map,
// so the owner console can compute real MRR movement (new / expansion /
// contraction / churn) by diffing consecutive snapshots — instead of the
// window approximation used before.
model MrrSnapshot {
  id            String   @id @default(cuid())
  date          DateTime @unique // midnight of the snapshot day
  mrr           Float
  activeTenants Int
  payingTenants Int
  perTenant     Json // { [companyId]: monthlyPrice }
  createdAt     DateTime @default(now())

  @@index([date])
  @@map("mrr_snapshots")
}



// ── Platform alerts (owner alerting engine) ────────────────────────────────
// Generated by the alerting cron when churn, SLA-exception spikes, or payment
// failures are detected. `dedupeKey` makes generation idempotent so the owner
// is notified once per condition rather than on every cron tick.
model PlatformAlert {
  id         String    @id @default(cuid())
  type       String // churn | sla_spike | payment_failure
  severity   String    @default("warning") // info | warning | critical
  title      String
  message    String
  tenantId   String?
  tenantName String?
  metadata   Json?
  dedupeKey  String    @unique
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolved])
  @@index([createdAt])
  @@map("platform_alerts")
}


// ─── COD Reconciliation ────────────────────────────────────────────────────

model DriverWallet {
  id             String    @id @default(cuid())
  driverId       String    @unique
  balance        Float     @default(0)
  totalCollected Float     @default(0)
  totalSettled   Float     @default(0)
  lastSettledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver       Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  transactions CodTransaction[]

  @@map("driver_wallets")
}

model CodTransaction {
  id        String             @id @default(cuid())
  walletId  String
  waybillId String?
  companyId String
  type      CodTransactionType
  amount    Float
  balance   Float              // running balance after this entry
  note      String?

  createdAt DateTime @default(now())

  wallet  DriverWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  waybill Waybill?    @relation(fields: [waybillId], references: [id])
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("cod_transactions")
}

enum CodTransactionType {
  COLLECTION   // driver collected cash from a recipient
  SETTLEMENT   // driver remitted cash to the company
  ADJUSTMENT   // manual balance correction
}

// ─── Webhook Delivery Log ──────────────────────────────────────────────────

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  event          String
  payload        String                // JSON-serialised event body
  status         WebhookDeliveryStatus @default(PENDING)
  responseStatus Int?
  responseBody   String?
  attempts       Int                   @default(0)
  nextRetryAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
  EXHAUSTED
}


// ─── Vehicle / Fleet Maintenance ──────────────────────────────────────────

model VehicleService {
  id          String   @id @default(cuid())
  driverId    String
  serviceType String   // e.g. "Oil Change", "Tyre Rotation", "Annual Service"
  notes       String?
  kmAtService Int?
  cost        Float?
  servicedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, servicedAt])
  @@map("vehicle_services")
}


// ─── Client Directory ─────────────────────────────────────────────────────
// Proper client records with billing types — separate from the waybill-derived
// read-only directory. COD, prepaid, and contract clients each have different
// defaults (COD amount policy, credit limit, or contract terms).

enum ClientBillingType {
  COD        // Cash on delivery — driver collects per waybill
  PREPAID    // Client pays before dispatch
  CONTRACT   // Monthly invoiced account with credit terms
  CASH       // Walk-in / once-off cash payer
}

model Client {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Identity
  name          String
  tradingName   String?
  phone         String?
  email         String?
  address       String?

  // Billing
  billingType   ClientBillingType @default(COD)
  creditLimit   Float?            // for CONTRACT clients
  paymentTerms  Int?              // days — e.g. 30 for net-30
  vatNumber     String?
  accountCode   String?

  // Contract
  contractStart DateTime?
  contractEnd   DateTime?
  notes         String?

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, billingType])
  @@index([companyId, name])
  @@map("clients")
}


// ── Driver ↔ Dispatch real-time chat ─────────────────────────────────────────

model DriverChatMessage {
  id             String    @id @default(cuid())
  driverId       String
  driver         Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company   @relation("CompanyDriverChats", fields: [companyId], references: [id], onDelete: Cascade)
  /// 'driver' | 'dispatch'
  senderType     String
  message        String
  attachmentUrl  String?
  attachmentType String?   // 'image' | 'document'
  readAt         DateTime? // null = unread
  createdAt      DateTime  @default(now())

  @@index([driverId, createdAt])
  @@index([companyId, createdAt])
  @@map("driver_chat_messages")
}


// ─── Returns Management ────────────────────────────────────────────────────
// Full RMA lifecycle: a customer/agent logs a return against an original
// waybill (or ad-hoc), it gets triaged + approved, a driver collects it, it's
// received and inspected at the warehouse, then resolved (refund / replace /
// restock / dispose). Mirrors the courier-industry returns workflow that
// incumbents like Parcel Perfect ship, with COD-aware refunds + restocking.

enum ReturnStatus {
  REQUESTED   // logged, awaiting triage/approval
  APPROVED    // approved for collection
  REJECTED    // return refused
  SCHEDULED   // collection booked / driver assigned
  IN_TRANSIT  // being returned to the warehouse
  RECEIVED    // physically back at the warehouse
  INSPECTING  // QA inspection in progress
  COMPLETED   // resolved (refund/replace/restock/dispose done)
  CANCELLED   // withdrawn by customer/agent
}

enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  MISSING_PARTS
  NO_LONGER_NEEDED
  FAILED_DELIVERY
  LATE_DELIVERY
  OTHER
}

enum ReturnResolution {
  PENDING
  REFUND
  REPLACEMENT
  REPAIR
  STORE_CREDIT
  RESTOCK
  DISPOSE
}

enum ReturnCondition {
  RESELLABLE
  MINOR_DAMAGE
  DAMAGED
  UNUSABLE
}

model Return {
  id        String @id @default(cuid())
  rmaNumber String // human-friendly return reference (e.g. RMA-2406-0007)

  // Link back to the original outbound waybill (optional — supports ad-hoc returns).
  // trackingNumber is denormalised so search/history survives if the waybill is gone.
  waybillId      String?
  waybill        Waybill? @relation(fields: [waybillId], references: [id])
  trackingNumber String?

  // Who is returning
  customerName  String
  customerPhone String?
  customerEmail String?
  pickupAddress String?
  pickupLat     Float?
  pickupLng     Float?

  reason     ReturnReason     @default(OTHER)
  reasonNote String?
  status     ReturnStatus     @default(REQUESTED)
  resolution ReturnResolution @default(PENDING)

  // Financials (COD-aware: a returned COD parcel may owe the customer a refund)
  refundAmount Float?
  restockFee   Float?
  currency     String @default("ZAR")

  // Logistics — reuse the existing driver fleet for collection
  assignedDriverId String?
  assignedDriver   Driver?   @relation(fields: [assignedDriverId], references: [id])
  scheduledAt      DateTime?
  collectedAt      DateTime?
  receivedAt       DateTime?

  // Inspection / QA
  inspectionNotes String?
  condition       ReturnCondition?
  restocked       Boolean          @default(false)

  // Audit trail
  approvedById String?
  approvedAt   DateTime?
  resolvedAt   DateTime?

  items ReturnItem[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rmaNumber, companyId])
  @@index([companyId])
  @@index([status])
  @@index([waybillId])
  @@map("returns")
}

model ReturnItem {
  id          String  @id @default(cuid())
  returnId    String
  return      Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  description String
  sku         String?
  quantity    Int     @default(1)
  unitValue   Float?
  condition   ReturnCondition?
  restocked   Boolean @default(false)

  @@index([returnId])
  @@map("return_items")
}


// ─── Accounting: Credit / Debit Notes, Statements, Sales Commission ─────────
// Adjustment documents and salesperson commission tracking that close the
// accounting-depth gap vs incumbents (credit/debit notes, age analysis,
// statements, Pastel/CSV export, sales commission).

enum CreditNoteStatus {
  DRAFT    // being prepared
  ISSUED   // finalised + numbered, owed back to the client
  APPLIED  // offset against an invoice / fully consumed
  VOID     // cancelled
}

enum DebitNoteStatus {
  DRAFT
  ISSUED
  SETTLED
  VOID
}

enum CommissionStatus {
  PENDING   // calculated, awaiting approval
  APPROVED  // approved for payout
  PAID      // paid out to the salesperson
  VOID
}

model CreditNote {
  id         String           @id @default(cuid())
  number     String           // CN-YYYY-#### per company
  status     CreditNoteStatus @default(DRAFT)

  clientName  String
  clientEmail String?

  // Optional link to the invoice this credit adjusts
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  reason   String?
  subtotal Float  @default(0)
  tax      Float  @default(0)
  total    Float  @default(0)
  // How much of `total` has been applied/offset so far
  appliedAmount Float @default(0)

  issuedAt  DateTime?
  appliedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items CreditNoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([number, companyId])
  @@index([companyId, status])
  @@index([companyId, clientName])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  description  String
  quantity     Int        @default(1)
  unitPrice    Float
  total        Float
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@map("credit_note_items")
}

model DebitNote {
  id         String          @id @default(cuid())
  number     String          // DN-YYYY-#### per company
  status     DebitNoteStatus @default(DRAFT)

  clientName  String
  clientEmail String?

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  reason   String?
  subtotal Float @default(0)
  tax      Float @default(0)
  total    Float @default(0)

  issuedAt  DateTime?
  settledAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items DebitNoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([number, companyId])
  @@index([companyId, status])
  @@index([companyId, clientName])
  @@map("debit_notes")
}

model DebitNoteItem {
  id          String    @id @default(cuid())
  description String
  quantity    Int       @default(1)
  unitPrice   Float
  total       Float
  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@map("debit_note_items")
}

model Salesperson {
  id                  String  @id @default(cuid())
  name                String
  email               String?
  // Default commission rate (percent of invoice value) used when generating
  // commission records. Can be overridden per generated record.
  defaultCommissionPct Float  @default(0)
  isActive            Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("salespeople")
}

model Commission {
  id            String           @id @default(cuid())
  salespersonId String
  salesperson   Salesperson      @relation(fields: [salespersonId], references: [id], onDelete: Cascade)

  // Source of the commissionable amount
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  periodMonth String           // YYYY-MM the commission belongs to
  baseAmount  Float            // commissionable base (e.g. invoice total ex-VAT)
  ratePct     Float            // percent applied
  amount      Float            // computed commission payout
  status      CommissionStatus @default(PENDING)
  note        String?

  approvedAt DateTime?
  paidAt     DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, periodMonth])
  @@index([salespersonId, status])
  @@map("commissions")
}


// ─── AI Accounting Bridge: two-way sync to Xero / Sage / Pastel ─────────────
// One unified connection per accounting provider, OAuth tokens, and a sync log
// per pushed document. The AI reconciliation layer reads these to flag
// mismatches, duplicates and unsynced paid invoices.

enum AccountingProvider {
  XERO
  SAGE
  PASTEL
}

enum AccountingConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

enum AccountingSyncDocType {
  INVOICE
  CREDIT_NOTE
}

enum AccountingSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

model AccountingConnection {
  id       String                     @id @default(cuid())
  provider AccountingProvider
  status   AccountingConnectionStatus @default(DISCONNECTED)

  // OAuth (Xero/Sage). Pastel is file-based and needs none.
  accessToken    String?   @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?

  // Provider org/tenant (Xero tenantId, Sage business id)
  externalTenantId   String?
  externalTenantName String?

  // Account-code mapping + options (AR account, sales account, VAT type…)
  settings Json?

  lastSyncAt DateTime?
  lastError  String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  syncLogs AccountingSyncLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider])
  @@index([companyId])
  @@map("accounting_connections")
}

model AccountingSyncLog {
  id           String                @id @default(cuid())
  connectionId String
  connection   AccountingConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  docType        AccountingSyncDocType
  documentId     String // FlowOps invoice / credit-note id
  documentNumber String?
  externalId     String? // id in Xero/Sage after push
  status         AccountingSyncStatus  @default(PENDING)
  amount         Float?
  direction      String                @default("PUSH") // PUSH | PULL
  error          String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([connectionId])
  @@index([documentId])
  @@map("accounting_sync_logs")
}


// ─── Enterprise SSO (OIDC) ──────────────────────────────────────────────────
// Per-tenant single sign-on via OpenID Connect (Okta, Azure AD, Google
// Workspace, Auth0, etc.). Gated to the Enterprise plan. Authorization-Code
// flow handled server-side; users are JIT-provisioned on first login.

model SsoConnection {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider String  @default("oidc") // oidc (covers Okta / Azure AD / Google / Auth0)
  enabled  Boolean @default(false)

  // OIDC endpoints + credentials
  issuer       String?
  clientId     String?
  clientSecret String? // NOTE: stored as-is; encrypt at rest before GA
  authUrl      String? // authorization endpoint
  tokenUrl     String? // token endpoint
  userInfoUrl  String? // userinfo endpoint (preferred for claims)
  scopes       String  @default("openid email profile")

  // JIT provisioning controls
  allowedDomain String? // only emails on this domain may sign in (e.g. acme.com)
  autoProvision Boolean @default(true)
  defaultRole   String  @default("AGENT")

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sso_connections")
}


// ─── CLAW Observatory (self-hosted error intelligence) ──────────────────────
// FlowOps-native, self-hosted error capture for backend 5xx + frontend JS
// errors. Identical errors are grouped by a stable fingerprint (count + first/
// last seen), CLAW AI triages each group (severity + summary + suggested fix),
// and the owner console surfaces them ranked. Complements the proactive
// Integration Sentinel and reactive Sentry — but owns the data (no third party).

model ErrorEvent {
  id          String  @id @default(cuid())
  fingerprint String  @unique // groups identical errors

  source  String  @default("backend") // backend | frontend
  level   String  @default("error")   // error | warning
  message String  @db.Text
  stack   String? @db.Text

  // Where it happened
  path    String? // request path or page URL
  method  String?

  // Occurrence tracking
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  // Lifecycle
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  // CLAW AI triage (best-effort, populated async)
  aiSeverity   String? // LOW | MEDIUM | HIGH | CRITICAL
  aiSummary    String? @db.Text
  aiSuggestion String? @db.Text
  aiTriagedAt  DateTime?

  // Latest-occurrence context + optional tenant/user association
  context   Json?
  companyId String?
  userId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resolved, lastSeenAt])
  @@index([source, level])
  @@map("error_events")
}


enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Raised when the AI Support Agent can't fully resolve a query (or the user
// asks to escalate). Keeps an audit trail + the conversation that led to it so
// nothing falls through the cracks.
model SupportTicket {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subject      String
  message      String              @db.Text
  status       SupportTicketStatus @default(OPEN)
  priority     String              @default("normal") // low | normal | high
  category     String? // AI-classified topic (billing, drivers, waybills, …)
  raisedById   String?
  raisedByName String?
  transcript   Json? // the agent conversation that led to escalation
  aiSummary    String?             @db.Text
  resolution   String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([companyId, status])
  @@map("support_tickets")
}


enum CourierOrderStatus {
  NEW
  ASSIGNED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum CourierOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Client-submitted delivery order in the Courier Management Suite. Distinct from
// a Waybill (the formal parcel record): an order is the intake/work item that
// the AI delivery-orchestration engine assigns + sequences across drivers.
// assignedDriverId is a plain column (no FK relation) to keep the Driver model
// untouched; driver details are resolved on read.
model CourierOrder {
  id               String               @id @default(cuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference        String
  clientName       String
  clientId         String?
  pickupAddress    String
  dropoffAddress   String
  contactName      String?
  contactPhone     String?
  itemsDesc        String?
  pieces           Int                  @default(1)
  weightKg         Float?
  priority         CourierOrderPriority @default(NORMAL)
  windowStart      DateTime?
  windowEnd        DateTime?
  status           CourierOrderStatus   @default(NEW)
  assignedDriverId String?
  sequence         Int?
  aiReasoning      String?              @db.Text
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([companyId, status])
  @@map("courier_orders")
}
