// ─── Invoices ─────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)

  clientName  String
  clientEmail String?

  subtotal Float @default(0)
  tax      Float @default(0)
  total    Float @default(0)

  dueDate DateTime?
  paidAt  DateTime?
  sentAt  DateTime?

  notes String?

  // Unguessable token for the unauthenticated public/portal invoice view.
  // Without this, the public view was an IDOR (any invoice readable by id).
  // Generated lazily the first time a share link is requested.
  // NOT @unique: adding a unique constraint on an existing table blocks
  // `prisma db push` (it can't prove no duplicates), and uniqueness is
  // unnecessary here — the token is a random UUID and the public lookup
  // already matches on BOTH id AND token. A plain index keeps lookups fast.
  publicToken String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  commissions Commission[]
  disbursements Disbursement[]

  @@unique([invoiceNumber, companyId])
  @@unique([id, companyId])
  @@index([publicToken])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // A waybill may appear on at most one invoice. Credit/debit notes handle later adjustments.
  waybillId String? @unique
  waybill   Waybill? @relation(fields: [waybillId], references: [id])

  @@map("invoice_items")
}

model InvoiceDraft {
  id    String  @id @default(cuid())
  title String?

  // Flexible JSON for AI-assisted drafting
  draftData  Json?
  aiAnalysis Json?

  finalized   Boolean   @default(false)
  finalizedAt DateTime?
  invoiceId   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_drafts")
}

