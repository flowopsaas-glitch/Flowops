  updatedAt DateTime @updatedAt

  @@map("shipments")
}

// ─── Manifests ────────────────────────────────────────────────────────────

model Manifest {
  id   String @id @default(cuid())
  code String

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  dispatched   Boolean   @default(false)
  dispatchedAt DateTime?
  pdfKey       String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waybills ManifestWaybill[]

  @@map("manifests")
}

model ManifestWaybill {
  manifestId String
  manifest   Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  waybillId String
  waybill   Waybill  @relation(fields: [waybillId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@id([manifestId, waybillId])
  @@map("manifest_waybills")
}

// ─── Invoices ─────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)

  clientName  String
  clientEmail String?

  subtotal Float @default(0)
  tax      Float @default(0)
  total    Float @default(0)

  dueDate DateTime?
  paidAt  DateTime?
  sentAt  DateTime?

  notes String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  commissions Commission[]

  @@unique([invoiceNumber, companyId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  waybillId String?
  waybill   Waybill? @relation(fields: [waybillId], references: [id])

  @@map("invoice_items")
}

model InvoiceDraft {
  id    String  @id @default(cuid())
  title String?

  // Flexible JSON for AI-assisted drafting
  draftData  Json?
  aiAnalysis Json?

  finalized   Boolean   @default(false)
  finalizedAt DateTime?
  invoiceId   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_drafts")
}

// ─── Rate Cards & Quotes ──────────────────────────────────────────────────

model RateCard {
  id         String  @id @default(cuid())
  name       String
  fromZone   String?
  toZone     String?
  minWeight  Float?
  maxWeight  Float?
  basePrice  Float
  pricePerKg Float   @default(0)
  currency   String  @default("ZAR")  // ISO 4217 (ZAR, USD, EUR, GBP, etc.)
  isActive   Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rate_cards")
}

model Quote {
  id          String  @id @default(cuid())
  fromAddress String
  toAddress   String
  clientName  String?   // optional — who the quote is for
  weight      Float
  price       Float
  currency    String  @default("ZAR")  // ISO 4217
  breakdown   Json?
  accepted    Boolean   @default(false)
  expiresAt   DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("quotes")
}

// ─── Notifications ────────────────────────────────────────────────────────

model Notification {
  id    String  @id @default(cuid())
  title String
  body  String
  type  String  @default("info")
  read  Boolean @default(false)
  readAt DateTime?
  link  String?

  // null = broadcast to whole company
  userId String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId, type, createdAt])
  @@index([companyId, createdAt])
  @@map("notifications")
}

// ─── WhatsApp ─────────────────────────────────────────────────────────────

model WhatsAppThread {
  id            String    @id @default(cuid())
  phone         String
  name          String?
  lastMessage   String?
  lastMessageAt DateTime?
  unreadCount   Int       @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages WhatsAppMessage[]

  @@unique([phone, companyId])
  @@map("whatsapp_threads")
}

model WhatsAppMessage {
  id        String           @id @default(cuid())
  content   String
  direction MessageDirection

  // Meta WABA tracking
  wabaMessageId String?
  // sent | delivered | read | failed
  status        String  @default("sent")

  mediaUrl  String?
  mediaType String?

  threadId String
  thread   WhatsAppThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  sentAt DateTime @default(now())

  @@map("whatsapp_messages")
}

// ─── Payments (Paystack) ──────────────────────────────────────────────────

model Payment {
  id        String        @id @default(cuid())
  reference String        @unique
  status    PaymentStatus @default(PENDING)
  amount    Float
  currency  String        @default("ZAR")
  description String?

  paystackReference String?
  paystackChannel   String?

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  customerEmail String?
  customerName  String?

  paidAt DateTime?

  // Full webhook payload kept for audit trail
  webhookPayload Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

// ─── Booking Portal ───────────────────────────────────────────────────────

model BookingPortalLink {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  label     String?
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  requests BookingRequest[]

  @@map("booking_portal_links")
}

model BookingRequest {
  id     String @id @default(cuid())
  status String @default("pending")

  senderName       String
  senderPhone      String
  senderAddress    String
  recipientName    String
  recipientPhone   String
  recipientAddress String
  notes            String?

  linkId String
  link   BookingPortalLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("booking_requests")
}

// ─── AI & Email Hub ───────────────────────────────────────────────────────

model AiEvent {
  id       String @id @default(cuid())
  type     String
  title    String
  body     String
  severity String @default("info")

  resolved   Boolean   @default(false)
  dismissed  Boolean   @default(false)
  resolvedAt DateTime?

  sourceType String?
  sourceId   String?
  metadata   Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("ai_events")
}

model EmailHubItem {
  id       String  @id @default(cuid())
  subject  String
  from     String
  to       String
  body     String? @db.Text
  read     Boolean @default(false)
  resolved Boolean @default(false)
  category String?

  // ── Triage / classification (matches frontend contract) ──
  type      String @default("GENERAL") // COLLECTION_REQUEST|POD|QUOTE|FEEDBACK|NOTIFICATION|AI_MONITOR|GENERAL
  status    String @default("NEW") // NEW|TRIAGED|IN_PROGRESS|WAITING|RESOLVED|ARCHIVED
  priority  String @default("MEDIUM") // LOW|MEDIUM|HIGH|CRITICAL
  direction String @default("INBOUND") // INBOUND|OUTBOUND

  senderName     String?
  senderEmail    String?
  recipientEmail String?

  waybillNumber String?
  podNumber     String?

  // ── AI monitoring ──
  aiSummary         String? @db.Text
  aiConfidence      Float?
  aiCategory        String?
  aiSuggestedAction String?
  opsNote           String? @db.Text

  isRead         Boolean  @default(false)
  needsOpsAction Boolean  @default(false)
  receivedAt     DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  attachments EmailAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("email_hub_items")
}

model EmailAttachment {
  id             String       @id @default(cuid())
  emailHubItemId String
  emailHubItem   EmailHubItem @relation(fields: [emailHubItemId], references: [id], onDelete: Cascade)

  filename String
  mimeType String?
  size     Int     @default(0)
  fileKey  String? // object key in Cloudflare R2
  fileUrl  String? // resolved (signed/public) URL

  // ── AI threat scan ──
  scanStatus   String    @default("PENDING") // PENDING|CLEAN|THREAT|SKIPPED|ERROR
  threatLevel  String    @default("NONE") // NONE|LOW|MEDIUM|HIGH|CRITICAL
  threatReason String?
  scanEngine   String? // heuristic | clamav | virustotal
  scannedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([emailHubItemId])
  @@map("email_attachments")
}

// ─── Leads ────────────────────────────────────────────────────────────────

model Lead {
  id    String  @id @default(cuid())
  email String
  notes String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("leads")
}

// ─── Workflows ────────────────────────────────────────────────────────────

model Workflow {
  id       String  @id @default(cuid())
  name     String
  script   String  @db.Text
  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  databases WorkflowDatabase[]

  @@map("workflows")
}

model WorkflowDatabase {
  id         String   @id @default(cuid())
  name       String
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  columns    Json
  rows       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workflow_databases")
}



// ── Platform audit trail ───────────────────────────────────────────────────
// Immutable record of privileged owner/platform actions: tenant approve/reject/
// suspend, plan changes, and "view-as-tenant" impersonation. Surfaced in the
// owner console for compliance + accountability.
model AuditLog {
  id         String   @id @default(cuid())
  actorType  String   @default("owner") // owner | tenant | system
  actorId    String?
  actorEmail String?
  action     String // e.g. tenant.approve, tenant.suspend, tenant.plan_change, tenant.impersonate
  targetType String? // company | user | request
  targetId   String?
  targetName String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@map("audit_logs")
}



// ── MRR history (true revenue movement) ────────────────────────────────────
// A daily point-in-time snapshot of platform MRR plus a per-tenant price map,
// so the owner console can compute real MRR movement (new / expansion /
// contraction / churn) by diffing consecutive snapshots — instead of the
// window approximation used before.
model MrrSnapshot {
  id            String   @id @default(cuid())
  date          DateTime @unique // midnight of the snapshot day
  mrr           Float
  activeTenants Int
  payingTenants Int
  perTenant     Json // { [companyId]: monthlyPrice }
  createdAt     DateTime @default(now())

  @@index([date])
  @@map("mrr_snapshots")
}



// ── Platform alerts (owner alerting engine) ────────────────────────────────
// Generated by the alerting cron when churn, SLA-exception spikes, or payment
// failures are detected. `dedupeKey` makes generation idempotent so the owner
// is notified once per condition rather than on every cron tick.
model PlatformAlert {
  id         String    @id @default(cuid())
  type       String // churn | sla_spike | payment_failure
  severity   String    @default("warning") // info | warning | critical
  title      String
  message    String
  tenantId   String?
  tenantName String?
  metadata   Json?
  dedupeKey  String    @unique
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolved])
  @@index([createdAt])
  @@map("platform_alerts")
}


// ─── COD Reconciliation ────────────────────────────────────────────────────

model DriverWallet {
  id             String    @id @default(cuid())
  driverId       String    @unique
  balance        Float     @default(0)
  totalCollected Float     @default(0)
  totalSettled   Float     @default(0)
  lastSettledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver       Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  transactions CodTransaction[]

  @@map("driver_wallets")
}

model CodTransaction {
  id        String             @id @default(cuid())
  walletId  String
  waybillId String?
  companyId String
  type      CodTransactionType
  amount    Float
  balance   Float              // running balance after this entry
  note      String?

  createdAt DateTime @default(now())

  wallet  DriverWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  waybill Waybill?    @relation(fields: [waybillId], references: [id])
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("cod_transactions")
}

enum CodTransactionType {
  COLLECTION   // driver collected cash from a recipient
  SETTLEMENT   // driver remitted cash to the company
  ADJUSTMENT   // manual balance correction
}

// ─── Webhook Delivery Log ──────────────────────────────────────────────────

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  event          String
  payload        String                // JSON-serialised event body
  status         WebhookDeliveryStatus @default(PENDING)
  responseStatus Int?
  responseBody   String?
  attempts       Int                   @default(0)
  nextRetryAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
  EXHAUSTED
}


// ─── Vehicle / Fleet Maintenance ──────────────────────────────────────────

model VehicleService {
  id          String   @id @default(cuid())
  driverId    String
  serviceType String   // e.g. "Oil Change", "Tyre Rotation", "Annual Service"
  notes       String?
  kmAtService Int?
  cost        Float?
  currency    String   @default("ZAR")
  servicedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  // AI predictive maintenance
  aiPredictedNextKm   Int?       // AI-predicted next service mileage
  aiPredictedNextDate DateTime?  // AI-predicted next service date
  aiConfidence        Float?     // 0.0–1.0 confidence score
  aiRiskLevel         String?    // LOW | MEDIUM | HIGH | CRITICAL
  aiNotes             String?    // AI-generated maintenance advice

  // Service provider
  providerName    String?  // workshop/mechanic name
  invoiceRef      String?  // workshop invoice reference
  partsReplaced   String?  // comma-separated parts list
  warrantyExpiry  DateTime?

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, servicedAt])
  @@map("vehicle_services")
}


// ─── Client Directory ─────────────────────────────────────────────────────
// Proper client records with billing types — separate from the waybill-derived
// read-only directory. COD, prepaid, and contract clients each have different
// defaults (COD amount policy, credit limit, or contract terms).

enum ClientBillingType {
  COD        // Cash on delivery — driver collects per waybill
  PREPAID    // Client pays before dispatch
  CONTRACT   // Monthly invoiced account with credit terms
  CASH       // Walk-in / once-off cash payer
}

model Client {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Identity
  name          String
  tradingName   String?
  phone         String?
  email         String?
  address       String?

  // Billing
  billingType   ClientBillingType @default(COD)
  creditLimit   Float?            // for CONTRACT clients
  paymentTerms  Int?              // days — e.g. 30 for net-30
  vatNumber     String?
  accountCode   String?

  // Contract
  contractStart DateTime?
  contractEnd   DateTime?
  notes         String?

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, billingType])
  @@index([companyId, name])
  @@map("clients")
}


// ── Driver ↔ Dispatch real-time chat ─────────────────────────────────────────

model DriverChatMessage {
  id             String    @id @default(cuid())
  driverId       String
  driver         Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company   @relation("CompanyDriverChats", fields: [companyId], references: [id], onDelete: Cascade)
  /// 'driver' | 'dispatch'
  senderType     String
  message        String
  attachmentUrl  String?
  attachmentType String?   // 'image' | 'document'
  readAt         DateTime? // null = unread
  createdAt      DateTime  @default(now())

  @@index([driverId, createdAt])
  @@index([companyId, createdAt])
  @@map("driver_chat_messages")
}


// ─── Returns Management ────────────────────────────────────────────────────
// Full RMA lifecycle: a customer/agent logs a return against an original
// waybill (or ad-hoc), it gets triaged + approved, a driver collects it, it's
// received and inspected at the warehouse, then resolved (refund / replace /
// restock / dispose). Mirrors the courier-industry returns workflow that
// incumbents like Parcel Perfect ship, with COD-aware refunds + restocking.

enum ReturnStatus {
  REQUESTED   // logged, awaiting triage/approval
  APPROVED    // approved for collection
  REJECTED    // return refused
  SCHEDULED   // collection booked / driver assigned
  IN_TRANSIT  // being returned to the warehouse
  RECEIVED    // physically back at the warehouse
  INSPECTING  // QA inspection in progress
  COMPLETED   // resolved (refund/replace/restock/dispose done)
  CANCELLED   // withdrawn by customer/agent
}

enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  MISSING_PARTS
  NO_LONGER_NEEDED
  FAILED_DELIVERY
  LATE_DELIVERY
  OTHER
}

enum ReturnResolution {
  PENDING
  REFUND
  REPLACEMENT
  REPAIR
  STORE_CREDIT
  RESTOCK
  DISPOSE
}

enum ReturnCondition {
  RESELLABLE
  MINOR_DAMAGE
  DAMAGED
  UNUSABLE
}

model Return {
  id        String @id @default(cuid())
  rmaNumber String // human-friendly return reference (e.g. RMA-2406-0007)

  // Link back to the original outbound waybill (optional — supports ad-hoc returns).
  // trackingNumber is denormalised so search/history survives if the waybill is gone.
  waybillId      String?
  waybill        Waybill? @relation(fields: [waybillId], references: [id])
  trackingNumber String?

  // Who is returning
  customerName  String
  customerPhone String?
  customerEmail String?
  pickupAddress String?
  pickupLat     Float?
  pickupLng     Float?

  reason     ReturnReason     @default(OTHER)
  reasonNote String?
  status     ReturnStatus     @default(REQUESTED)
  resolution ReturnResolution @default(PENDING)

  // Financials (COD-aware: a returned COD parcel may owe the customer a refund)
  refundAmount Float?
  restockFee   Float?
  currency     String @default("ZAR")

  // Logistics — reuse the existing driver fleet for collection
  assignedDriverId String?
  assignedDriver   Driver?   @relation(fields: [assignedDriverId], references: [id])
  scheduledAt      DateTime?
  collectedAt      DateTime?
  receivedAt       DateTime?

  // Inspection / QA
  inspectionNotes String?
  condition       ReturnCondition?
  restocked       Boolean          @default(false)

  // Audit trail
  approvedById String?
  approvedAt   DateTime?
  resolvedAt   DateTime?

  items ReturnItem[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rmaNumber, companyId])
  @@index([companyId])
  @@index([status])
  @@index([waybillId])
  @@map("returns")
}

model ReturnItem {
  id          String  @id @default(cuid())
  returnId    String
  return      Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  description String
  sku         String?
  quantity    Int     @default(1)
  unitValue   Float?
  condition   ReturnCondition?
  restocked   Boolean @default(false)

  @@index([returnId])
  @@map("return_items")
}


// ─── Accounting: Credit / Debit Notes, Statements, Sales Commission ─────────
// Adjustment documents and salesperson commission tracking that close the
// accounting-depth gap vs incumbents (credit/debit notes, age analysis,
// statements, Pastel/CSV export, sales commission).

enum CreditNoteStatus {
  DRAFT    // being prepared
  ISSUED   // finalised + numbered, owed back to the client
  APPLIED  // offset against an invoice / fully consumed
  VOID     // cancelled
}

enum DebitNoteStatus {
  DRAFT
  ISSUED
  SETTLED
  VOID
}

enum CommissionStatus {
  PENDING   // calculated, awaiting approval
  APPROVED  // approved for payout
  PAID      // paid out to the salesperson
  VOID
}

model CreditNote {
  id         String           @id @default(cuid())
  number     String           // CN-YYYY-#### per company
  status     CreditNoteStatus @default(DRAFT)

  clientName  String
  clientEmail String?

  // Optional link to the invoice this credit adjusts
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  reason   String?
  subtotal Float  @default(0)
  tax      Float  @default(0)
  total    Float  @default(0)
  // How much of `total` has been applied/offset so far
  appliedAmount Float @default(0)

  issuedAt  DateTime?
  appliedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items CreditNoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([number, companyId])
  @@index([companyId, status])
  @@index([companyId, clientName])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  description  String
  quantity     Int        @default(1)
  unitPrice    Float
  total        Float
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@map("credit_note_items")
}

model DebitNote {
  id         String          @id @default(cuid())
  number     String          // DN-YYYY-#### per company
  status     DebitNoteStatus @default(DRAFT)

  clientName  String
  clientEmail String?

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  reason   String?
  subtotal Float @default(0)
  tax      Float @default(0)
  total    Float @default(0)

  issuedAt  DateTime?
  settledAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items DebitNoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([number, companyId])
  @@index([companyId, status])
  @@index([companyId, clientName])
  @@map("debit_notes")
}

model DebitNoteItem {
  id          String    @id @default(cuid())
  description String
  quantity    Int       @default(1)
  unitPrice   Float
  total       Float
  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@map("debit_note_items")
}

model Salesperson {
  id                  String  @id @default(cuid())
  name                String
  email               String?
  // Default commission rate (percent of invoice value) used when generating
  // commission records. Can be overridden per generated record.
  defaultCommissionPct Float  @default(0)
  isActive            Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("salespeople")
}

model Commission {
  id            String           @id @default(cuid())
  salespersonId String
  salesperson   Salesperson      @relation(fields: [salespersonId], references: [id], onDelete: Cascade)

  // Source of the commissionable amount
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  periodMonth String           // YYYY-MM the commission belongs to
  baseAmount  Float            // commissionable base (e.g. invoice total ex-VAT)
  ratePct     Float            // percent applied
  amount      Float            // computed commission payout
  status      CommissionStatus @default(PENDING)
  note        String?

  approvedAt DateTime?
  paidAt     DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, periodMonth])
  @@index([salespersonId, status])
  @@map("commissions")
}


// ─── AI Accounting Bridge: two-way sync to Xero / Sage / Pastel ─────────────
// One unified connection per accounting provider, OAuth tokens, and a sync log
// per pushed document. The AI reconciliation layer reads these to flag
// mismatches, duplicates and unsynced paid invoices.

enum AccountingProvider {
  XERO
  SAGE
  PASTEL
}

enum AccountingConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

enum AccountingSyncDocType {
  INVOICE
  CREDIT_NOTE
}

enum AccountingSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

model AccountingConnection {
  id       String                     @id @default(cuid())
  provider AccountingProvider
  status   AccountingConnectionStatus @default(DISCONNECTED)

  // OAuth (Xero/Sage). Pastel is file-based and needs none.
  accessToken    String?   @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?

  // Provider org/tenant (Xero tenantId, Sage business id)
  externalTenantId   String?
  externalTenantName String?

  // Account-code mapping + options (AR account, sales account, VAT type…)
  settings Json?

  lastSyncAt DateTime?
  lastError  String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  syncLogs AccountingSyncLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider])
  @@index([companyId])
  @@map("accounting_connections")
}

model AccountingSyncLog {
  id           String                @id @default(cuid())
  connectionId String
  connection   AccountingConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  docType        AccountingSyncDocType
  documentId     String // FlowOps invoice / credit-note id
  documentNumber String?
  externalId     String? // id in Xero/Sage after push
  status         AccountingSyncStatus  @default(PENDING)
  amount         Float?
  direction      String                @default("PUSH") // PUSH | PULL
  error          String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([connectionId])
  @@index([documentId])
  @@map("accounting_sync_logs")
}


// ─── Enterprise SSO (OIDC) ──────────────────────────────────────────────────
// Per-tenant single sign-on via OpenID Connect (Okta, Azure AD, Google
// Workspace, Auth0, etc.). Gated to the Enterprise plan. Authorization-Code
// flow handled server-side; users are JIT-provisioned on first login.

model SsoConnection {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider String  @default("oidc") // oidc (covers Okta / Azure AD / Google / Auth0)
  enabled  Boolean @default(false)

  // OIDC endpoints + credentials
  issuer       String?
  clientId     String?
  clientSecret String? // NOTE: stored as-is; encrypt at rest before GA
  authUrl      String? // authorization endpoint
  tokenUrl     String? // token endpoint
  userInfoUrl  String? // userinfo endpoint (preferred for claims)
  scopes       String  @default("openid email profile")

  // JIT provisioning controls
  allowedDomain String? // only emails on this domain may sign in (e.g. acme.com)
  autoProvision Boolean @default(true)
  defaultRole   String  @default("AGENT")

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sso_connections")
}


// ─── CLAW Observatory (self-hosted error intelligence) ──────────────────────
// FlowOps-native, self-hosted error capture for backend 5xx + frontend JS
// errors. Identical errors are grouped by a stable fingerprint (count + first/
// last seen), CLAW AI triages each group (severity + summary + suggested fix),
// and the owner console surfaces them ranked. Complements the proactive
// Integration Sentinel and reactive Sentry — but owns the data (no third party).

model ErrorEvent {
  id          String  @id @default(cuid())
  fingerprint String  @unique // groups identical errors

  source  String  @default("backend") // backend | frontend
  level   String  @default("error")   // error | warning
  message String  @db.Text
  stack   String? @db.Text

  // Where it happened
  path    String? // request path or page URL
  method  String?

  // Occurrence tracking
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  // Lifecycle
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  // CLAW AI triage (best-effort, populated async)
  aiSeverity   String? // LOW | MEDIUM | HIGH | CRITICAL
  aiSummary    String? @db.Text
  aiSuggestion String? @db.Text
  aiTriagedAt  DateTime?

  // Latest-occurrence context + optional tenant/user association
  context   Json?
  companyId String?
  userId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resolved, lastSeenAt])
  @@index([source, level])
  @@map("error_events")
}


enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Raised when the AI Support Agent can't fully resolve a query (or the user
// asks to escalate). Keeps an audit trail + the conversation that led to it so
// nothing falls through the cracks.
model SupportTicket {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subject      String
  message      String              @db.Text
  status       SupportTicketStatus @default(OPEN)
  priority     String              @default("normal") // low | normal | high
  category     String? // AI-classified topic (billing, drivers, waybills, …)
  raisedById   String?
  raisedByName String?
  transcript   Json? // the agent conversation that led to escalation
  aiSummary    String?             @db.Text
  resolution   String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([companyId, status])
  @@map("support_tickets")
}


enum CourierOrderStatus {
  NEW
  ASSIGNED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum CourierOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Client-submitted delivery order in the Courier Management Suite. Distinct from
// a Waybill (the formal parcel record): an order is the intake/work item that
// the AI delivery-orchestration engine assigns + sequences across drivers.
// assignedDriverId is a plain column (no FK relation) to keep the Driver model
// untouched; driver details are resolved on read.
model CourierOrder {
  id               String               @id @default(cuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference        String
  clientName       String
  clientId         String?
  pickupAddress    String
  dropoffAddress   String
  contactName      String?
  contactPhone     String?
  itemsDesc        String?
  pieces           Int                  @default(1)
  weightKg         Float?
  priority         CourierOrderPriority @default(NORMAL)
  windowStart      DateTime?
  windowEnd        DateTime?
  status           CourierOrderStatus   @default(NEW)
  assignedDriverId String?
  sequence         Int?
  aiReasoning      String?              @db.Text
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([companyId, status])
  @@map("courier_orders")
}



// ═══════════════════════════════════════════════════════════════════════════════
// ─── WAREHOUSE MANAGEMENT SYSTEM (WMS) ───────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
// World-class WMS: zone/bin hierarchy, inventory tracking, goods receipt,
// put-away, pick/pack, cycle count, stock movements, dock scheduling, and
// AI-powered warehouse analytics. Designed for 3PL operations at scale.

enum WarehouseZoneType {
  RECEIVING    // Inbound dock / goods-in area
  BULK         // Long-term / pallet storage
  PICK         // Active pick face
  PACKING      // Pack & label station
  DISPATCH     // Outbound staging / dock
  RETURNS      // RMA inspection & processing
  COLD         // Temperature-controlled
  HAZMAT       // Dangerous goods (ADR/SANS)
  QUARANTINE   // Held stock (damaged/pending QA)
  CROSSDOCK    // Pass-through (no storage)
}

enum StockMovementType {
  RECEIPT      // Goods received from supplier/transfer
  PUT_AWAY     // Moved from receiving to storage bin
  PICK         // Picked for an order
  PACK         // Packed into shipment
  TRANSFER     // Moved between bins
  ADJUSTMENT   // Manual correction (write-off, found, damage)
  RETURN_IN    // Returned goods received
  DISPATCH     // Shipped out
  CYCLE_COUNT  // Adjustment from count variance
  REPLENISH    // Moved from bulk to pick face
}

enum PickOrderStatus {
  PENDING      // Created, not yet assigned
  ASSIGNED     // Picker allocated
  IN_PROGRESS  // Picking started
  PICKED       // All items picked
  PACKED       // Packed and ready for dispatch
  DISPATCHED   // Handed to driver / shipped
  CANCELLED    // Order cancelled
}

enum GoodsReceiptStatus {
  EXPECTED     // ASN received, goods not yet arrived
  ARRIVED      // Vehicle at dock, unloading
  INSPECTING   // QA check in progress
  COMPLETED    // Received & put away
  REJECTED     // Failed inspection, returned to sender
}

enum CycleCountStatus {
  SCHEDULED    // Planned but not started
  IN_PROGRESS  // Counters actively counting
  COMPLETED    // Count finished, variances recorded
  APPROVED     // Variances approved and adjustments posted
}

// ── Warehouse (physical site) ────────────────────────────────────────────────
// Extends the existing Branch model with warehouse-specific attributes.
// A company can have multiple warehouses; each has zones → bins.
model Warehouse {
  id        String @id @default(cuid())
  companyId String
  branchId  String? // Optional link to existing Branch

  name           String
  code           String? // Short code (e.g. "JHB-01", "CPT-MAIN")
  address        String?
  city           String?
  lat            Float?
  lng            Float?

  // Capacity
  totalAreaSqm      Float?
  usableAreaSqm     Float?
  totalBinLocations Int    @default(0)
  maxPalletCapacity Int?

  // Operations config
  operatingHoursStart String? // "06:00"
  operatingHoursEnd   String? // "22:00"
  timezone            String  @default("Africa/Johannesburg")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones          WarehouseZone[]
  goodsReceipts  GoodsReceipt[]
  pickOrders     PickOrder[]
  cycleCounts    CycleCount[]
  dockSlots      DockSlot[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

// ── Zone (logical area within a warehouse) ───────────────────────────────────
model WarehouseZone {
  id          String        @id @default(cuid())
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  name        String        // "Zone A - Bulk Storage"
  code        String        // "A", "PICK-1", "COLD-01"
  type        WarehouseZoneType @default(BULK)

  // Physical
  areaSqm     Float?
  temperature Float?        // °C (for cold chain)
  maxWeight   Float?        // kg capacity

  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  binLocations BinLocation[]

  @@index([warehouseId])
  @@map("warehouse_zones")
}

// ── Bin Location (smallest addressable storage unit) ─────────────────────────
// Address format: ZONE-AISLE-RACK-LEVEL-POSITION (e.g. "A-01-03-02-001")
model BinLocation {
  id     String        @id @default(cuid())
  zoneId String
  zone   WarehouseZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  // Hierarchical address
  code       String   // Full address: "A-01-03-02-001"
  aisle      String?  // "01"
  rack       String?  // "03"
  level      String?  // "02" (shelf level)
  position   String?  // "001" (position on shelf)

  // Capacity & constraints
  maxWeightKg   Float?
  maxVolumeCbm  Float?
  widthCm       Float?
  heightCm      Float?
  depthCm       Float?
  binType       String  @default("SHELF") // SHELF | PALLET | FLOOR | TOTE | DRAWER

  // State
  isEmpty       Boolean @default(true)
  isBlocked     Boolean @default(false) // Temporarily unavailable
  blockReason   String?

  // Pick priority (lower = picked first for FIFO/FEFO)
  pickSequence  Int     @default(0)

  inventory     InventoryItem[]
  movements     StockMovement[]

  @@unique([zoneId, code])
  @@index([zoneId])
  @@map("bin_locations")
}

// ── Inventory Item (stock at a specific bin) ─────────────────────────────────
// Each row = one SKU in one bin. Multiple rows for same SKU across bins.
model InventoryItem {
  id        String @id @default(cuid())
  companyId String

  binId     String
  bin       BinLocation @relation(fields: [binId], references: [id], onDelete: Cascade)

  // Product identification
  sku           String        // Stock Keeping Unit
  barcode       String?       // EAN/UPC barcode
  description   String
  category      String?       // Product category

  // Quantities
  quantityOnHand    Int   @default(0) // Physical stock in this bin
  quantityAllocated Int   @default(0) // Reserved for pick orders
  quantityAvailable Int   @default(0) // onHand - allocated (computed)

  // Batch/lot tracking
  batchNumber   String?
  lotNumber     String?
  serialNumber  String?
  expiryDate    DateTime?     // For FEFO (First Expired First Out)
  manufacturedDate DateTime?

  // Value
  unitCost      Float?        // Cost per unit (for inventory valuation)
  currency      String @default("ZAR")

  // Physical
  weightKg      Float?
  volumeCbm     Float?

  // Replenishment
  reorderPoint    Int?        // Trigger replenishment when qty drops below
  reorderQuantity Int?        // How much to reorder/replenish
  maxQuantity     Int?        // Max stock for this bin

  // Status
  status    String @default("AVAILABLE") // AVAILABLE | ALLOCATED | HELD | DAMAGED | EXPIRED
  lastCountedAt DateTime?
  lastMovedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, sku])
  @@index([binId])
  @@index([companyId, status])
  @@index([expiryDate])
  @@map("inventory_items")
}

// ── Stock Movement (every movement creates an audit trail) ───────────────────
model StockMovement {
  id        String @id @default(cuid())
  companyId String

  type      StockMovementType
  sku       String
  quantity  Int               // Positive = in, Negative = out
  reference String?           // PO number, pick order, manifest code, etc.

  // Location
  fromBinId String?
  fromBin   BinLocation? @relation(fields: [fromBinId], references: [id])
  toBinId   String?

  // Context
  goodsReceiptId String?
  pickOrderId    String?
  cycleCountId   String?
  reason         String?       // For adjustments: "damaged", "found", "write-off"

  // Audit
  performedBy    String?       // User ID who executed
  performedAt    DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([companyId, sku])
  @@index([companyId, type])
  @@index([companyId, performedAt])
  @@map("stock_movements")
}

// ── Goods Receipt (inbound receiving workflow) ───────────────────────────────
model GoodsReceipt {
  id          String @id @default(cuid())
  companyId   String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  // Reference
  receiptNumber String          // "GR-2026-00001"
  poNumber      String?         // Purchase order reference
  supplierName  String?
  carrierName   String?

  status        GoodsReceiptStatus @default(EXPECTED)

  // Expected vs Actual
  expectedDate  DateTime?
  arrivedAt     DateTime?
  completedAt   DateTime?

  // Dock assignment
  dockSlotId    String?

  // Totals
  expectedLines   Int   @default(0)
  receivedLines   Int   @default(0)
  expectedQty     Int   @default(0)
  receivedQty     Int   @default(0)
  damagedQty      Int   @default(0)
  rejectedQty     Int   @default(0)

  // Notes
  notes           String? @db.Text
  inspectionNotes String? @db.Text

  // Audit
  receivedBy    String?
  completedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines GoodsReceiptLine[]

  @@unique([companyId, receiptNumber])
  @@index([companyId, status])
  @@index([warehouseId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String       @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  sku             String
  description     String?
  expectedQty     Int     @default(0)
  receivedQty     Int     @default(0)
  damagedQty      Int     @default(0)

  // Put-away
  putAwayBinId    String? // Where it was stored
  putAwayComplete Boolean @default(false)

  // Batch
  batchNumber     String?
  expiryDate      DateTime?
  unitCost        Float?

  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

// ── Pick Order (outbound fulfilment workflow) ─────────────────────────────────
model PickOrder {
  id          String @id @default(cuid())
  companyId   String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  orderNumber   String          // "PO-2026-00001"
  status        PickOrderStatus @default(PENDING)
  priority      Int     @default(0) // Higher = more urgent

  // Source (what triggered this pick)
  sourceType    String? // WAYBILL | MANIFEST | SALES_ORDER | TRANSFER
  sourceId      String? // waybillId, manifestId, etc.
  clientName    String?

  // Assignment
  assignedTo    String? // Picker user ID
  assignedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  packedAt      DateTime?
  dispatchedAt  DateTime?

  // Totals
  totalLines    Int   @default(0)
  pickedLines   Int   @default(0)
  totalQty      Int   @default(0)
  pickedQty     Int   @default(0)

  // Shipping
  shipToName    String?
  shipToAddress String?
  trackingNumber String? // Links back to waybill

  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PickOrderLine[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([warehouseId])
  @@index([assignedTo, status])
  @@map("pick_orders")
}

model PickOrderLine {
  id          String    @id @default(cuid())
  pickOrderId String
  pickOrder   PickOrder @relation(fields: [pickOrderId], references: [id], onDelete: Cascade)

  sku           String
  description   String?
  requestedQty  Int
  pickedQty     Int     @default(0)
  shortQty      Int     @default(0) // qty that couldn't be fulfilled

  // Directed pick: which bin to pick from
  suggestedBinId String?
  actualBinId    String?  // Where it was actually picked from

  // Status
  picked    Boolean @default(false)
  pickedAt  DateTime?
  pickedBy  String?

  @@index([pickOrderId])
  @@map("pick_order_lines")
}

// ── Cycle Count (inventory accuracy) ─────────────────────────────────────────
model CycleCount {
  id          String @id @default(cuid())
  companyId   String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  countNumber   String            // "CC-2026-00001"
  status        CycleCountStatus  @default(SCHEDULED)
  countType     String @default("FULL") // FULL | ABC | ZONE | SKU | RANDOM

  // Schedule
  scheduledDate DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  approvedAt    DateTime?
  approvedBy    String?

  // Scope
  zoneFilter    String?   // Only count specific zone(s)
  skuFilter     String?   // Only count specific SKU(s)
  abcClass      String?   // A | B | C (for ABC counting)

  // Results
  totalBins       Int @default(0)
  countedBins     Int @default(0)
  totalVariances  Int @default(0)
  varianceValue   Float @default(0) // ZAR value of discrepancies

  // Accuracy
  accuracyRate    Float? // % of bins with zero variance

  notes           String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines CycleCountLine[]

  @@unique([companyId, countNumber])
  @@index([companyId, status])
  @@map("cycle_counts")
}

model CycleCountLine {
  id           String     @id @default(cuid())
  cycleCountId String
  cycleCount   CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)

  binCode      String
  sku          String
  description  String?

  // Expected vs Actual
  systemQty    Int           // What the system says
  countedQty   Int?          // What was physically counted
  variance     Int?          // countedQty - systemQty

  // Resolution
  resolved     Boolean @default(false)
  adjustmentPosted Boolean @default(false)
  resolvedBy   String?
  resolvedAt   DateTime?
  notes        String?

  @@index([cycleCountId])
  @@map("cycle_count_lines")
}

// ── Dock Slot (inbound/outbound dock scheduling) ─────────────────────────────
model DockSlot {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  name        String    // "Dock 1", "Bay A"
  type        String    @default("BOTH") // INBOUND | OUTBOUND | BOTH
  isActive    Boolean   @default(true)

  appointments DockAppointment[]

  @@index([warehouseId])
  @@map("dock_slots")
}

model DockAppointment {
  id         String   @id @default(cuid())
  companyId  String
  dockSlotId String
  dockSlot   DockSlot @relation(fields: [dockSlotId], references: [id], onDelete: Cascade)

  // Scheduling
  type          String    // INBOUND | OUTBOUND
  scheduledStart DateTime
  scheduledEnd   DateTime
  actualArrival  DateTime?
  actualDepart   DateTime?

  // Reference
  carrierName    String?
  vehicleReg     String?
  reference      String?  // PO, manifest, GR number
  goodsReceiptId String?

  // Status
  status    String @default("SCHEDULED") // SCHEDULED | ARRIVED | IN_PROGRESS | COMPLETED | CANCELLED | NO_SHOW

  notes     String?

  createdAt DateTime @default(now())

  @@index([dockSlotId, scheduledStart])
  @@index([companyId, status])
  @@map("dock_appointments")
}


// ─── Commercial Analytics Suite ──────────────────────────────────────────────
// World-class pricing analysis, profitability metrics, client intelligence, and
// revenue forecasting. Powers strategic decision-making for logistics operators.

// Per-delivery cost model — enables true margin calculation per waybill.
// Costs are estimated from distance × per-km rate, driver hourly cost, and
// fixed overheads. Updated by the cost-allocation engine or set manually.
model DeliveryCostAllocation {
  id        String @id @default(cuid())
  companyId String
  waybillId String @unique
  period    String // YYYY-MM

  // Revenue (from waybill.totalAmount)
  revenue       Float @default(0)

  // Cost breakdown
  fuelCost      Float @default(0)
  labourCost    Float @default(0)  // driver time × hourly rate
  vehicleCost   Float @default(0)  // depreciation + maintenance allocation
  overheadCost  Float @default(0)  // warehousing, admin, insurance
  tollsCost     Float @default(0)
  totalCost     Float @default(0)

  // Derived
  grossMargin     Float @default(0) // revenue - totalCost
  marginPercent   Float @default(0) // (grossMargin / revenue) × 100

  // Route metadata (for lane analysis)
  fromZone     String?
  toZone       String?
  distanceKm   Float?
  driverId     String?
  clientName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, period])
  @@index([companyId, clientName])
  @@index([companyId, fromZone, toZone])
  @@map("delivery_cost_allocations")
}

// Periodic lane profitability snapshot (aggregated per zone-pair per month).
// Enables "which routes make money, which lose" analysis.
model LaneProfitability {
  id        String @id @default(cuid())
  companyId String
  period    String // YYYY-MM

  fromZone     String
  toZone       String

  // Volume
  totalDeliveries  Int   @default(0)
  successRate      Float @default(0)

  // Revenue
  totalRevenue     Float @default(0)
  avgRevenuePerDel Float @default(0)

  // Cost
  totalCost        Float @default(0)
  avgCostPerDel    Float @default(0)

  // Profitability
  grossProfit      Float @default(0)
  marginPercent    Float @default(0)

  // Trend (vs previous period)
  revenueDelta     Float? // % change from prior period
  volumeDelta      Float? // % change in deliveries
  marginDelta      Float? // absolute change in margin %

  // AI recommendation
  pricingSignal    String? // UNDERPRICED | OPTIMAL | OVERPRICED | LOW_VOLUME
  aiRecommendation String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, period, fromZone, toZone])
  @@index([companyId, period])
  @@map("lane_profitability")
}

// Client profitability scoring — per-client per-period commercial intelligence.
// Combines revenue, cost-to-serve, payment behaviour, and growth trajectory.
model ClientProfitability {
  id        String @id @default(cuid())
  companyId String
  period    String // YYYY-MM
  clientName String

  // Revenue metrics
  revenue          Float @default(0)
  revenueGrowthPct Float? // vs prior period
  deliveryCount    Int   @default(0)
  avgRevenuePerDel Float @default(0)

  // Cost metrics
  totalCost        Float @default(0)
  costToServePct   Float @default(0) // totalCost / revenue × 100

  // Profitability
  grossProfit      Float @default(0)
  marginPercent    Float @default(0)
  profitRank       Int?  // rank within company (1 = most profitable)

  // Payment behaviour
  avgDaysToPay     Float?
  collectionRate   Float @default(0)
  overdueAmount    Float @default(0)

  // Customer Lifetime Value
  clv              Float? // predicted 12-month future value
  clvTier          String? // PLATINUM | GOLD | SILVER | BRONZE | AT_RISK

  // Churn signals
  churnRisk        Float? // 0-100 probability
  churnSignals     Json?  // array of risk factors

  // Engagement
  monthsActive     Int   @default(0)
  lastDeliveryAt   DateTime?
  volumeTrend      String? // GROWING | STABLE | DECLINING | NEW | DORMANT

  // AI insights
  aiInsights       Json?
  aiGeneratedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, period, clientName])
  @@index([companyId, period])
  @@index([companyId, clientName])
  @@map("client_profitability")
}

// AI-generated pricing recommendations — stored per lane/client for review.
model PricingRecommendation {
  id        String @id @default(cuid())
  companyId String
  type      String // LANE | CLIENT | RATE_CARD | GENERAL

  // What it applies to
  fromZone    String?
  toZone      String?
  clientName  String?
  rateCardId  String?

  // Current state
  currentPrice    Float?
  currentMargin   Float?
  currentVolume   Int?

  // Recommendation
  recommendedPrice  Float?
  expectedMargin    Float?
  expectedImpact    String? @db.Text // "Increase revenue by ~R12,000/month"
  confidence        Float?  // 0-100

  // Reasoning
  reasoning     String? @db.Text
  dataPoints    Json?   // supporting evidence
  signal        String  // INCREASE | DECREASE | HOLD | REVIEW

  // Lifecycle
  status     String @default("PENDING") // PENDING | ACCEPTED | REJECTED | EXPIRED
  reviewedAt DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([companyId, status])
  @@index([companyId, type])
  @@map("pricing_recommendations")
}

// Revenue forecast snapshots — ML-predicted future revenue with confidence bands.
model RevenueForecast {
  id        String @id @default(cuid())
  companyId String
  generatedAt DateTime @default(now())

  // Forecast horizon
  forecastPeriod  String // YYYY-MM (the month being predicted)
  forecastType    String @default("MONTHLY") // MONTHLY | QUARTERLY

  // Prediction
  predictedRevenue   Float
  lowerBound         Float  // 80% confidence interval
  upperBound         Float
  confidence         Float  // 0-100

  // Basis
  historicalAvg      Float?
  trend              Float? // monthly growth rate used
  seasonalFactor     Float? // seasonal multiplier applied
  pipelineValue      Float? // value of accepted quotes not yet invoiced

  // Comparison (filled after period ends)
  actualRevenue      Float?
  accuracy           Float? // |actual - predicted| / actual × 100

  @@unique([companyId, forecastPeriod, forecastType])
  @@index([companyId])
  @@map("revenue_forecasts")
}

// Commercial analytics configuration — per-tenant cost model parameters.
model CommercialConfig {
  id        String @id @default(cuid())
  companyId String @unique

  // Cost model inputs (per-km rates, hourly costs, etc.)
  fuelCostPerKm      Float @default(2.50)  // ZAR per km
  driverHourlyCost   Float @default(45.0)  // ZAR per hour
  vehicleCostPerKm   Float @default(1.80)  // depreciation + maintenance
  overheadPerDelivery Float @default(15.0)  // fixed overhead allocation
  avgDeliveryMinutes  Float @default(25.0)  // assumed time per stop
  avgKmPerDelivery    Float @default(12.0)  // assumed distance when no GPS

  // Pricing targets
  targetMarginPct    Float @default(35.0) // desired gross margin %
  minMarginPct       Float @default(15.0) // alarm threshold

  // Forecast model parameters
  seasonalityEnabled Boolean @default(true)
  forecastMonths     Int     @default(3)

  updatedAt DateTime @updatedAt

  @@map("commercial_configs")
}


// ─── Logistics Analytics (per-tenant monthly KPI snapshots) ──────────────────
// Computed analytics snapshot per company per period (YYYY-MM). Powers the
// analytics dashboard with volume, performance, financial, and fleet KPIs.
// AI insights are generated best-effort via Groq and cached here.

model LogisticsAnalytics {
  id        String @id @default(cuid())
  companyId String
  period    String // YYYY-MM

  // Volume KPIs
  totalDeliveries  Int   @default(0)
  deliveredOnTime  Int   @default(0)
  failedDeliveries Int   @default(0)
  returnedParcels  Int   @default(0)
  totalCollections Int   @default(0)

  // Performance KPIs
  onTimePercentage    Float  @default(0)
  avgDeliveryMinutes  Float? // average time from dispatch to POD
  slaBreaches         Int    @default(0)
  customerRatingAvg   Float?

  // Financial KPIs
  revenue         Float  @default(0)
  costPerDelivery Float?
  codCollected    Float  @default(0)

  // Fleet KPIs
  activeDrivers    Int    @default(0)
  avgDriverUtilPct Float?
  topDriverId      String?

  // AI-generated insights (JSON: { summary, trends[], recommendations[] })
  aiInsights    Json?
  aiGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, period])
  @@index([companyId])
  @@map("logistics_analytics")
}


// ─── ESG / Carbon Reporting (fleet emissions) ────────────────────────────────
// Tracks CO2 emissions per delivery period per company. Computed from total km
// driven (via route optimizer data / shipment distances) × vehicle emission factors.
// Powers the ESG dashboard and DHL subcontractor compliance reports.

model CarbonReport {
  id        String   @id @default(cuid())
  companyId String
  period    String   // YYYY-MM

  // Distance metrics
  totalKmDriven    Float   @default(0)
  totalDeliveries  Int     @default(0)
  avgKmPerDelivery Float?

  // Emissions (kg CO2)
  totalCo2Kg       Float   @default(0)  // total emissions this period
  co2PerDelivery   Float?               // avg per delivery
  co2PerKm         Float?               // emission factor used

  // Fleet composition
  petrolVehicles   Int     @default(0)
  dieselVehicles   Int     @default(0)
  electricVehicles Int     @default(0)
  motorbikeCount   Int     @default(0)

  // Offsets / reductions
  offsetKg         Float   @default(0)
  netEmissionsKg   Float   @default(0)  // total - offset

  // Comparison
  prevPeriodCo2Kg  Float?
  changePercent    Float?  // vs previous period

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, period])
  @@index([companyId])
  @@map("carbon_reports")
}



// ─── Driver Safety Zones (Crime Hotspot Detection) ────────────────────────────
// AI-powered real-time driver safety alerts. When a driver's GPS enters a
// designated safety zone (crime hotspot, hijacking area, high-risk corridor),
// the system immediately alerts the driver, dispatch, and tenant admin.
// No competitor in Africa offers this level of driver protection.

enum SafetyZoneRiskLevel {
  LOW        // Awareness — minor risk (e.g. poor lighting area)
  MEDIUM     // Caution — moderate risk (occasional incidents)
  HIGH       // Alert — known problem area (regular theft/hijack)
  CRITICAL   // Danger — active threat zone (avoid if possible)
}

model SafetyZone {
  id        String              @id @default(cuid())
  companyId String
  name      String              // "Alexandra", "N1 Johannesburg Off-ramp", "Diepsloot"
  description String?           // "High hijacking area. Avoid stopping. Lock doors."

  // Geographic center + radius (circle geofence)
  lat       Float
  lng       Float
  radiusM   Int     @default(1000) // radius in metres

  riskLevel SafetyZoneRiskLevel @default(HIGH)

  // Alert configuration
  alertMessage String?          // Custom alert shown to driver (e.g. "Lock doors. Do not stop.")
  notifyDriver Boolean @default(true)
  notifyDispatch Boolean @default(true)
  notifyAdmin  Boolean @default(true)

  // Source / metadata
  source    String?             // "SAPS_STATS" | "MANUAL" | "AI_DETECTED" | "COMMUNITY"
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts SafetyAlert[]

  @@index([companyId, isActive])
  @@index([lat, lng])
  @@map("safety_zones")
}

model SafetyAlert {
  id        String @id @default(cuid())
  companyId String

  // Who was alerted
  driverId  String
  driverName String?

  // Which zone triggered it
  zoneId    String
  zone      SafetyZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  zoneName  String?
  riskLevel SafetyZoneRiskLevel

  // GPS position when alert fired
  lat       Float
  lng       Float
  speed     Float?  // km/h at time of alert

  // Alert delivery status
  driverNotified   Boolean @default(false)
  dispatchNotified Boolean @default(false)
  adminNotified    Boolean @default(false)

  // Response
  acknowledged Boolean   @default(false) // driver tapped "OK"
  acknowledgedAt DateTime?
  exitedZoneAt   DateTime? // when driver left the zone

  // Audit
  metadata  Json?   // any extra context (waybill being delivered, etc.)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([driverId, createdAt])
  @@index([zoneId])
  @@map("safety_alerts")
}



// ─── Address Book (saved sender/receiver addresses for quick-fill) ────────────
// Tenants save frequently-used addresses to avoid retyping on every waybill.
// Each entry can be marked as SENDER, RECEIVER, or BOTH.

model AddressBookEntry {
  id        String @id @default(cuid())
  companyId String

  label       String   // "Takealot JHB", "Head Office", "John's Home"
  type        String   @default("BOTH") // SENDER | RECEIVER | BOTH
  name        String
  company     String?
  phone       String?
  email       String?
  address     String
  city        String?
  postalCode  String?
  country     String   @default("ZA")
  lat         Float?
  lng         Float?

  // Usage tracking (for smart suggestions)
  usageCount  Int      @default(0)
  lastUsedAt  DateTime?

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, type])
  @@index([companyId, usageCount])
  @@map("address_book_entries")
}

// ─── Tracking Timeline Events (multi-leg journey visibility) ──────────────────
// Every status change, scan, signature, or location update creates an event.
// Powers the customer-facing tracking page with granular journey visibility.

model TrackingEvent {
  id        String @id @default(cuid())
  waybillId String
  companyId String

  // What happened
  event       String   // COLLECTED | SCANNED_IN | SORTED | LOADED | IN_TRANSIT | ARRIVED | OUT_FOR_DELIVERY | DELIVERED | FAILED | RETURNED
  status      String?  // The WaybillStatus this event corresponds to
  description String   // Human-readable: "Parcel collected from sender by Sipho"

  // Where it happened
  location    String?  // "Johannesburg Hub", "N1 Highway", "Pretoria Branch"
  lat         Float?
  lng         Float?

  // Who did it
  actorType   String?  // DRIVER | WAREHOUSE | SYSTEM | DISPATCH
  actorId     String?
  actorName   String?

  // Metadata
  metadata    Json?    // Extra context: { manifestCode, branchName, attemptNumber, signatureUrl }

  createdAt   DateTime @default(now())

  @@index([waybillId, createdAt])
  @@index([companyId, createdAt])
  @@map("tracking_events")
}


// ─── Route Optimization (AI-powered, Issue #352) ─────────────────────────────

enum RouteOptimizationStatus {
  PENDING
  OPTIMIZING
  COMPLETED
  FAILED
}

model RouteOptimization {
  id          String                  @id @default(cuid())
  companyId   String
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String?
  status      RouteOptimizationStatus @default(PENDING)

  // Input
  deliveryIds String[]                // IDs of deliveries/waybills to optimize
  vehicleIds  String[]                // IDs of available vehicles/drivers
  depot       Json?                   // { lat, lng, address } origin point

  // Output
  optimizedRoutes Json?               // Array of routes: [{ vehicleId, stops: [{lat, lng, waybillId, eta}], totalDistance, totalTime }]
  totalDistance   Float?              // km
  totalDuration   Float?              // minutes
  savingsPercent  Float?              // % improvement over naive ordering

  // AI metadata
  modelUsed    String?                // e.g. "groq/llama-3.1-70b"
  aiInsights   Json?                  // Textual insights from AI about the optimization

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  allocations DeliveryAllocation[]

  @@index([companyId, createdAt])
  @@map("route_optimizations")
}

model DeliveryAllocation {
  id              String   @id @default(cuid())
  companyId       String
  optimizationId  String
  optimization    RouteOptimization @relation(fields: [optimizationId], references: [id], onDelete: Cascade)

  waybillId       String
  driverId        String?
  vehicleId       String?
  sequence        Int               // Order in the route
  estimatedArrival DateTime?
  distance        Float?            // km from previous stop
  status          String  @default("PENDING") // PENDING | ASSIGNED | IN_TRANSIT | COMPLETED

  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([optimizationId])
  @@map("delivery_allocations")
}

// ─── Dispatcher Notes (Issue #353) ───────────────────────────────────────────

model DeliveryNote {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  waybillId   String?  // Optional link to a specific waybill
  content     String   // The note text
  priority    String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  category    String?  // INSTRUCTION | ISSUE | UPDATE | GENERAL
  createdBy   String?  // userId who created the note
  createdByName String?
  isResolved  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([waybillId])
  @@map("delivery_notes")
}

// ─── Auto Order Flow Integration (Issue #354) ────────────────────────────────

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  CONFIGURING
}

enum IntegrationType {
  SHOPIFY
  WOOCOMMERCE
  MAGENTO
  CUSTOM_API
  CSV_IMPORT
  WEBHOOK
}

model OrderFlowIntegration {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String            // User-friendly name
  type        IntegrationType
  status      IntegrationStatus @default(CONFIGURING)
  config      Json?             // Provider-specific config (endpoints, mapping rules)
  credentials Json?             // Encrypted credentials (API keys, tokens)

  // Stats
  lastSyncAt     DateTime?
  totalOrders    Int @default(0)
  failedOrders   Int @default(0)

  // Auto-dispatch settings
  autoDispatch   Boolean @default(false)
  dispatchRules  Json?   // Rules for automatic assignment (area, driver, time windows)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  syncLogs    OrderSyncLog[]

  @@index([companyId])
  @@map("order_flow_integrations")
}

model OrderSyncLog {
  id              String   @id @default(cuid())
  integrationId   String
  integration     OrderFlowIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  companyId       String

  externalOrderId String?
  waybillId       String? // Created waybill if successful
  status          String  // SUCCESS | FAILED | SKIPPED
  errorMessage    String?
  payload         Json?   // Raw order data from external source

  createdAt       DateTime @default(now())

  @@index([integrationId, createdAt])
  @@index([companyId, createdAt])
  @@map("order_sync_logs")
}

// ─── Smart Routing / Route Planning (Issue #355) ─────────────────────────────

enum RoutePlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model RoutePlan {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String?
  status          RoutePlanStatus @default(DRAFT)
  vehicleId       String?
  driverId        String?

  // Route data
  routeCoordinates Json?         // Array of {lat, lng} waypoints
  stops            Json?          // Array of {waybillId, lat, lng, address, scheduledTime, serviceTime}
  totalStops       Int @default(0)

  // Metrics
  estimatedTime    Float?        // minutes
  estimatedDistance Float?       // km
  actualTime       Float?        // minutes (filled on completion)
  actualDistance    Float?       // km (filled on completion)

  // Scheduling
  scheduledDate    DateTime?
  startTime        DateTime?
  endTime          DateTime?
  vehicleCapacity  Float?        // kg or volume constraint

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId, scheduledDate])
  @@index([driverId])
  @@map("route_plans")
}

// ─── Real-time Tracking Upgrade + ePOD + Digital Payments (Detrack/Bringg parity) ───

enum EpodStatus {
  PENDING
  CAPTURED
  VERIFIED
  DISPUTED
}

model ElectronicPod {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  waybillId   String
  driverId    String?
  status      EpodStatus @default(PENDING)

  // Proof data
  signatureUrl   String?  // Cloud URL to signature image
  photoUrls      String[] // Photos of delivery
  recipientName  String?
  recipientId    String?  // ID number of recipient
  notes          String?
  geoLat         Float?
  geoLng         Float?
  capturedAt     DateTime?

  // Verification
  verifiedBy     String?
  verifiedAt     DateTime?
  disputeReason  String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([waybillId])
  @@map("electronic_pods")
}

model LiveTrackingSession {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  driverId    String
  vehicleId   String?
  manifestId  String?

  isActive    Boolean  @default(true)
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  // Real-time data
  currentLat  Float?
  currentLng  Float?
  speed       Float?   // km/h
  heading     Float?   // degrees
  lastPingAt  DateTime?

  // Trip stats
  distanceCovered Float? // km
  stopsCompleted  Int @default(0)
  totalStops      Int @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, isActive])
  @@index([driverId, isActive])
  @@map("live_tracking_sessions")
}

model DigitalPayment {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  waybillId   String?
  driverId    String?

  // Payment details
  amount      Float
  currency    String  @default("ZAR")
  method      String  // CARD | EFT | MOBILE_MONEY | QR_CODE | CASH
  status      String  @default("PENDING") // PENDING | PROCESSING | SUCCESS | FAILED | REFUNDED
  reference   String? @unique
  externalId  String? // Payment gateway reference

  // Payer info
  payerName   String?
  payerPhone  String?
  payerEmail  String?

  // Gateway
  gateway     String? // PAYSTACK | OZOW | YOCO | MANUAL
  gatewayResponse Json?

  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([waybillId])
  @@map("digital_payments")
}


// ─────────────────────────────────────────────────────────────────────────────
// RAIL / INTERMODAL OPERATIONS
//
// FlowOps sits ABOVE the rail network as a coordination + intelligence layer —
// it is NOT a signalling / slot-allocation / marshalling control system.
// A RailConsignment is the central record for cargo moving (in whole or part)
// by rail. Wagons/rakes, intermodal legs (road<->rail<->port handoffs) and a
// status event timeline hang off it. Additive; mirrors the ShipmentFile design.
// ─────────────────────────────────────────────────────────────────────────────

enum RailConsignmentStatus {
  PLANNED          // booked / slot requested
  WAGONS_ALLOCATED // rolling stock assigned
  LOADING          // at origin siding / terminal
  DEPARTED         // left origin
  IN_TRANSIT       // on the corridor
  AT_INTERCHANGE   // handoff point (border / yard / port)
  ARRIVED          // reached destination siding / terminal
  OFFLOADED        // cargo discharged
  COMPLETED        // consignment closed
  CANCELLED
}

enum WagonType {
  FLAT           // container / breakbulk
  GONDOLA        // bulk minerals (coal, manganese)
  TANK           // liquids / fuel
  BOXCAR         // covered general freight
  HOPPER         // free-flowing bulk
  CONTAINER_CAR  // intermodal container flats
}

enum IntermodalLegMode {
  ROAD
  RAIL
  PORT
}

enum IntermodalLegStatus {
  PENDING
  IN_PROGRESS
  HANDED_OVER
  COMPLETED
  DELAYED
}

model RailConsignment {
  id                String                @id @default(cuid())
  consignmentNumber String // RAIL-2026-00042 (unique per tenant)
  status            RailConsignmentStatus @default(PLANNED)

  // Commercial / cargo
  clientName    String?
  commodity     String  // Copper cathodes | Coal | Manganese | Containers | Fuel...
  tonnage       Float?  // total planned tonnage
  wagonsPlanned Int?    // planned number of wagons/rake size

  // Corridor / routing
  corridor          String? // North-South | Maputo | Copperbelt | Coal Line...
  originSiding      String? // origin terminal / siding / mine
  destinationSiding String? // destination terminal / siding / port
  railOperator      String? // train operating company (TOC)
  serviceRef        String? // rail service / path / slot reference
  interchangePoint  String? // primary handoff (border / yard / port)

  // Schedule
  plannedDeparture DateTime?
  plannedArrival   DateTime?
  actualDeparture  DateTime?
  actualArrival    DateTime?

  // Coordination intelligence (FlowOps' value)
  slaHours     Int?    // target corridor transit SLA
  riskLevel    RiskLevel?
  riskNote     String? @db.Text

  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wagons Wagon[]
  legs   IntermodalLeg[]
  events RailConsignmentEvent[]

  @@unique([consignmentNumber, companyId])
  @@index([companyId, status])
  @@map("rail_consignments")
}

model Wagon {
  id             String    @id @default(cuid())
  consignmentId  String
  consignment    RailConsignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  wagonNumber    String    // rolling-stock ID e.g. SAR-064213
  type           WagonType @default(CONTAINER_CAR)
  tareTonnes     Float?    // empty weight
  loadedTonnes   Float?    // cargo weight on this wagon
  commodity      String?
  sealNumbers    String?
  lastKnownSiding String?  // location snapshot (coordination, not signalling)
  loadedAt       DateTime?
  offloadedAt    DateTime?

  @@index([consignmentId])
  @@map("wagons")
}

// Road <-> Rail <-> Port handoffs — "the gap nobody owns".
model IntermodalLeg {
  id            String              @id @default(cuid())
  consignmentId String
  consignment   RailConsignment     @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  sequence      Int                 // 1,2,3... order of legs in the journey
  mode          IntermodalLegMode
  status        IntermodalLegStatus @default(PENDING)
  fromLocation  String?
  toLocation    String?
  handler       String?             // carrier / operator responsible for this leg
  plannedStart  DateTime?
  plannedEnd    DateTime?
  actualStart   DateTime?
  actualEnd     DateTime?
  dwellHours    Float?              // dwell/idle time at the handoff (computed)
  note          String?             @db.Text

  @@index([consignmentId])
  @@map("intermodal_legs")
}

model RailConsignmentEvent {
  id            String                @id @default(cuid())
  consignmentId String
  consignment   RailConsignment       @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  status        RailConsignmentStatus
  note          String?               @db.Text
  location      String?
  reachedAt     DateTime              @default(now())

  @@index([consignmentId])
  @@map("rail_consignment_events")
}
