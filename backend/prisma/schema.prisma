}

model RailConsignmentEvent {
  id            String                @id @default(cuid())
  consignmentId String
  consignment   RailConsignment       @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  status        RailConsignmentStatus
  note          String?               @db.Text
  location      String?
  reachedAt     DateTime              @default(now())

  @@index([consignmentId])
  @@map("rail_consignment_events")
}

model RailScheduleImport {
  id           String             @id @default(cuid())
  companyId    String?
  company      Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scopeKey     String
  sourceName   String
  sourceHash   String
  rowCount     Int
  importedBy   String?
  importedAt   DateTime           @default(now())
  rows         RailScheduleRow[]

