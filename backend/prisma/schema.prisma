generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  COMPANY_ADMIN
  MANAGER
  DISPATCH
  WAREHOUSE
  AGENT
  USER
  DRIVER
  VIEWER
}

enum WaybillStatus {
  PENDING
  COLLECTED
  AT_ORIGIN_HUB
  IN_TRANSIT
  AT_DESTINATION_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
}

enum CollectionStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COLLECTED
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum DriverStatus {
  AVAILABLE
  ON_ROUTE
  OFFLINE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum DigestFrequency {
  INSTANT
  DAILY
  WEEKLY
}

// ─── Platform Owner (super-admin, separate from tenant users) ─────────────

model OwnerUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens OwnerRefreshToken[]

  @@map("owner_users")
}

model OwnerRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  ownerId   String
  owner     OwnerUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@map("owner_refresh_tokens")
}

// ─── Tenant Company ────────────────────────────────────────────────────────

model Company {
  id          String  @id @default(cuid())
  name        String
  tradingName String?
  email       String? @unique
  phone       String?
  address     String?
  city        String?
  country     String  @default("ZA")
  currency    String  @default("ZAR")
  vatNumber   String?

  // WhatsApp — tenant's own mobile number used for click-to-chat (wa.me) links.
  // No Business API token needed; agents send from this number via WhatsApp Web/app.
  whatsappNumber String?

  // Banking details — appears on invoices so clients know where to pay.
  bankName       String?
  bankAccountHolder String?
  bankAccountNumber String?
  bankBranchCode String?
  bankAccountType String?  // "Cheque" | "Savings" | "Current"

  // Branding
  logoUrl            String?
  brandName          String?
  primaryColor       String?
  secondaryColor     String?
  invoiceHeaderColor String?

  // Customer-facing booking portal
  portalBrandName    String?
  portalSubdomain    String? @unique
  portalPrimaryColor String?
  portalLogoUrl      String?

  // SLA thresholds (minutes)
  slaWarningMinutes  Int @default(30)
  slaBreachMinutes   Int @default(60)
  slaEscalateMinutes Int @default(120)

  // Billing plan
  plan          String   @default("starter")
  trialStartedAt DateTime @default(now())
  trialEndsAt   DateTime?
  isActive      Boolean  @default(true)

  // ── Owner-managed subscription overrides ──────────────────────────────
  // Per-tenant feature add-ons granted beyond the plan tier (key -> true),
  // e.g. give a Professional tenant `freightForwarding` without a full upgrade.
  // Merged on top of the plan's feature flags by BillingService.
  featureOverrides Json?
  // Custom monthly price (ZAR) the owner negotiated for this tenant. When set,
  // it overrides the plan list price for MRR + billing display. Null = use plan.
  priceOverrideZar Float?

  // CLAW Autopilot for Operations (Enterprise) — when enabled, the autonomy
  // engine may auto-execute safe ops actions (reassign stalled pickups,
  // escalate SLA pre-breaches / COD mismatches). Aggression overrides the
  // global CLAW_AGGRESSION_LEVEL for this tenant when set (LOW|MEDIUM|HIGH).
  autopilotEnabled    Boolean @default(false)
  autopilotAggression String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  waybills           Waybill[]
  waybillInboxItems  WaybillInboxItem[]
  collections        Collection[]
  shipments          Shipment[]
  drivers            Driver[]
  driverChatMessages DriverChatMessage[] @relation("CompanyDriverChats")
  branches           Branch[]
  manifests          Manifest[]
  invoices           Invoice[]
  invoiceDrafts      InvoiceDraft[]
  rateCards          RateCard[]
  quotes             Quote[]
  notifications      Notification[]
  whatsappThreads    WhatsAppThread[]
  payments           Payment[]
  leads              Lead[]
  bookingPortalLinks BookingPortalLink[]
  aiEvents           AiEvent[]
  emailHubItems      EmailHubItem[]
  workflows          Workflow[]
  approvalRequest    ApprovalRequest?
  planUpgradeRequests PlanUpgradeRequest[]
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  codTransactions    CodTransaction[]
  clients            Client[]
  returns            Return[]
  creditNotes        CreditNote[]
  debitNotes         DebitNote[]
  salespeople        Salesperson[]
  commissions        Commission[]
  accountingConnections AccountingConnection[]
  accountingSyncLogs    AccountingSyncLog[]
  ssoConnection         SsoConnection?
  supportTickets        SupportTicket[]
  courierOrders         CourierOrder[]
  integrationCredentials IntegrationCredential[]

  // CLAW Intel features
  routeOptimizations    RouteOptimization[]
  deliveryNotes         DeliveryNote[]
  orderFlowIntegrations OrderFlowIntegration[]
  routePlans            RoutePlan[]
  electronicPods        ElectronicPod[]
  liveTrackingSessions  LiveTrackingSession[]
  digitalPayments       DigitalPayment[]

  @@map("companies")
}

// ─── Integration credentials (per-tenant, encrypted) ────────────────────────
// Tenant-owned connection secrets for external providers (WhatsApp Business API,
// Shopify, WooCommerce). Secret material is AES-256-GCM encrypted at rest and
// NEVER returned to any client. `externalRef` is the inbound-routing key
// (WhatsApp phone_number_id, Shopify shop domain, WooCommerce source URL) so a
// webhook can be matched to its owning company with a single indexed lookup.
model IntegrationCredential {
  id               String    @id @default(cuid())
  companyId        String
  provider         String    // 'whatsapp' | 'shopify' | 'woocommerce'
  config           Json?     // non-secret fields (phoneNumberId, shopDomain, ...)
  externalRef      String?   // inbound-routing key (lowercased/normalised)
  secretCiphertext String?
  secretIv         String?
  secretAuthTag    String?
  status           String    @default("UNVERIFIED")
  lastVerifiedAt   DateTime?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([provider, externalRef])
  @@map("integration_credentials")
}

// ─── Users ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  name         String
  phone        String?
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true)

  // Per-user nav/feature permission overrides (key -> boolean). When set,
  // these take precedence over the role defaults for sidebar + route access.
  permissions  Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Email verification
  emailVerified     Boolean   @default(false)
  verifyToken       String?
  verifyTokenExpiry DateTime?

  // Password reset
  resetToken       String?
  resetTokenExpiry DateTime?

  // ── Single active session + login audit ───────────────────────────────
  // Only one device may hold a live session at a time. Each login mints a new
  // sessionId (also embedded in the access token as `sid`); the JWT strategy
  // rejects any token whose sid != activeSessionId, so a new login elsewhere
  // immediately invalidates every other device.
  activeSessionId    String?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginUserAgent String?
  // Presence heartbeat — stamped (throttled) on authenticated requests so the
  // owner console can show live online status. Distinct from lastLoginAt.
  lastActiveAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens          RefreshToken[]
  notificationPreference NotificationPreference?
  assignedCollections    Collection[]            @relation("AssignedAgent")
  assignedShipments      Shipment[]
  // Optional link to a Driver record so DRIVER-role users see only their own jobs
  linkedDriver           Driver?

  @@unique([email, companyId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─── Public API & Webhooks (tenant integrations: Shopify, etc.) ───────────

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  // Only the SHA-256 hash is stored; the plaintext key is shown once at creation.
  keyHash    String    @unique
  prefix     String // first chars, for display ("fok_live_ab12…")
  lastUsedAt DateTime?
  revokedAt  DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("api_keys")
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  secret    String // used to HMAC-sign deliveries so receivers can verify
  events    String[] // e.g. ["waybill.status_changed", "waybill.delivered"]
  active    Boolean  @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model ApprovalRequest {
  id       String         @id @default(cuid())
  status   ApprovalStatus @default(PENDING)
  fullName String
  email    String
  phone    String
  company  String
  notes    String?

  // Dedicated field for the bcrypt password hash — never stored in notes/JSON.
  // Set during registration; consumed and cleared after the admin account is
  // created on approval. Kept separate so it is never exposed in approval
  // request listings.
  passwordHash String?

  // Linked once approved
  companyId     String?  @unique
  tenantCompany Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("approval_requests")
}

// In-app plan-upgrade request → owner approval (no payment provider).
// A tenant admin requests a higher tier from inside the app; the platform
// owner approves (which flips company.plan) or declines. Tenant-scoped.
model PlanUpgradeRequest {
  id        String         @id @default(cuid())
  status    ApprovalStatus @default(PENDING)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  currentPlan   String  // tenant's plan when the request was raised (audit snapshot)
  requestedPlan String  // target PlanId (professional / professional_10/25/50 / enterprise)

  // Who raised it (tenant admin)
  requestedById    String?
  requestedByEmail String?
  note             String? @db.Text // optional message from the tenant

  // Owner decision
  reviewedById    String?
  reviewedByEmail String?
  reviewedAt      DateTime?
  decisionNote    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("plan_upgrade_requests")
}

// ── OKRs (platform-owner strategic cockpit) ─────────────────────────────────
// Objectives & Key Results for FlowOps itself (not tenant-scoped) — the owner
// tracks quarterly objectives, each with measurable key results that roll up to
// an auto-computed progress %. Owner-only; lives behind the owner console.
enum OkrStatus {
  ON_TRACK
  AT_RISK
  BEHIND
  ACHIEVED
  CANCELLED
}

enum KeyResultUnit {
  NUMBER
  PERCENT
  CURRENCY
}

model Objective {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  quarter     String     // e.g. "2026-Q4"
  owner       String?    // person accountable
  status      OkrStatus  @default(ON_TRACK)
  sortOrder   Int        @default(0)

  keyResults  KeyResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quarter])
  @@map("objectives")
}

model KeyResult {
  id          String        @id @default(cuid())
  objectiveId String
  objective   Objective     @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  title       String
  unit        KeyResultUnit @default(NUMBER)
  startValue  Float         @default(0)
  targetValue Float
  currentValue Float        @default(0)
  status      OkrStatus     @default(ON_TRACK)
  sortOrder   Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objectiveId])
  @@map("key_results")
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Master channel toggles
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)
  pushEnabled  Boolean @default(true)

  // Per-category × channel
  operationsEmail Boolean @default(true)
  operationsSms   Boolean @default(false)
  operationsPush  Boolean @default(true)
  billingEmail    Boolean @default(true)
  billingPush     Boolean @default(false)
  securityEmail   Boolean @default(true)
  securityPush    Boolean @default(true)
  systemEmail     Boolean @default(false)
  systemPush      Boolean @default(false)

  // Digest
  digestFrequency DigestFrequency @default(INSTANT)

  // Quiet hours
  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String  @default("22:00")
  quietHoursEnd     String  @default("07:00")
  timezone          String  @default("Africa/Johannesburg")

  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// ─── Drivers ──────────────────────────────────────────────────────────────

model Driver {
  id          String       @id @default(cuid())
  name        String
  phone       String
  email       String?
  vehicleType String       @default("motorbike")
  vehicleReg  String?
  status      DriverStatus @default(OFFLINE)
  isActive    Boolean      @default(true)

  // ── Customer delivery rating ──────────────────────────────────────────
  customerRating      Int?
  customerRatingNote  String?
  ratingToken         String?   @unique
  ratingRequestedAt   DateTime?

  // Last known GPS position
  lastLat  Float?
  lastLng  Float?
  lastSeen DateTime?

  // Driver portal auth (phone + hashed 4-digit PIN)
  driverPin String?

  // ── Single active session + login audit (driver portal) ───────────────
  // Mirrors the User model: one device per driver. driver-login mints a new
  // sessionId embedded in the driver token as `sid`.
  activeSessionId    String?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginUserAgent String?

  // ── PIN brute-force lockout ───────────────────────────────────────────
  // A 4-digit PIN has only 10k combinations, so IP-based throttling alone is
  // not enough. We count consecutive failed PIN attempts per driver and lock
  // the account for a cooldown once a threshold is hit; a successful login
  // resets the counter. This is independent of the IP throttle, so rotating
  // IPs cannot bypass it.
  failedPinAttempts  Int       @default(0)
  pinLockedUntil     DateTime?

  // Optional link to a User account — enables role-scoped job delivery
  userId    String? @unique
  user      User?   @relation(fields: [userId], references: [id])

  // Fleet / vehicle maintenance
  currentKm       Int?       // current odometer reading
  nextServiceKm   Int?       // odometer reading at which next service is due
  nextServiceDate DateTime?  // calendar-based service due date
  vehicleNotes    String?    // free-form notes (tyre condition, defects etc.)

  chatMessages    DriverChatMessage[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections     Collection[]
  shipments       Shipment[]
  manifests       Manifest[]
  wallet          DriverWallet?
  services        VehicleService[]
  returns         Return[]
  refreshTokens   DriverRefreshToken[]

  @@map("drivers")
}

// Driver refresh tokens — enables silent token rotation (4h access / 7d refresh)
// so drivers don't get kicked out mid-shift when their short-lived access token expires.
model DriverRefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("driver_refresh_tokens")
}

// ─── Branches ─────────────────────────────────────────────────────────────

model Branch {
  id      String  @id @default(cuid())
  name    String
  address String?
  city    String?
  lat     Float?
  lng     Float?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivers   Driver[]
  manifests Manifest[]
  waybills  Waybill[]  @relation("OriginBranch")

  @@map("branches")
}

// ─── Freight Forwarding (import/export) ─────────────────────────────────────
// New product line: ocean/air container import/export. A ShipmentFile is the
// central record per consignment; containers/cargo, routing milestones, charges
// (cost vs sell) and documents hang off it. Additive — no changes to the
// existing courier tables. See .kiro/specs/freight-forwarding.

enum FreightMode {
  OCEAN
  AIR
  ROAD
  RAIL
}

enum FreightDirection {
  IMPORT
  EXPORT
}

enum LoadType {
  FCL
  LCL
  BREAKBULK
  AIR
}

enum ShipmentFileStatus {
  DRAFT
  BOOKED
  CARGO_RECEIVED
  LOADED
  DEPARTED
  ARRIVED
  CUSTOMS_CLEARED
  DELIVERED
  CANCELLED
}

model ShipmentFile {
  id         String              @id @default(cuid())
  fileNumber String // e.g. IMP-2026-00042 (unique per tenant)
  mode       FreightMode
  direction  FreightDirection
  loadType   LoadType
  status     ShipmentFileStatus  @default(DRAFT)
  incoterm   String? // EXW|FOB|CIF|DDP...

  // Parties (denormalised; optional Client links can come later)
  shipperName   String?
  consigneeName String?
  notifyParty   String?
  carrierName   String?
  agentName     String?

  // Cargo summary
  goodsDescription String? @db.Text
  packages         Int?
  grossWeightKg    Float?
  volumeCbm        Float?

  // Routing
  pol          String? // port of loading (UN/LOCODE or name)
  pod          String? // port of discharge
  vesselVoyage String? // or flight number
  vesselMmsi   String? // vessel MMSI (9-digit AIS id) — enables LIVE AISStream tracking
  vesselImo    String? // vessel IMO number (optional, for reference)
  etd          DateTime?
  eta          DateTime?

  // Cross-border / CMR / Transit fields
  shipperAddress     String?
  consigneeAddress   String?
  originCountry      String? // ISO country code or name
  destinationCountry String?
  transitCountries   String? // comma-separated
  vehicleReg         String? // truck registration plate
  sealNumbers        String? // customs seal numbers
  importerTin        String? // importer tax ID (e.g. ZIMRA TIN)

  // AI-derived (demurrage / delay risk)
  aiRiskScore Int?
  aiRiskNote  String? @db.Text

  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  containers ShipmentContainer[]
  cargo      CargoLine[]
  charges    ShipmentCharge[]
  documents  ShipmentDocument[]
  milestones ShipmentMilestone[]
  declarations CustomsDeclaration[]
  disbursements Disbursement[]

  // Consolidation / co-load (Phase 3): house files grouped under a master file.
  isMaster     Boolean        @default(false)
  masterFileId String?
  master       ShipmentFile?  @relation("Consolidation", fields: [masterFileId], references: [id], onDelete: SetNull)
  houseFiles   ShipmentFile[] @relation("Consolidation")

  @@unique([fileNumber, companyId])
  @@index([companyId, status])
  @@map("shipment_files")
}

model ShipmentContainer {
  id          String       @id @default(cuid())
  fileId      String
  file        ShipmentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  containerNo String // e.g. ABCU1234567
  isoType     String // 20GP|40HC|40RF...
  sealNo      String?
  vgmKg       Float?

  // Demurrage / detention (Phase 3)
  freeDays      Int?      // free days before per-diem starts
  perDiemRate   Float?    // demurrage/detention rate per day
  availableFrom DateTime? // clock start (discharge / availability)
  returnedAt    DateTime? // empty-return / gate-in (clock stop)

  @@index([fileId])
  @@map("shipment_containers")
}

model CargoLine {
  id           String       @id @default(cuid())
  fileId       String
  file         ShipmentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  description  String
  pieces       Int?
  weightKg     Float?
  dimensions   String?
  hsCode       String? // tariff heading
  customsValue Float?
  dutyRatePct  Float? // ad valorem duty rate % (operator-set or AI-suggested)

  // Dangerous Goods (DG) fields
  unNumber       String? // UN classification number (e.g. "1203")
  dgClass        String? // DG class (e.g. "3" for flammable liquids)
  packingGroup   String? // I, II, or III
  emergencyPhone String? // 24-hour emergency contact

  @@index([fileId])
  @@map("cargo_lines")
}

model ShipmentCharge {
  id          String       @id @default(cuid())
  fileId      String
  file        ShipmentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  description String
  currency    String       @default("ZAR")
  cost        Float        @default(0)
  sell        Float        @default(0)
  invoiceTo   String? // party to bill

  @@index([fileId])
  @@map("shipment_charges")
}

model ShipmentDocument {
  id        String       @id @default(cuid())
  fileId    String
  file      ShipmentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type      String // BILL_OF_LADING|COMMERCIAL_INVOICE|PACKING_LIST|CERT_OF_ORIGIN|SAD500|OTHER
  fileName  String
  fileKey   String // storage key (R2/local)
  createdAt DateTime @default(now())

  @@index([fileId])
  @@map("shipment_documents")
}

model ShipmentMilestone {
  id        String             @id @default(cuid())
  fileId    String
  file      ShipmentFile       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  status    ShipmentFileStatus
  note      String?
  reachedAt DateTime           @default(now())

  @@index([fileId])
  @@map("shipment_milestones")
}

enum CustomsDeclarationStatus {
  DRAFT
  SUBMITTED
  QUERY
  RELEASED
  REJECTED
}

// Per-tenant SARS transmission method. FlowOps holds NO SARS credentials and is
// never the declarant — the tenant brings their own path (see the
// sars-edi-customs-bridge spec).
enum CustomsEdiPath {
  DIRECT_EDI             // tenant is a registered SARS EDI user
  SERVICE_PROVIDER       // tenant uses a SARS-approved VAN / EDI service provider
  CLEARING_AGENT_HANDOFF // no live wire — package handed to the tenant's agent
}

enum CustomsEdiCredentialStatus {
  UNVERIFIED
  VERIFIED
  DISABLED
}

// SAD (Single Administrative Document) declaration workflow (Phase 3). Holds a
// CUSDEC-style structured payload and a lifecycle. NOTE: actual SARS EDI wire
// submission requires SARS accreditation + a registered EDI gateway — this
// models the workflow + payload; submission is a pluggable stub for now.
model CustomsDeclaration {
  id     String                   @id @default(cuid())
  fileId String
  file   ShipmentFile             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type   String // IMPORT | EXPORT
  status CustomsDeclarationStatus @default(DRAFT)

  lrn String? // local reference number (our side)
  mrn String? // movement/customs reference (from SARS)

  payload           Json?  // CUSDEC-style declaration data
  customsValueTotal Float?
  dutyTotal         Float?
  vatTotal          Float?

  // Which transmission path actually lodged this (null until submitted live).
  lodgementProvider String?

  submittedAt  DateTime?
  responseAt   DateTime?
  responseNote String?

  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ediMessages CustomsEdiMessage[]

  @@index([fileId])
  @@index([companyId, status])
  @@map("customs_declarations")
}

// Per-tenant customs transmission credentials. One active record per company.
// Secret material is AES-256-GCM encrypted at rest and never returned to clients
// (masked on read). FlowOps never stores a platform-wide SARS credential.
model CustomsEdiCredential {
  id     String                     @id @default(cuid())
  companyId String
  path   CustomsEdiPath
  status CustomsEdiCredentialStatus  @default(UNVERIFIED)

  customsClientCode String? // tenant's SARS CCN (not secret — appears on the SAD)
  providerName      String? // VAN/provider label or agent name
  endpointUrl       String? // provider gateway / agent webhook
  agentEmail        String? // CLEARING_AGENT_HANDOFF target

  // Encrypted secret (AES-256-GCM). Never serialized to clients or logs.
  secretCiphertext String? @db.Text
  secretIv         String?
  secretAuthTag    String?

  lastVerifiedAt DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId]) // one credential record per tenant
  @@map("customs_edi_credentials")
}

// CUSDEC/CUSRES message log — audit trail + LRN-based idempotency for the bridge.
model CustomsEdiMessage {
  id            String             @id @default(cuid())
  declarationId String
  declaration   CustomsDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  companyId     String
  direction     String   // OUTBOUND | INBOUND
  messageType   String   // CUSDEC | CUSRES | VERIFY
  status        String   // SENT | ACK | ERROR | RECEIVED
  reference     String?  // provider/SARS message ref
  payload       Json?
  error         String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([declarationId])
  @@index([companyId, createdAt])
  @@map("customs_edi_messages")
}

// ─── Carriers & Procurement (buy-side) ─────────────────────────────────────
// Shipping lines, airlines, road carriers and broker/vendor partners a forwarder
// books space with — plus their negotiated buy-rates. Distinct from the sell-side
// RateCard. Scoped per tenant.
enum CarrierType {
  OCEAN_LINE
  AIRLINE
  ROAD_CARRIER
  COURIER
  CUSTOMS_BROKER
  OTHER
}

model Carrier {
  id            String      @id @default(cuid())
  companyId     String
  name          String
  type          CarrierType @default(OTHER)
  code          String?     // SCAC / IATA / internal code
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  accountNumber String?     // our account number with this carrier
  notes         String?     @db.Text
  isActive      Boolean     @default(true)

  rates     CarrierRate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive])
  @@map("carriers")
}

model CarrierRate {
  id            String   @id @default(cuid())
  carrierId     String
  carrier       Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  companyId     String
  lane          String?  // e.g. "CNSHA → ZADUR"
  mode          String?  // OCEAN | AIR | ROAD
  containerType String?  // 20GP | 40HC | LCL | AIR
  buyRate       Float    @default(0)
  currency      String   @default("USD")
  validFrom     DateTime?
  validTo       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([carrierId])
  @@map("carrier_rates")
}

// ─── Disbursements (clearing-agent finance) ────────────────────────────────
// Duties / VAT / port & line charges a forwarder pays to an authority ON BEHALF
// of a client, then recovers. Tracks paid-out vs recovered for the import/export
// finance desk. Scoped per tenant.
enum DisbursementStatus {
  OUTSTANDING // paid out to the authority, not yet recovered from the client
  INVOICED    // billed to the client (recovery invoice raised)
  RECOVERED   // client has reimbursed us
  WRITTEN_OFF // unrecoverable
}

model Disbursement {
  id          String             @id @default(cuid())
  companyId   String
  fileId      String?
  file        ShipmentFile?      @relation(fields: [fileId], references: [id], onDelete: SetNull)
  clientName  String?
  authority   String // SARS, port authority, shipping line, airline, etc.
  category    String? // DUTY | VAT | PORT | LINE | STORAGE | OTHER
  reference   String? // receipt / payment reference
  description String?
  amount      Float              @default(0) // amount paid out
  currency    String             @default("ZAR")
  status      DisbursementStatus @default(OUTSTANDING)
  paidAt      DateTime           @default(now())
  recoveredAt DateTime?
  invoiceId   String? // optional link to the recovery invoice

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([fileId])
  @@map("disbursements")
}

// ─── Waybills ─────────────────────────────────────────────────────────────


model Waybill {
  id             String        @id @default(cuid())
  trackingNumber String
  status         WaybillStatus @default(PENDING)

  // Parties
  senderName       String
  senderPhone      String
  senderEmail      String?
  senderAddress    String
  recipientName    String
  recipientPhone   String
  recipientAddress String
  recipientEmail   String?

  // Geocoded coordinates (populated by the geocoding pipeline) — power routing,
  // the live map, ETA, and the public tracking page.
  senderLat    Float?
  senderLng    Float?
  recipientLat Float?
  recipientLng Float?

  // Parcel
  weight      Float?
  dimensions  String?
  description String?
  totalAmount Float?
  codAmount   Float?
  codCollected    Boolean   @default(false)   // driver has physically collected the cash
  codCollectedAt  DateTime?

  // Customer delivery rating (requested via /waybills/:id/rate-request after delivery)
  customerRating      Int?
  customerRatingNote  String?
  ratingToken         String?   @unique
  ratingRequestedAt   DateTime?

  // Risk assessment
  riskLevel RiskLevel @default(LOW)
  riskScore Float?
  riskNotes String?

  // Proof of delivery (RECEIVER signature at delivery — Leg 7)
  podSignatureUrl String?
  podImageUrl     String?
  podRecipient    String?
  podDeliveredAt  DateTime?
  // Barcodes scanned at handover — audit trail of exactly what was delivered.
  podScannedCodes String[]

  // Proof of collection (SENDER + DRIVER signatures at pickup — Leg 1)
  // Complete chain of custody: sender confirms handover → driver acknowledges receipt
  pocSenderSignatureUrl    String?  // Sender signed on driver's phone at collection
  pocSenderName            String?  // Who signed at collection (sender side)
  pocDriverSignatureUrl    String?  // Driver signed to acknowledge receipt
  pocCollectionPhotoUrl    String?  // Photo of parcels at collection (condition evidence)
  pocCollectedAt           DateTime? // Timestamp of collection signatures

  // Delivery attempts (3x retry before return-to-sender)
  attemptCount    Int       @default(0)   // Number of delivery attempts made
  maxAttempts     Int       @default(3)   // Max attempts before return (configurable)
  nextAttemptAt   DateTime?               // Scheduled next attempt (auto-set on failure)
  lastAttemptNote String?                 // Reason for last failed attempt
  returnToSender  Boolean   @default(false) // True when max attempts exhausted

  // Uploaded scan file (Cloudflare R2 key)
  fileUrl String?
  fileKey String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  originBranchId String?
  originBranch   Branch? @relation("OriginBranch", fields: [originBranchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments        Shipment[]
  manifestWaybills ManifestWaybill[]
  invoiceItems     InvoiceItem[]
  inboxItem        WaybillInboxItem?
  codTransactions  CodTransaction[]
  returns          Return[]

  @@unique([trackingNumber, companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, updatedAt])
  @@index([status, updatedAt])
  @@map("waybills")
}

model WaybillInboxItem {
  id     String @id @default(cuid())
  // PENDING | EXTRACTING | READY | COMMITTED | FAILED
  status String @default("PENDING")

  fileUrl  String?
  fileKey  String?
  mimeType String?

  // AI-extracted fields + confidence scores
  extractedData Json?
  aiConfidence  Float?
  aiError       String?

  waybillId String?  @unique
  waybill   Waybill? @relation(fields: [waybillId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waybill_inbox_items")
}

// ─── Collections ──────────────────────────────────────────────────────────

model Collection {
  id     String           @id @default(cuid())
  status CollectionStatus @default(PENDING)

  clientName    String
  clientPhone   String
  clientEmail   String?
  pickupAddress String
  notes         String?

  // Geocoded pickup coordinates (populated by the geocoding pipeline).
  pickupLat Float?
  pickupLng Float?

  scheduledAt DateTime?
  pickedUpAt  DateTime?

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  agentId String?
  agent   User?   @relation("AssignedAgent", fields: [agentId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collections")
}

// ─── Shipments ────────────────────────────────────────────────────────────

model Shipment {
  id     String         @id @default(cuid())
  status ShipmentStatus @default(PENDING)

  waybillId String
  waybill   Waybill @relation(fields: [waybillId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  currentLat Float?
  currentLng Float?

  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

