{
  "name": "flowops-backend",
  "version": "1.0.0",
  "description": "FlowOps logistics SaaS backend",
  "author": "FlowOps",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "prisma:stub": "node scripts/local-prisma-stub.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:process-control": "jest src/process-control src/product-master src/warehouse-management",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:cov": "jest --coverage",
    "test:e2e": "if [ -f test/jest-e2e.json ]; then jest --config ./test/jest-e2e.json; else echo 'No backend E2E suite configured; skipping.'; fi",
    "typecheck:tests": "tsc --project tsconfig.test.json",
    "schema:validate:offline": "node scripts/prisma-validate-offline.mjs",
    "db:ephemeral": "node scripts/ephemeral-db.mjs",
    "migrations:verify": "node scripts/verify-migrations.mjs",
    "migrations:review": "node scripts/review-migration.mjs",
    "migrations:test": "node --test scripts/migrations.test.mjs",
    "migrations:rehearsal:test": "node --test scripts/migrate-rehearsal.test.mjs",
    "migrations:rehearse": "node scripts/migrate-rehearsal.mjs",
    "release:safety:test": "node --test scripts/entitlement-audit.test.mjs scripts/migrate-rehearsal.test.mjs scripts/release-startup.test.mjs scripts/rbac-inventory.test.mjs scripts/compose-env-allowlist.test.mjs scripts/compose-env-sweep.test.mjs scripts/body-any-audit.test.mjs scripts/unique-reference-migration.test.mjs scripts/duplicate-reference-check.test.mjs scripts/deploy-rbac-guard.test.mjs scripts/tenant-scope-audit.test.mjs scripts/tenant-context-coverage.test.mjs scripts/manual-coverage.test.mjs scripts/state-transition-audit.test.mjs",
    "deploy-guard:test": "node --test scripts/deploy-rbac-guard.test.mjs",
    "manual:coverage": "node --test scripts/manual-coverage.test.mjs",
    "state-transitions:audit": "node scripts/state-transition-audit.mjs",
    "state-transitions:test": "node --test scripts/state-transition-audit.test.mjs",
    "compose-env:test": "node --test scripts/compose-env-allowlist.test.mjs",
    "compose-env:check": "node scripts/compose-env-allowlist.mjs --check",
    "rbac:test": "node --test scripts/rbac-inventory.test.mjs",
    "rbac:inventory": "node scripts/rbac-inventory.mjs",
    "rbac:inventory:json": "node scripts/rbac-inventory.mjs --format json",
    "rbac:check": "node scripts/rbac-inventory.mjs --check",
    "tenant-scope:audit": "node scripts/tenant-scope-audit.mjs",
    "tenant-scope:audit:json": "node scripts/tenant-scope-audit.mjs --format json",
    "tenant-scope:check": "node scripts/tenant-scope-audit.mjs --check",
    "tenant-scope:test": "node --test scripts/tenant-scope-audit.test.mjs scripts/tenant-context-coverage.test.mjs",
    "tenant-context:audit": "node scripts/tenant-context-coverage.mjs",
    "tenant-context:audit:json": "node scripts/tenant-context-coverage.mjs --format json",
    "tenant-context:check": "node scripts/tenant-context-coverage.mjs --check",
    "tenant-context:test": "node --test scripts/tenant-context-coverage.test.mjs",
    "prisma:check-keys": "node scripts/check-prisma-query-keys.mjs",
    "prisma:validate": "node scripts/validate-schema.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.8",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.62.0",
    "axios": "^1.18.0",
    "bcrypt": "^5.1.1",
    "bwip-js": "^4.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "multer": "^2.3.0",
    "openid-client": "6.8.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "undici": "^6.29.1",
    "uuid": "^11.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/prisma-schema-wasm": "5.22.0-44.605197351a3c8bdd595af2d2a9bc3025bca48ea2",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "pg": "^8.13.1",
    "prettier": "^3.2.5",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "tar": "^7.5.22",
    "body-parser": "^1.20.6",
    "file-type": "^21.3.1",
    "glob": "^10.5.0",
    "js-yaml": "^4.3.2",
    "lodash": "^4.18.1",
    "multer": "^2.3.0",
    "picomatch": "^4.0.4",
    "qs": "^6.16.0",
    "socket.io-parser": "^4.2.7",
    "tmp": "^0.2.6"
  }
}
