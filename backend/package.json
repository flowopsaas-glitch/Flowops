{
  "name": "flowops-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "start:dev": "concurrently -k --names \"API,WEB\" -c \"cyan,magenta\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "build": "nest build",
    "frontend:dev": "cd ../frontend && vite --port 5173",
    "frontend:build": "cd ../frontend && vite build",
    "backend:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "tenant:link": "ts-node prisma/link-tenant.ts",
    "lint": "eslint '{src,frontend}/**/*.{ts,tsx}' --fix",
    "format": "prettier --write '{src,frontend}/**/*.{ts,tsx,js,jsx,json,css,scss,md}'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "10.4.22",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-socket.io": "10.3.10",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/serve-static": "4.0.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "11.0.0",
    "@nestjs/websockets": "10.3.10",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "2.4.3",
    "bullmq": "^5.76.8",
    "bwip-js": "^4.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cli-table3": "^0.6.5",
    "compression": "^1.8.1",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.7",
    "openai": "^6.36.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdfkit": "^0.18.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "10.3.2",
    "@nestjs/testing": "10.3.10",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "8.0.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "pnpm": {
    "allowedBuildScripts": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "msgpackr-extract"
    ],
    "ignoredBuilds": []
  }
}
