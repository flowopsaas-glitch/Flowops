{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],

    "rootDir": "src",
    "outDir": "dist",

    "strict": false,
    "noImplicitAny": false,
    "strictPropertyInitialization": false,

    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"]
  },

  "include": [
    "src/**/*.ts",
    "src/types/**/*.d.ts"
  ],

  "exclude": [
    "**/*.bak.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "node_modules",
    "dist",
    "disabled"
  ]
}
