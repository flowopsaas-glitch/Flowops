# ──────────────────────────────────────────────────────────────────────────
# FlowOps — SELF-HOSTED / ON-PREMISE configuration
#
# For customers who want to run FlowOps entirely on their own server (a VPS,
# an office box, or an air-gapped on-prem machine) with NO dependency on any
# external cloud service. The bundled docker-compose.yml ships its own
# Postgres + Redis; only the four core values below are required for normal use.
#
#   cp .env.selfhosted.example .env
#   # set the four REQUIRED values below, then follow deploy/SELF-HOSTING.md
#
# Generate independent secrets quickly (run once for each value):
#   openssl rand -base64 36
# ──────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────
# The stack will refuse to start until these four are set. Generate a distinct
# value for each; JWT_SECRET and JWT_REFRESH_SECRET must never be identical.

# Database password for the bundled Postgres container.
POSTGRES_PASSWORD=change-me-strong-db-password

# Separate secrets for access-token signing and refresh-token signing.
JWT_SECRET=change-me-long-random-jwt-secret
JWT_REFRESH_SECRET=change-me-different-long-random-refresh-secret
# Optional independent OTP HMAC key (32+ random bytes); blank derives a domain-separated key from JWT_SECRET.
OTP_HMAC_SECRET=

# Password for the first platform owner account (login: owner@flowops.local).
OWNER_SEED_PASSWORD=change-me-owner-login-password

# ── OPTIONAL — local tuning ──────────────────────────────────────────────────
# Sensible defaults are baked into docker-compose.yml; override only if needed.

# Host port the web UI is published on (browse http://SERVER_IP:8080).
FRONTEND_HOST_PORT=8080

# The public URL users reach the app on. Used in verification/reset emails.
# For a plain LAN/VPS install this is fine as the IP; behind a domain/tunnel
# set it to e.g. https://flowops.yourcompany.local
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
# Public backend URL including /api/v1; update this when serving behind HTTPS.
API_PUBLIC_URL=http://localhost:8080/api/v1

# SSO is optional. To enable it, set a stable independent 32-byte key; generate
# with `openssl rand -base64 32`. Keep it in your secret manager and do not
# rotate or lose it without re-entering every tenant's IdP client secret.
SSO_SECRET_ENCRYPTION_KEY=

# Owner login email (defaults to owner@flowops.local if omitted).
OWNER_SEED_EMAIL=owner@flowops.local

# Database name/user for the bundled Postgres (defaults: flowops / flowops).
POSTGRES_USER=flowops
POSTGRES_DB=flowops

# ── OPTIONAL — external integrations (leave BLANK for a pure offline install) ──
# FlowOps degrades gracefully when these are empty: file uploads fall back to
# local handling, and email/WhatsApp/Paystack features simply stay dormant
# until you supply credentials. None are required to run the core platform.

# File storage (Cloudflare R2 / S3-compatible). Blank = feature dormant.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=flowops-waybills
CLOUDFLARE_R2_PUBLIC_URL=

# Transactional email (SendGrid). Blank = emails are skipped (logged only).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@flowops.local

# WhatsApp (Meta Cloud API). Blank = WhatsApp hub stays inactive.
# NOTE: now a FALLBACK only — tenants connect their own number (Meta or Telesign)
# self-service under Settings → Integrations.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=flowops-webhook-verify
WHATSAPP_APP_SECRET=

# Encrypts per-tenant integration secrets (WhatsApp / Shopify / WooCommerce) at
# rest. Generate with: openssl rand -base64 32  (32-byte base64). Required for
# tenants to save integration secrets; falls back to CUSTOMS_EDI_KEY if blank.
INTEGRATIONS_ENC_KEY=

# Payments (Paystack). Blank = billing/subscription features stay inactive.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=


# ── OPTIONAL — AI & Competitive Intelligence (CLAW) ───────────────────────────
# Powers Ask FlowOps, CLAW chat, the AI Support Agent, Courier orchestration,
# the Observatory, and the owner "Plan build" / competitive-intel sweep.
# Blank = those features fall back to graceful canned replies / template plans.
#
# IMPORTANT: docker-compose reads these from THIS root .env (next to
# docker-compose.yml) and passes them to the api container. Putting them only
# in backend/.env will NOT reach the container.
GROQ_API_KEY=
TAVILY_API_KEY=

# CLAW Build Planner → GitHub issue handoff (owner console). Optional.
# GITHUB_REPO is "owner/name"; GITHUB_TOKEN is a fine-grained PAT (issues:write).
GITHUB_REPO=
GITHUB_TOKEN=
