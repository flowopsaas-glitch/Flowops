import React, { useEffect, useMemo, useState } from "react";
import { NavLink, Outlet, useLocation, useNavigate } from "react-router-dom";
import {
  LayoutDashboard,
  Package,
  FileText,
  Receipt,
  Users,
  Menu,
  X,
  Sparkles,
  Search,
  ClipboardList,
  Truck,
  ClipboardCheck,
  Route,
  MessageCircle,
  Mail,
  ScrollText,
  CreditCard,
  Settings,
  ShieldAlert,
  Bell,
  Download,
  LogOut,
} from "lucide-react";

import { cn } from "../../lib/utils";
import logo from "../../assets/logo.png";

type NavItem = {
  label: string;
  desc: string;
  to: string;
  icon: React.ComponentType<{ className?: string }>;
  section: "CORE" | "OPS" | "COMMUNICATIONS" | "BILLING" | "AI" | "ADMIN";
};

type DeferredInstallPrompt = Event & {
  prompt: () => Promise<void>;
  userChoice?: Promise<{ outcome: "accepted" | "dismissed"; platform: string }>;
};

function SidebarSection(props: {
  title: string;
  items: NavItem[];
  currentPath: string;
  onNavigate: () => void;
}) {
  if (!props.items.length) return null;

  return (
    <div className="mb-6">
      <div className="mb-2 px-4 text-[10px] font-black uppercase tracking-[0.24em] text-white/38">
        {props.title}
      </div>

      <div className="space-y-1.5 px-2">
        {props.items.map((item) => {
          const Icon = item.icon;

          return (
            <NavLink
              key={item.to}
              to={item.to}
              onClick={props.onNavigate}
              className={({ isActive }) =>
                cn(
                  "group flex items-start gap-3 rounded-2xl border px-3 py-3 transition",
                  isActive || props.currentPath.startsWith(item.to)
                    ? "border-sky-300/20 bg-sky-300/10 text-white"
                    : "border-transparent bg-transparent text-white/72 hover:border-white/8 hover:bg-white/[0.04] hover:text-white",
                )
              }
            >
              <div className="mt-0.5 rounded-xl border border-white/10 bg-white/[0.05] p-2">
                <Icon className="h-4 w-4" />
              </div>

              <div className="min-w-0 flex-1">
                <div className="text-sm font-bold leading-5">{item.label}</div>
                <div className="mt-0.5 text-[11px] leading-4 text-white/45">
                  {item.desc}
                </div>
              </div>
            </NavLink>
          );
        })}
      </div>
    </div>
  );
}

function SidebarContent(props: {
  grouped: Record<string, NavItem[]>;
  currentPath: string;
  onNavigate: () => void;
  canInstall: boolean;
  onInstall: () => void;
  onLogout: () => void;
}) {
  return (
    <div className="flex h-full flex-col">
      <div className="border-b border-white/10 px-5 py-5">
        <div className="flex items-center gap-3">
          <img
            src={logo}
            alt="FlowOps"
            className="h-12 w-12 rounded-2xl border border-white/10 bg-white/5 object-cover"
          />

          <div className="min-w-0">
            <div className="text-lg font-black tracking-tight text-white">
              FlowOps
            </div>
            <div className="text-[11px] font-bold uppercase tracking-[0.18em] text-sky-200/65">
              Ops Command Center
            </div>
          </div>
        </div>
      </div>

      <div className="flex-1 overflow-y-auto py-4">
        <SidebarSection
          title="Core"
          items={props.grouped.CORE || []}
          currentPath={props.currentPath}
          onNavigate={props.onNavigate}
        />
        <SidebarSection
          title="Operations"
          items={props.grouped.OPS || []}
          currentPath={props.currentPath}
          onNavigate={props.onNavigate}
        />
        <SidebarSection
          title="Communications"
          items={props.grouped.COMMUNICATIONS || []}
          currentPath={props.currentPath}
          onNavigate={props.onNavigate}
        />
        <SidebarSection
          title="Billing"
          items={props.grouped.BILLING || []}
          currentPath={props.currentPath}
          onNavigate={props.onNavigate}
        />
        <SidebarSection
          title="AI"
          items={props.grouped.AI || []}
          currentPath={props.currentPath}
          onNavigate={props.onNavigate}
        />
        <SidebarSection
          title="Admin"
          items={props.grouped.ADMIN || []}
          currentPath={props.currentPath}
          onNavigate={props.onNavigate}
        />
      </div>

      <div className="border-t border-white/10 p-4">
        <div className="grid gap-2">
          <button
            type="button"
            onClick={props.onInstall}
            disabled={!props.canInstall}
            className={
              props.canInstall
                ? "flex items-center justify-center gap-2 rounded-2xl border border-sky-300/20 bg-sky-300/10 px-4 py-3 text-sm font-bold text-sky-100 transition hover:bg-sky-300/20"
                : "flex cursor-not-allowed items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm font-bold text-white/40"
            }
            title={props.canInstall ? "Install FlowOps" : "Install App not available yet"}
          >
            <Download className="h-4 w-4" />
            Install App
          </button>

          <button
            type="button"
            onClick={props.onLogout}
            className="flex items-center justify-center gap-2 rounded-2xl border border-red-400/20 bg-red-500/10 px-4 py-3 text-sm font-bold text-red-100 transition hover:bg-red-500/20"
          >
            <LogOut className="h-4 w-4" />
            Logout
          </button>
        </div>
      </div>
    </div>
  );
}

export default function AppLayout() {
  const [mobileOpen, setMobileOpen] = useState(false);
  const [installPrompt, setInstallPrompt] = useState<DeferredInstallPrompt | null>(null);
  const location = useLocation();
  const navigate = useNavigate();

  const nav: NavItem[] = useMemo(
    () => [
      {
        section: "CORE",
        label: "Dashboard",
        desc: "Executive overview",
        to: "/dashboard",
        icon: LayoutDashboard,
      },
      {
        section: "CORE",
        label: "Shipments",
        desc: "Operations table",
        to: "/shipments",
        icon: Package,
      },
      {
        section: "CORE",
        label: "Waybill Inbox",
        desc: "Inbound OCR and review",
        to: "/waybills/inbox",
        icon: Search,
      },
      {
        section: "CORE",
        label: "Waybills",
        desc: "Waybill register",
        to: "/waybills",
        icon: ClipboardList,
      },
      {
        section: "CORE",
        label: "Clients",
        desc: "Client and contract data",
        to: "/clients",
        icon: Users,
      },
      {
        section: "CORE",
        label: "Notifications",
        desc: "Alerts and workflow signals",
        to: "/notifications",
        icon: Bell,
      },
      {
        section: "OPS",
        label: "Collections",
        desc: "Book, assign, and AI-rank collections",
        to: "/collections",
        icon: Truck,
      },
      {
        section: "OPS",
        label: "POD / Deliveries",
        desc: "Delivery proof and evidence",
        to: "/pod-deliveries",
        icon: ClipboardCheck,
      },
      {
        section: "OPS",
        label: "Driver Dispatch",
        desc: "Route execution and driver load",
        to: "/driver-dispatch",
        icon: Route,
      },
      {
        section: "COMMUNICATIONS",
        label: "WhatsApp",
        desc: "Messaging and customer updates",
        to: "/whatsapp",
        icon: MessageCircle,
      },
      {
        section: "COMMUNICATIONS",
        label: "Email",
        desc: "Operational communication hub",
        to: "/email",
        icon: Mail,
      },
      {
        section: "COMMUNICATIONS",
        label: "Client Queries",
        desc: "Support and query handling",
        to: "/communications/client-queries",
        icon: ScrollText,
      },
      {
        section: "BILLING",
        label: "Rate Cards",
        desc: "Commercial pricing engine",
        to: "/rate-cards",
        icon: CreditCard,
      },
      {
        section: "BILLING",
        label: "Billing Batches",
        desc: "Batch billing and reconciliation",
        to: "/billing-batches",
        icon: FileText,
      },
      {
        section: "BILLING",
        label: "Invoice Drafts",
        desc: "Draft invoice review and export",
        to: "/invoice-drafts",
        icon: Receipt,
      },
      {
        section: "BILLING",
        label: "Invoices",
        desc: "Issued invoices and status",
        to: "/invoices",
        icon: FileText,
      },
      {
        section: "BILLING",
        label: "Credit Control",
        desc: "Collections and debtor control",
        to: "/billing/client-portal-links",
        icon: ShieldAlert,
      },
      {
        section: "AI",
        label: "AI Control Tower",
        desc: "AI insights and automation",
        to: "/ai/control-tower",
        icon: Sparkles,
      },
      {
        section: "AI",
        label: "Risks / Exceptions",
        desc: "Risk queues and anomalies",
        to: "/ops/high-risk-queue",
        icon: ShieldAlert,
      },
      {
        section: "ADMIN",
        label: "Users & Roles",
        desc: "Tenant access and permissions",
        to: "/admin/users-roles",
        icon: Users,
      },
      {
        section: "ADMIN",
        label: "Settings",
        desc: "Tenant configuration and controls",
        to: "/settings",
        icon: Settings,
      },
    ],
    [],
  );

  const grouped = useMemo(() => {
    return nav.reduce<Record<string, NavItem[]>>((acc, item) => {
      if (!acc[item.section]) acc[item.section] = [];
      acc[item.section].push(item);
      return acc;
    }, {});
  }, [nav]);

  useEffect(() => {
    const handler = (event: Event) => {
      event.preventDefault();
      setInstallPrompt(event as DeferredInstallPrompt);
    };

    window.addEventListener("beforeinstallprompt", handler as EventListener);
    return () => {
      window.removeEventListener("beforeinstallprompt", handler as EventListener);
    };
  }, []);

  const handleInstall = async () => {
    if (!installPrompt) return;
    await installPrompt.prompt();
    setInstallPrompt(null);
  };

  const handleLogout = () => {
    localStorage.removeItem("flowops_token");
    localStorage.removeItem("flowops_user");
    localStorage.removeItem("token");
    localStorage.removeItem("user");
    sessionStorage.clear();
    navigate("/tenant-admin/login");
  };

  return (
    <div className="min-h-screen bg-[#050b14] text-white">
      <div className="flex min-h-screen">
        <aside className="hidden w-[320px] shrink-0 border-r border-white/10 bg-[#081120] lg:block">
          <SidebarContent
            grouped={grouped}
            currentPath={location.pathname}
            onNavigate={() => setMobileOpen(false)}
            canInstall={!!installPrompt}
            onInstall={handleInstall}
            onLogout={handleLogout}
          />
        </aside>

        {mobileOpen && (
          <div className="fixed inset-0 z-50 flex lg:hidden">
            <button
              type="button"
              className="absolute inset-0 bg-black/70"
              onClick={() => setMobileOpen(false)}
            />
            <aside className="relative z-10 h-full w-[88%] max-w-[340px] border-r border-white/10 bg-[#081120] shadow-2xl shadow-black/50">
              <div className="flex items-center justify-end p-4">
                <button
                  type="button"
                  onClick={() => setMobileOpen(false)}
                  className="rounded-xl border border-white/10 bg-white/[0.04] p-2 text-white/70 hover:text-white"
                >
                  <X className="h-5 w-5" />
                </button>
              </div>

              <SidebarContent
                grouped={grouped}
                currentPath={location.pathname}
                onNavigate={() => setMobileOpen(false)}
                canInstall={!!installPrompt}
                onInstall={handleInstall}
                onLogout={handleLogout}
              />
            </aside>
          </div>
        )}

        <div className="flex min-w-0 flex-1 flex-col">
          <header className="sticky top-0 z-30 border-b border-white/10 bg-[#081120]/90 backdrop-blur">
            <div className="flex items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
              <div className="flex items-center gap-3">
                <button
                  type="button"
                  onClick={() => setMobileOpen(true)}
                  className="rounded-xl border border-white/10 bg-white/[0.04] p-2 text-white/70 lg:hidden"
                >
                  <Menu className="h-5 w-5" />
                </button>

                <div>
                  <div className="text-xs font-bold uppercase tracking-[0.18em] text-sky-200/65">
                    FlowOps Platform
                  </div>
                  <div className="text-lg font-black tracking-tight text-white">
                    Operations Command Center
                  </div>
                </div>
              </div>

              <div className="hidden items-center gap-2 md:flex">
                <div className="rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-white/55">
                  Tenant Live
                </div>
              </div>
            </div>
          </header>

          <main className="min-h-0 flex-1 bg-[#050b14]">
            <Outlet />
          </main>
        </div>
      </div>
    </div>
  );
}
