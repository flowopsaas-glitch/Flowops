# Build context exclusions for `docker build`. Smaller context = faster
# uploads, smaller image layers, no leaked artefacts.

# Dependencies & build output (re-installed / re-built inside the image)
node_modules
dist
dist-ssr
.cache

# Test artefacts
coverage
playwright-report
test-results
blob-report
playwright/.cache
e2e

# VCS & CI metadata
.git
.gitignore
.github

# Editor & OS junk
.vscode
.idea
.DS_Store
Thumbs.db
*.swp

# Local environment files (never bake secrets into the image)
.env
.env.*
!.env.example
!.env.production.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docs that don't belong in the image
*.md
!README.md

# Don't recursively include the Dockerfile itself
Dockerfile
Dockerfile.*
.dockerignore
