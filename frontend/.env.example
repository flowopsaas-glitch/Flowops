# FlowOps Frontend Environment Variables
# Copy this file to .env (or .env.local) and fill in values.

# ─────────────────────────────────────────────────────────────
# API connectivity (required)
# ─────────────────────────────────────────────────────────────

# Backend API base URL. Used by lib/env.ts → FLOWOPS_API_URL.
# In production this should be an absolute https URL.
# In dev, point at your local backend (e.g. http://localhost:3000/api).
# (For backwards compatibility, VITE_API_BASE_URL is also accepted as an alias
# but new configs should use VITE_API_URL.)
VITE_API_URL=http://localhost:3000/api/v1

# Optional override for the WebSocket origin used by Socket.IO.
# Defaults to FLOWOPS_API_URL with the trailing /api stripped.
# VITE_WS_ORIGIN=

# Build-time application environment marker. Read by lib/env.ts.
# One of: development | staging | production
VITE_APP_ENV=development

# ─────────────────────────────────────────────────────────────
# Error tracking (optional)
# ─────────────────────────────────────────────────────────────

# Sentry DSN — leave blank to disable client-side error tracking.
VITE_SENTRY_DSN=
VITE_APP_VERSION=0.1.0

# Optional Ollama (local LLM) endpoint for the AI copilot dev panel.
# Leave blank in any environment that doesn't host an Ollama server —
# the panel will disable itself rather than calling localhost from a
# production bundle.
# VITE_OLLAMA_URL=http://localhost:11434

# OpenTelemetry OTLP HTTP traces collector endpoint. Defaults to
# http://localhost:4318/v1/traces (matches docker-compose.otel.yml).
# Override in production with your hosted collector URL.
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.your-domain.com/v1/traces

# ─────────────────────────────────────────────────────────────
# Dev-only login autofill (optional)
# ─────────────────────────────────────────────────────────────
# These are read ONLY when import.meta.env.DEV === true, so they
# CANNOT leak into a production bundle. Leave blank in any non-dev
# environment. The login form starts blank if these are unset.
#
# Recommended pattern: keep these in .env.local (which is gitignored)
# rather than committing them to .env.

# VITE_DEV_TENANT_EMAIL=
# VITE_DEV_TENANT_PASSWORD=
# VITE_DEV_OWNER_EMAIL=
# VITE_DEV_OWNER_PASSWORD=
