# FlowOps Frontend Environment Variables
# Copy this file to .env and fill in values

# Backend API URL (required)
VITE_API_URL=/api/v1

# FlowOps API URL for WebSocket connections
VITE_FLOWOPS_API_URL=http://localhost:3005/api

# Optional: Override API base for development
# VITE_API_URL=http://localhost:3005/api/v1

# Error Tracking (optional — leave blank to disable)
VITE_SENTRY_DSN=
VITE_APP_VERSION=0.1.0
