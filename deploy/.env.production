# ══════════════════════════════════════════════════════════════════════════
#  FlowOps — VPS Production Environment (.env)
#
#  Copy this file to the project root as `.env`:
#    cp deploy/.env.production .env
#
#  Then fill in every value marked CHANGE_ME.
#  NEVER commit the filled-in .env to git.
#
#  Generate secrets with:
#    openssl rand -hex 32        # for JWT secrets
#    openssl rand -base64 36     # for passwords
#    openssl rand -base64 32     # for encryption keys
# ══════════════════════════════════════════════════════════════════════════

# ── Docker ────────────────────────────────────────────────────────────────
NODE_ENV=production
IMAGE_TAG=latest

# ── Frontend (Vite build args — baked into the SPA at build time) ─────────
VITE_API_URL=/api/v1
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
VITE_CANONICAL_HOSTS=flowop.work,app.flowop.work
VITE_INTEGRITY_BEACON_URL=

# ── API / Networking ──────────────────────────────────────────────────────
BACKEND_HOST=api
API_PORT=3000
FRONTEND_HOST_PORT=8080
DRIVER_PORTAL_HOST_PORT=8081

# ── Domain / CORS ─────────────────────────────────────────────────────────
APP_URL=https://app.flowop.work
CORS_ORIGINS=https://app.flowop.work,https://driver.flowop.work,https://www.flowop.work
API_PUBLIC_URL=https://api.flowop.work/api/v1

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=flowops
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=flowops

# ── Redis ─────────────────────────────────────────────────────────────────
# No password needed — Redis is internal-only (not exposed to host)

# ── Authentication ────────────────────────────────────────────────────────
# Generate DIFFERENT values for each:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Owner (platform super-admin — seeded on first boot) ───────────────────
OWNER_SEED_EMAIL=flowopsaas@gmail.com
OWNER_SEED_PASSWORD=CHANGE_ME_STRONG_OWNER_PASSWORD

# ── Cloudflare R2 (file uploads — waybill scans, POD images) ─────────────
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Leave empty to use local disk storage (uploads/ folder) instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=flowops-waybills
CLOUDFLARE_R2_PUBLIC_URL=

# ── Email — SendGrid ──────────────────────────────────────────────────────
# Required for: waybill notifications, password reset, trial warnings.
# Get from: SendGrid Dashboard → Settings → API Keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@flowop.work
SENDGRID_FROM_NAME=FlowOps

# ── Paystack (payments / subscriptions) ───────────────────────────────────
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PROFESSIONAL_PLAN_CODE=PLN_l3kobthzahnkpf3
PAYSTACK_ENTERPRISE_PLAN_CODE=PLN_9at9kn2ra8jtae0
PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220

# ── WhatsApp (Meta Cloud API — optional) ──────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=flowops-webhook-verify
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# ── Per-tenant integration encryption key ─────────────────────────────────
# Encrypts tenant secrets (WhatsApp, Shopify, WooCommerce) at rest.
# Generate: openssl rand -base64 32
INTEGRATIONS_ENC_KEY=CHANGE_ME_RUN_openssl_rand_base64_32

# ── AI & Competitive Intelligence (CLAW) ─────────────────────────────────
# Powers Ask FlowOps copilot, CLAW reasoning, AI Support Agent.
# Blank = graceful fallback. Get from: https://console.groq.com/keys
GROQ_API_KEY=
TAVILY_API_KEY=
TAVILY_TIMEOUT_MS=15000
CLOUDFLARE_API_TOKEN=
CLAW_AGGRESSION_LEVEL=MEDIUM

# ── CLAW Build Planner → GitHub issue handoff (optional) ──────────────────
GITHUB_REPO=
GITHUB_TOKEN=

# ── Accounting integrations (Xero / Sage — optional) ─────────────────────
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=

# ── Geocoding ─────────────────────────────────────────────────────────────
GEOCODER_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=
DEFAULT_COUNTRY=za
