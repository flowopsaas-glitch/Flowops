# ── FlowOps stack — root .env.example ─────────────────────────────────────
# Copy to .env and fill in real values before running `docker compose up`.
# .env is gitignored. Never commit real secrets.

# ─── Docker / Image tags ──────────────────────────────────────────────────
NODE_ENV=production
IMAGE_TAG=latest
FRONTEND_IMAGE=ghcr.io/flowopsaas-glitch/flowops-frontend:latest
BACKEND_IMAGE=ghcr.io/flowopsaas-glitch/flowops-backend:latest

# ─── Frontend (Vite build args) ───────────────────────────────────────────
VITE_API_URL=/api/v1
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ─── API / Nginx proxy ────────────────────────────────────────────────────
BACKEND_HOST=api
API_PORT=3000
FRONTEND_HOST_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=flowops
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
POSTGRES_DB=flowops

# ─── Auth ─────────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# IMPORTANT: JWT_SECRET and JWT_REFRESH_SECRET MUST be different values.
# The backend will refuse to start if they are the same.
# A shared secret means a stolen access token can also be used to forge refresh tokens.
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_64_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_SECRET_ALSO_64_BYTES
# Optional independent OTP HMAC key (32+ random bytes); blank derives a domain-separated key from JWT_SECRET.
OTP_HMAC_SECRET=
# Dedicated 32-byte AES-256-GCM key for OIDC client secrets. Generate with:
# openssl rand -base64 32 — store securely and keep stable across restarts.
SSO_SECRET_ENCRYPTION_KEY=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Security posture (RBAC strict mode) ──────────────────────────────────
# RBAC_STRICT=true makes RolesGuard return 403 for any route that carries no
# deliberate access decision (@Roles / @AnyAuthenticated / @Public /
# @OwnerOnly). The route inventory is at zero undecided (838 routes,
# `cd backend && npm run rbac:check`) and CI runs the backend suite with this
# forced on, so strict is the supported posture for a deployed stack.
#
# This key MUST be listed in the api service `environment:` allowlist in
# docker-compose.yml (it is — `RBAC_STRICT: ${RBAC_STRICT:-false}`). Compose
# does not pass the whole .env into a container that declares `environment:`
# and no `env_file:`, so setting it here only works because that line exists.
# Leaving it unset or false is safe locally; production should set true.
RBAC_STRICT=false

# ─── Owner (platform super-admin) — seeded on first boot ──────────────────
OWNER_SEED_EMAIL=owner@flowops.local
OWNER_SEED_PASSWORD=CHANGE_ME_STRONG_OWNER_PASSWORD

# ─── Cloudflare R2 (waybill + POD file storage) ───────────────────────────
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=flowops-waybills
# Public CDN URL for the bucket (configure a custom domain on the R2 bucket)
CLOUDFLARE_R2_PUBLIC_URL=https://assets.flowops.example

# ─── WhatsApp (Meta Business Cloud API) ───────────────────────────────────
#
# HOW TO GET YOUR CREDENTIALS:
# 1. Go to: https://developers.facebook.com/apps/
# 2. Create or open your app → Add WhatsApp product
# 3. WhatsApp → API Setup:
#    • WHATSAPP_PHONE_NUMBER_ID  = the numeric ID shown next to your test/production number
#    • WHATSAPP_ACCESS_TOKEN     = generate a permanent token:
#        Business Settings → System Users → Create system user → Add assets (WhatsApp)
#        → Generate token (choose whatsapp_business_messaging, whatsapp_business_management)
# 4. WhatsApp → Configuration → Webhook:
#    • URL = https://your-domain.com/api/v1/whatsapp/webhook
#    • WHATSAPP_WEBHOOK_VERIFY_TOKEN = any random string you choose (must match here)
#    • Subscribe to: messages, message_deliveries, message_reads
# 5. App → Settings → Basic → App Secret = WHATSAPP_APP_SECRET
#
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_YOUR_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_YOUR_PERMANENT_ACCESS_TOKEN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_ANY_RANDOM_STRING
WHATSAPP_APP_SECRET=CHANGE_ME_YOUR_META_APP_SECRET
WHATSAPP_API_VERSION=v19.0
#
# NOTE: The above WHATSAPP_* vars are now a FALLBACK only. Tenants connect their
# OWN WhatsApp number (Meta Cloud API or Telesign) and Shopify/WooCommerce stores
# self-service under Settings → Integrations — stored encrypted per-tenant.
#
# INTEGRATIONS_ENC_KEY encrypts those per-tenant secrets at rest (AES-256-GCM).
# Generate a 32-byte base64 key:  openssl rand -base64 32
# Without it, tenants cannot SAVE integration secrets. Reuses CUSTOMS_EDI_KEY if
# that's already set and INTEGRATIONS_ENC_KEY is blank.
INTEGRATIONS_ENC_KEY=CHANGE_ME_RUN_openssl_rand_base64_32

# ─── Paystack ─────────────────────────────────────────────────────────────
#
# HOW TO GET YOUR CREDENTIALS:
# 1. Go to: https://dashboard.paystack.com/#/settings/developer
# 2. API Keys & Webhooks:
#    • PAYSTACK_SECRET_KEY  = secret key (sk_live_... or sk_test_... for testing)
#    • PAYSTACK_PUBLIC_KEY  = public key (pk_live_... or pk_test_...) — used on frontend
# 3. Webhooks tab → Add new webhook:
#    • URL = https://your-domain.com/api/v1/paystack/webhook
#    • Subscribe to: charge.success, invoice.payment_failed, subscription.*
# 4. Paystack only sends from these IPs — keep in PAYSTACK_WEBHOOK_IPS:
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME_COPY_FROM_PAYSTACK_DASHBOARD
PAYSTACK_PUBLIC_KEY=pk_test_fa7d0085df63bad80b49faefefb
# Frontend also needs this — set as VITE_PAYSTACK_PUBLIC_KEY in docker-compose.yml
PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220
# Plan codes (Flowops Holdings, ID: 1839930):
# Starter is FREE — no Paystack subscription needed (activated instantly, no billing)
#   Professional: ZAR 19,999 / month
PAYSTACK_PROFESSIONAL_PLAN_CODE=PLN_l3kobthzahnkpf3
#   Enterprise:   Custom pricing (contact sales, asking ZAR 100,000 / month)
PAYSTACK_ENTERPRISE_PLAN_CODE=PLN_9at9kn2ra8jtae0

# ─── SendGrid (transactional email) ──────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.CHANGE_ME
SENDGRID_FROM_EMAIL=noreply@flowops.example
SENDGRID_FROM_NAME=FlowOps


# ── AI & Competitive Intelligence (CLAW) ──────────────────────────────────────
# Powers Ask FlowOps, CLAW chat, AI Support Agent, Courier orchestration, the
# Observatory, and the owner "Plan build" / competitive-intel sweep.
# Blank = graceful fallback (canned replies / deterministic template build plans).
#
# IMPORTANT: docker-compose substitutes these from THIS root .env (next to
# docker-compose.yml) into the api container. A key set only in backend/.env
# is NOT seen by the container.
GROQ_API_KEY=
TAVILY_API_KEY=

# CLAW Build Planner → GitHub issue handoff (owner console). Optional.
GITHUB_REPO=
GITHUB_TOKEN=

# AI safety switches — fail-closed in production (see .env.production.example).
# ALLOW_AI_SELF_REPAIR=
# ALLOW_AI_CHAOS_SIMULATION=

# ── Process Control & Product Master (Process Book / SOP execution) ───────────
# Versioned standards (Process Book), execution with evidence, exception
# ownership, measured outcomes and controlled change — plus governed
# Product / Variant / SKU master data. See
# docs/PROCESS-STANDARDISATION-MASTER-DATA-IMPLEMENTATION-CHARTER-DRAFT-2026-09-26.md
#
# ALL OFF BY DEFAULT. Nothing executes, records, allocates a SKU or alters the
# goods-receipt flow until these are explicitly enabled in a NON-production
# environment. In NODE_ENV=production the capability refuses to run even if the
# flags below are set, unless the matching *_PRODUCTION_ALLOWED flag is set by a
# human after the production gates are signed off.
PROCESS_CONTROL_ENABLED=false

# Goods-receipt bridge: drives the WMS.GOODS_RECEIPT standard from the WMS
# receiving flow. Requires PROCESS_CONTROL_ENABLED=true as well.
PROCESS_CONTROL_WMS_RECEIPT_ENABLED=false

# Enforcement: when false (default) the standard observes and records exceptions
# but never stops a clerk finishing a receipt — the safe way to pilot. When true,
# a receipt with blocking exceptions cannot be completed in the WMS.
PROCESS_CONTROL_WMS_RECEIPT_ENFORCE=false

# Production unlock (leave unset/false until pilot + security gates pass).
PROCESS_CONTROL_PRODUCTION_ALLOWED=false

# Product / Variant / SKU master data. Defaults to PROCESS_CONTROL_ENABLED when
# unset.
PRODUCT_MASTER_ENABLED=false
PRODUCT_MASTER_PRODUCTION_ALLOWED=false
