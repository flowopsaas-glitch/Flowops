# Root .env.example for `docker compose up`.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# This file controls the docker-compose.yml. Frontend Vite-time env vars
# (VITE_*) live here too because compose passes them as build args to the
# frontend image. Frontend dev workflows still also use frontend/.env.local
# when running `npm run dev` directly (without compose).

# ─── Image tags ─────────────────────────────────────────────────────
# Set BACKEND_IMAGE to your published backend image tag once that repo
# starts pushing to a registry. Until then, `docker compose up` will fail
# at the api service with a clear "image not found" error — that's
# intentional, see docs/DEPLOYMENT.md.
BACKEND_IMAGE=
FRONTEND_IMAGE=flowops/frontend:dev
IMAGE_TAG=dev

# ─── Frontend (Vite build args, baked into the bundle) ─────────────
VITE_API_URL=/api
VITE_APP_ENV=production
VITE_APP_VERSION=0.0.0
VITE_SENTRY_DSN=
VITE_OLLAMA_URL=
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Frontend (runtime, substituted into nginx upstream) ───────────
BACKEND_HOST=api
API_PORT=3000
FRONTEND_HOST_PORT=8080

# ─── Backend (read by the api service) ──────────────────────────────
NODE_ENV=production
# Generate with: openssl rand -base64 32
JWT_SECRET=

# ─── Database ───────────────────────────────────────────────────────
POSTGRES_USER=flowops
POSTGRES_DB=flowops
# Generate with: openssl rand -base64 24 | tr -d '=/+'
POSTGRES_PASSWORD=
