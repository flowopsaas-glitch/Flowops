# ── FlowOps stack — root .env.example ─────────────────────────────────────
# Copy to .env and fill in real values before running `docker compose up`.
# .env is gitignored. Never commit real secrets.

# ─── Docker / Image tags ──────────────────────────────────────────────────
NODE_ENV=production
IMAGE_TAG=latest
FRONTEND_IMAGE=ghcr.io/flowopsaas-glitch/flowops-frontend:latest
BACKEND_IMAGE=ghcr.io/flowopsaas-glitch/flowops-backend:latest

# ─── Frontend (Vite build args) ───────────────────────────────────────────
VITE_API_URL=/api
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ─── API / Nginx proxy ────────────────────────────────────────────────────
BACKEND_HOST=api
API_PORT=3000
FRONTEND_HOST_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=flowops
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
POSTGRES_DB=flowops

# ─── Auth ─────────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_64_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Owner (platform super-admin) — seeded on first boot ──────────────────
OWNER_SEED_EMAIL=owner@flowops.local
OWNER_SEED_PASSWORD=CHANGE_ME_STRONG_OWNER_PASSWORD

# ─── Cloudflare R2 (waybill + POD file storage) ───────────────────────────
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=flowops-waybills
# Public CDN URL for the bucket (configure a custom domain on the R2 bucket)
CLOUDFLARE_R2_PUBLIC_URL=https://assets.flowops.example

# ─── WhatsApp (Meta Business Cloud API) ───────────────────────────────────
#
# HOW TO GET YOUR CREDENTIALS:
# 1. Go to: https://developers.facebook.com/apps/
# 2. Create or open your app → Add WhatsApp product
# 3. WhatsApp → API Setup:
#    • WHATSAPP_PHONE_NUMBER_ID  = the numeric ID shown next to your test/production number
#    • WHATSAPP_ACCESS_TOKEN     = generate a permanent token:
#        Business Settings → System Users → Create system user → Add assets (WhatsApp)
#        → Generate token (choose whatsapp_business_messaging, whatsapp_business_management)
# 4. WhatsApp → Configuration → Webhook:
#    • URL = https://your-domain.com/api/v1/whatsapp/webhook
#    • WHATSAPP_WEBHOOK_VERIFY_TOKEN = any random string you choose (must match here)
#    • Subscribe to: messages, message_deliveries, message_reads
# 5. App → Settings → Basic → App Secret = WHATSAPP_APP_SECRET
#
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_YOUR_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_YOUR_PERMANENT_ACCESS_TOKEN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_ANY_RANDOM_STRING
WHATSAPP_APP_SECRET=CHANGE_ME_YOUR_META_APP_SECRET
WHATSAPP_API_VERSION=v19.0

# ─── Paystack ─────────────────────────────────────────────────────────────
#
# HOW TO GET YOUR CREDENTIALS:
# 1. Go to: https://dashboard.paystack.com/#/settings/developer
# 2. API Keys & Webhooks:
#    • PAYSTACK_SECRET_KEY  = secret key (sk_live_... or sk_test_... for testing)
#    • PAYSTACK_PUBLIC_KEY  = public key (pk_live_... or pk_test_...) — used on frontend
# 3. Webhooks tab → Add new webhook:
#    • URL = https://your-domain.com/api/v1/paystack/webhook
#    • Subscribe to: charge.success, invoice.payment_failed, subscription.*
# 4. Paystack only sends from these IPs — keep in PAYSTACK_WEBHOOK_IPS:
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME_COPY_FROM_PAYSTACK_DASHBOARD
PAYSTACK_PUBLIC_KEY=pk_test_fa7d0085df63bad80b49faefefb
# Frontend also needs this — set as VITE_PAYSTACK_PUBLIC_KEY in docker-compose.yml
PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220
# Plan codes (Flowops Holdings, ID: 1839930):
# Starter is FREE — no Paystack subscription needed (activated instantly, no billing)
#   Professional: ZAR 14,999 / month
PAYSTACK_PROFESSIONAL_PLAN_CODE=PLN_l3kobthzahnkpf3
#   Enterprise:   ZAR 29,999 / month
PAYSTACK_ENTERPRISE_PLAN_CODE=PLN_9at9kn2ra8jtae0

# ─── SendGrid (transactional email) ──────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.CHANGE_ME
SENDGRID_FROM_EMAIL=noreply@flowops.example
SENDGRID_FROM_NAME=FlowOps


# ── AI & Competitive Intelligence (CLAW) ──────────────────────────────────────
# Powers Ask FlowOps, CLAW chat, AI Support Agent, Courier orchestration, the
# Observatory, and the owner "Plan build" / competitive-intel sweep.
# Blank = graceful fallback (canned replies / deterministic template build plans).
#
# IMPORTANT: docker-compose substitutes these from THIS root .env (next to
# docker-compose.yml) into the api container. A key set only in backend/.env
# is NOT seen by the container.
GROQ_API_KEY=
TAVILY_API_KEY=

# CLAW Build Planner → GitHub issue handoff (owner console). Optional.
GITHUB_REPO=
GITHUB_TOKEN=
