# ─── Secrets ───
.env
.env.*
!.env.example
!.env.production.example
!.env.local.example
!.env.selfhosted.example

# ─── Node ───
node_modules/

# ─── Build artifacts ───
dist/
build/
release/
server-ready/

# ─── Backups (all of them) ──
backup-*/
**/backup-*/
*.bak
*.backup
backend_backup/
database-backups/
cloud-backups/

# ─── Desktop/Electron builds ──
desktop/dist-installer/
desktop/renderer/

# ─── Playwright ──
test-results/
playwright-report/
blob-report/

# ─── Coverage ──
coverage/

# ─── Logs & temp ──
*.log
*.pid
*.txt

# ─── Database dumps ──
*.sql
*.backup
*.pg_dump

# ...but Prisma migrations are the schema's history, not a dump: they must be
# committed, or deployments silently apply nothing (see scripts/verify-migrations.mjs).
!backend/prisma/migrations/**/*.sql

# ─── Uploads ──
uploads/

# ─── Junk directories ──
archive/
signoz/
flowops-web/
platform-control-audit-*/
postman/
electron/

# ─── IDE ──
.idea/
.vscode/
*.swp

# ─── OS ──
.DS_Store
Thumbs.db

# ─── Binary/build files ──
*.exe
*.dll
*.pak
*.bin

# Lockfiles ARE tracked — see frontend/package-lock.json. Removed from
# ignore so `npm ci` is reproducible for every contributor.


# ─── SSH keys / credentials (NEVER commit) ──
*.key
*.pem
*.ppk
id_rsa*
id_ed25519*
*-key.pub
ssh-key-*

# ─── Stray build-log fragments (from redirected docker/npm output) ──
# These were accidentally committed once. Ignore the common fragment names
# so a broken redirect can't re-add them.
sha256:*
exporting
extracting
unpacking
transferring
reading
resolve
naming
nest
CANCELED
ERROR
=
