# Copy to terraform.tfvars and fill in real values.
# `terraform.tfvars` is gitignored — never commit it.

aws_region = "us-east-1"

# ── Frontend CDN ──────────────────────────────────────────────────────────
# All three are REQUIRED for production.

frontend_domain_name         = "app.flowops.example"
frontend_hosted_zone_id      = "Z01234567890ABCDEFGHI"
frontend_acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."

frontend_price_class = "PriceClass_All"

# ── Network ────────────────────────────────────────────────────────────────

vpc_cidr  = "10.0.0.0/16"
az_count  = 3

# ── Backend container ─────────────────────────────────────────────────────
# Pin to a versioned tag — never use `latest` in production.

backend_image          = "ghcr.io/flowopsaas-glitch/flowops-backend:v1.0.0"
backend_container_port = 3000
backend_cpu            = 1024
backend_memory         = 2048
backend_desired_count  = 2

# backend_image_credentials_secret_arn = "arn:aws:secretsmanager:..."

# ── Backend secrets ────────────────────────────────────────────────────────
# backend_secret_arns = {
#   DATABASE_URL = "arn:aws:secretsmanager:us-east-1:123456789012:secret:production/database-url-..."
#   REDIS_URL    = "arn:aws:secretsmanager:us-east-1:123456789012:secret:production/redis-url-..."
#   JWT_SECRET   = "arn:aws:secretsmanager:us-east-1:123456789012:secret:production/jwt-secret-..."
# }

# ── Backend custom domain — REQUIRED ─────────────────────────────────────

backend_domain_name         = "api.flowops.example"
backend_hosted_zone_id      = "Z01234567890ABCDEFGHI"
backend_acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."
