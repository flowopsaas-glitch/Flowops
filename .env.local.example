# ══════════════════════════════════════════════════════════════════════════════
# FlowOps — LOCAL MACHINE .env
# Copy this file to .env in the repo root (same folder as docker-compose.yml)
# NEVER commit the real .env to git — it is gitignored.
# ══════════════════════════════════════════════════════════════════════════════

# ── Docker / images ────────────────────────────────────────────────────────────
NODE_ENV=development
IMAGE_TAG=local

# Use 'build' instead of a registry image for local dev
# (docker compose will build from the Dockerfiles automatically)
FRONTEND_IMAGE=flowops/frontend:local
BACKEND_IMAGE=flowops/backend:local

# ── Server ports ───────────────────────────────────────────────────────────────
FRONTEND_HOST_PORT=8080     # http://localhost:8080 → your app
API_PORT=3000
BACKEND_HOST=api            # nginx → api service name inside compose network

# Public URL of the app (used in email verification links)
APP_URL=http://localhost:8080

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Frontend Vite build args ───────────────────────────────────────────────────
VITE_API_URL=/api/v1
VITE_APP_ENV=development
VITE_APP_VERSION=0.0.0-local
# VITE_SENTRY_DSN=                        ← leave blank until Sentry is set up
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=       ← leave blank until OTel is set up

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=flowops
POSTGRES_PASSWORD=FlowOpsLocal2024!     ← change this to anything strong
POSTGRES_DB=flowops

# ── JWT secrets (pre-generated — change before sharing with anyone) ────────────
JWT_SECRET=e80ac86c107697451b8b7b42a50ea017f603a0c29b70ac6bae1b0682f1c8f16daba21816b11d1ab757caa432f5369628ccb785cca4343e9c416e0fcfb21b201e
JWT_REFRESH_SECRET=5d34f5ebed6201e6d72046cc22dcd1d6f333f884b53a47053aab9de77026e5d0d78eebf43173f28d50d9954fc2991dec7aad06e3f8d68845a824f6359ee505eb
# Optional independent OTP HMAC key (32+ random bytes); blank derives a domain-separated key from JWT_SECRET.
OTP_HMAC_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Owner / platform super-admin (created automatically on first boot) ─────────
OWNER_SEED_EMAIL=owner@flowops.local
OWNER_SEED_PASSWORD=FlowOpsOwner2024!   ← change this — it's your master admin password

# ── Cloudflare R2 (file storage — waybill scans, POD photos, logos) ────────────
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
CLOUDFLARE_R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
CLOUDFLARE_R2_BUCKET_NAME=flowops-waybills
CLOUDFLARE_R2_PUBLIC_URL=                            ← set after creating the bucket + custom domain

# ── WhatsApp (skip for now — add later) ────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=flowops-local-webhook
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# ── Paystack (approve manually for now — add secret key when ready) ────────────
PAYSTACK_SECRET_KEY=                                 ← copy sk_test_... from Paystack dashboard
PAYSTACK_PUBLIC_KEY=pk_test_fa7d0085df63bad80b49faefefb
VITE_PAYSTACK_PUBLIC_KEY=pk_test_fa7d0085df63bad80b49faefefb
PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220
PAYSTACK_PROFESSIONAL_PLAN_CODE=PLN_l3kobthzahnkpf3
PAYSTACK_ENTERPRISE_PLAN_CODE=PLN_9at9kn2ra8jtae0

# ── SendGrid (leave blank until Step 6 email service is set up) ────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@flowops.local
SENDGRID_FROM_NAME=FlowOps
