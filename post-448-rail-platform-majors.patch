+import {
+  boardSummary,
+  craftLabel,
+  fatigueLevel,
+  FATIGUE_CRITICAL_HOURS,
+  FATIGUE_WARN_HOURS,
+  rosterRow,
+  shiftHours,
+  sortRoster,
+} from './fleet-duty.rules';
+
+const NOW = new Date('2026-10-12T18:00:00Z');
+
+describe('fleet-duty.rules — the dispatcher roster', () => {
+  it('shift hours compute to one decimal and never go negative', () => {
+    expect(shiftHours(new Date('2026-10-12T10:00:00Z'), NOW)).toBe(8);
+    expect(shiftHours(new Date('2026-10-12T15:30:00Z'), NOW)).toBe(2.5);
+    expect(shiftHours(new Date('2026-10-12T20:00:00Z'), NOW)).toBe(0);
+    expect(shiftHours(null, NOW)).toBe(0);
+    expect(shiftHours(undefined, NOW)).toBe(0);
+  });
+
+  it('fatigue escalates at the 8h / 10h platform policy lines', () => {
+    expect(fatigueLevel(0)).toBe('OK');
+    expect(fatigueLevel(7.9)).toBe('OK');
+    expect(fatigueLevel(FATIGUE_WARN_HOURS)).toBe('WARN');
+    expect(fatigueLevel(9.9)).toBe('WARN');
+    expect(fatigueLevel(FATIGUE_CRITICAL_HOURS)).toBe('CRITICAL');
+    expect(fatigueLevel(14)).toBe('CRITICAL');
+  });
+
+  it('names the craft in dispatcher language', () => {
+    expect(craftLabel('BAKKIE')).toBe('Bakkie');
+    expect(craftLabel('TRAIN')).toBe('Train driver');
+    expect(craftLabel(null)).toBe('—');
+  });
+
+  it('derives ON_DUTY with vehicle preference: duty reg over driver reg', () => {
+    const on = rosterRow({
+      driverId: 'd1', driverName: 'Thabo',
+      duty: { id: 'duty-1', mode: 'TRUCK', vehicleReg: 'GP 123-456', driverVehicleReg: 'OLD-1', startedAt: new Date('2026-10-12T10:00:00Z') },
+      openLoads: 2, deliveredToday: 3,
+    }, NOW);
+    expect(on.state).toBe('ON_DUTY');
+    expect(on.craft).toBe('Truck');
+    expect(on.vehicleReg).toBe('GP 123-456');
+    expect(on.hoursOnDuty).toBe(8);
+    expect(on.fatigue).toBe('WARN');
+
+    const off = rosterRow({ driverId: 'd2', driverName: 'Ayanda', duty: null, openLoads: 0, deliveredToday: 1 }, NOW);
+    expect(off.state).toBe('OFF_DUTY');
+    expect(off.fatigue).toBe('OK');
+    expect(off.hoursOnDuty).toBe(0);
+  });
+
+  it('sorts duty first, heaviest shift first, and summarises the fleet', () => {
+    const rows = sortRoster([
+      rosterRow({ driverId: 'a', driverName: 'Zanele', duty: null, openLoads: 0, deliveredToday: 0 }, NOW),
+      rosterRow({ driverId: 'b', driverName: 'Kabelo', duty: { id: 'd2', mode: 'BAKKIE', startedAt: new Date('2026-10-12T10:00:00Z') }, openLoads: 1, deliveredToday: 2 }, NOW),
+      rosterRow({ driverId: 'c', driverName: 'Pieter', duty: { id: 'd3', mode: 'LINEHAUL', startedAt: new Date('2026-10-12T15:00:00Z') }, openLoads: 0, deliveredToday: 0 }, NOW),
+    ]);
+    expect(rows.map((r) => r.driverName)).toEqual(['Kabelo', 'Pieter', 'Zanele']);
+
+    const s = boardSummary(rows);
+    expect(s.drivers).toBe(3);
+    expect(s.onDuty).toBe(2);
+    expect(s.offDuty).toBe(1);
+    expect(s.byMode).toEqual({ BAKKIE: 1, LINEHAUL: 1 });
+    expect(s.fatigueWarn).toBe(1);
+    expect(s.openLoads).toBe(1);
+    expect(s.deliveredToday).toBe(2);
+  });
+
+  it('flags a 10h+ shift as CRITICAL in the summary', () => {
+    const rows = [rosterRow({
+      driverId: 'd', driverName: 'Long',
+      duty: { id: 'x', mode: 'TRUCK', startedAt: new Date('2026-10-12T07:59:00Z') },
+      openLoads: 0, deliveredToday: 0,
+    }, NOW)];
+    expect(rows[0].fatigue).toBe('CRITICAL');
+    expect(boardSummary(rows).fatigueCritical).toBe(1);
+  });
+});
diff --git a/backend/src/dispatch/fleet-duty.rules.ts b/backend/src/dispatch/fleet-duty.rules.ts
new file mode 100644
index 0000000..c0181c1
--- /dev/null
+++ b/backend/src/dispatch/fleet-duty.rules.ts
@@ -0,0 +1,122 @@
+/**
+ * Fleet Duty Board rules. Pure, one place, the dispatcher's control-room truth.
+ *
+ * A board row answers five questions at a glance:
+ *   1. Is this driver ON DUTY right now (and since when)?
+ *   2. In which craft (bakkie / bicycle / truck / linehaul / train)?
+ *   3. On which vehicle?
+ *   4. How hard has this shift gone — fatigue level (platform policy: warn at 8h
+ *      continuous duty, critical at 10h — mirror of the NDoT hours-of-service
+ *      envelope; this is an operational warning, not legal advice)?
+ *   5. What is the load — open runs in hand vs runs delivered today?
+ */
+
+export type FatigueLevel = 'OK' | 'WARN' | 'CRITICAL';
+export type DutyState = 'ON_DUTY' | 'OFF_DUTY';
+
+export const FATIGUE_WARN_HOURS = 8;
+export const FATIGUE_CRITICAL_HOURS = 10;
+
+export const CRAFT_LABEL: Record<string, string> = {
+  BICYCLE: 'Bicycle',
+  BAKKIE: 'Bakkie',
+  TRUCK: 'Truck',
+  LINEHAUL: 'Linehaul',
+  TRAIN: 'Train driver',
+};
+
+export function craftLabel(mode: string | null | undefined): string {
+  return CRAFT_LABEL[mode ?? ''] ?? '—';
+}
+
+/** Hours on the current shift, one decimal. 0 when not on duty. */
+export function shiftHours(startedAt: Date | string | null | undefined, now: Date): number {
+  if (!startedAt) return 0;
+  const ms = now.getTime() - new Date(startedAt).getTime();
+  if (!Number.isFinite(ms) || ms < 0) return 0;
+  return Math.round((ms / 3_600_000) * 10) / 10;
+}
+
+export function fatigueLevel(hours: number): FatigueLevel {
+  if (hours >= FATIGUE_CRITICAL_HOURS) return 'CRITICAL';
+  if (hours >= FATIGUE_WARN_HOURS) return 'WARN';
+  return 'OK';
+}
+
+export type RosterRow = {
+  driverId: string;
+  driverName: string;
+  phone: string | null;
+  state: DutyState;
+  mode: string | null;
+  craft: string;
+  vehicleReg: string | null;
+  dutyId: string | null;
+  startedAt: Date | null;
+  hoursOnDuty: number;
+  fatigue: FatigueLevel;
+  openLoads: number;
+  deliveredToday: number;
+};
+
+export function rosterRow(input: {
+  driverId: string;
+  driverName: string;
+  phone?: string | null;
+  duty?: {
+    id: string;
+    mode: string;
+    vehicleReg?: string | null;
+    driverVehicleReg?: string | null;
+    startedAt: Date | string;
+  } | null;
+  openLoads: number;
+  deliveredToday: number;
+}, now: Date): RosterRow {
+  const duty = input.duty ?? null;
+  const hours = duty ? shiftHours(duty.startedAt, now) : 0;
+  return {
+    driverId: input.driverId,
+    driverName: input.driverName,
+    phone: input.phone ?? null,
+    state: duty ? 'ON_DUTY' : 'OFF_DUTY',
+    mode: duty?.mode ?? null,
+    craft: duty ? craftLabel(duty.mode) : '—',
+    vehicleReg: duty?.vehicleReg ?? duty?.driverVehicleReg ?? null,
+    dutyId: duty?.id ?? null,
+    startedAt: duty ? new Date(duty.startedAt) : null,
+    hoursOnDuty: hours,
+    fatigue: duty ? fatigueLevel(hours) : 'OK',
+    openLoads: input.openLoads,
+    deliveredToday: input.deliveredToday,
+  };
+}
+
+/** Duty first, fatigue-heaviest first within duty, then anyone with open loads, then name. */
+export function sortRoster(rows: RosterRow[]): RosterRow[] {
+  const weight = (r: RosterRow) =>
+    (r.state === 'ON_DUTY' ? 0 : 2) + (r.fatigue === 'CRITICAL' ? -1 : r.fatigue === 'WARN' ? 0 : 0.5) * 0.01;
+  return [...rows].sort((a, b) => {
+    const w = weight(a) - weight(b);
+    if (w !== 0) return w;
+    if (a.state !== b.state) return a.state === 'ON_DUTY' ? -1 : 1;
+    if (a.hoursOnDuty !== b.hoursOnDuty) return b.hoursOnDuty - a.hoursOnDuty;
+    return a.driverName.localeCompare(b.driverName);
+  });
+}
+
+export function boardSummary(rows: RosterRow[]) {
+  const onDuty = rows.filter((r) => r.state === 'ON_DUTY');
+  const byMode: Record<string, number> = {};
+  for (const r of onDuty) byMode[r.mode ?? 'UNKNOWN'] = (byMode[r.mode ?? 'UNKNOWN'] ?? 0) + 1;
+  return {
+    drivers: rows.length,
+    onDuty: onDuty.length,
+    offDuty: rows.length - onDuty.length,
+    byMode,
+    fatigueWarn: onDuty.filter((r) => r.fatigue === 'WARN').length,
+    fatigueCritical: onDuty.filter((r) => r.fatigue === 'CRITICAL').length,
+    openLoads: rows.reduce((s, r) => s + r.openLoads, 0),
+    deliveredToday: rows.reduce((s, r) => s + r.deliveredToday, 0),
+  };
+}
