+  return {
+    ...actual,
+    listRailDevices: h.listRailDevices,
+    createRailDevice: h.createRailDevice,
+    rotateDeviceToken: h.rotateDeviceToken,
+    getDevicePoints: h.getDevicePoints,
+    getDeviceSummary: h.getDeviceSummary,
