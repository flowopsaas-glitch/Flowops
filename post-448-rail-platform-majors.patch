+   * outbox writes: pass the `tx` through so everything stays one transaction.
+   */
+  async withTenant<T>(
+    companyId: string,
+    fn: (tx: Prisma.TransactionClient) => Promise<T>,
+    options?: { maxWait?: number; timeout?: number },
