@@ -0,0 +1,109 @@
+import {
+  distanceKmOver, evaluateIngestAlerts, haversineKm, isSilent, normalisePoint, shouldRaiseAlert,
+  MAX_INGEST_BATCH,
+} from './rail-telemetry.rules';
+
+const AS_OF = new Date('2026-10-12T12:00:00Z');
+const good = { lat: -26.2, lng: 28.05, speedKph: 62, batteryPct: 88, recordedAt: '2026-10-12T11:55:00Z' };
+
+describe('rail-telemetry.rules — point validation', () => {
+  it('normalises a good point and defaults recordedAt to now', () => {
+    const r = normalisePoint(good, AS_OF);
+    expect(r.ok).toBe(true);
+    if ('point' in r) {
+      expect(r.point.lat).toBe(-26.2);
+      expect(r.point.speedKph).toBe(62);
+      expect(r.point.doorOpen).toBeNull();
+    }
+    const noTime = normalisePoint({ lat: -26.2, lng: 28.05 }, AS_OF);
+    expect(noTime.ok).toBe(true);
+    if ('point' in noTime) expect(noTime.point.recordedAt.getTime()).toBe(AS_OF.getTime());
+  });
+
+  it('refuses coordinates that would break the map', () => {
+    for (const bad of [
+      { ...good, lat: 200 }, { ...good, lng: -400 }, { ...good, lat: 'x' }, { ...good, lng: null },
+    ]) {
+      const r = normalisePoint(bad, AS_OF);
+      expect(r.ok).toBe(false);
+      if ('reasons' in r) expect(r.reasons.join(' ')).toMatch(/lat|lng/);
+    }
+  });
+
+  it('refuses timestamps from the future beyond clock skew, and fossils', () => {
+    const future = normalisePoint({ ...good, recordedAt: '2026-10-12T12:30:00Z' }, AS_OF);
+    expect(future.ok).toBe(false);
+    const fossil = normalisePoint({ ...good, recordedAt: '2026-06-01T00:00:00Z' }, AS_OF);
+    expect(fossil.ok).toBe(false);
+    if ('reasons' in fossil) expect(fossil.reasons.join(' ')).toContain('older than');
+  });
+
+  it('refuses nonsense sensor readings but allows them to be absent', () => {
+    expect(normalisePoint({ ...good, speedKph: -10 }, AS_OF).ok).toBe(false);
+    expect(normalisePoint({ ...good, batteryPct: 120 }, AS_OF).ok).toBe(false);
+    expect(normalisePoint({ ...good, headingDeg: 400 }, AS_OF).ok).toBe(false);
+    expect(normalisePoint({ ...good, temperatureC: -100 }, AS_OF).ok).toBe(false);
+    expect(normalisePoint({ lat: -26.2, lng: 28.05 }, AS_OF).ok).toBe(true); // sparse point is fine
+  });
+
+  it('keeps the batch cap a hard constant', () => {
+    expect(MAX_INGEST_BATCH).toBe(500);
+  });
+});
+
+describe('rail-telemetry.rules — distance maths', () => {
+  it('computes haversine distances to a sane accuracy', () => {
+    // Johannesburg → Sishen straight-line: Δlng ≈ 5.2° at lat −27 (~515 km) + Δlat ≈ 1.55° (~172 km)
+    // ⇒ hypot ≈ 543 km. (The real rail line is longer; this is the crow-flies check.)
+    const jhb = { lat: -26.2041, lng: 28.0473 };
+    const sishen = { lat: -27.752, lng: 22.85 };
+    const d = haversineKm(jhb, sishen);
+    expect(d).toBeGreaterThan(520);
+    expect(d).toBeLessThan(560);
+    expect(haversineKm(jhb, jhb)).toBe(0);
+  });
+
+  it('sums a trail and rounds to metres-grade precision', () => {
+    const trail = [
+      { lat: -26.2, lng: 28.05 },
+      { lat: -26.21, lng: 28.05 },
+      { lat: -26.22, lng: 28.05 },
+    ];
+    expect(distanceKmOver(trail)).toBeCloseTo(2.22, 1);
+    expect(distanceKmOver([trail[0]])).toBe(0);
+  });
+});
+
+describe('rail-telemetry.rules — health alerts', () => {
+  it('raises speed and battery alerts against device thresholds', () => {
+    const alerts = evaluateIngestAlerts({ speedLimitKph: 80, batteryThresholdPct: 20 }, { speedKph: 95, batteryPct: 12 });
+    expect(alerts.map((a) => a.kind)).toEqual(['SPEED_EXCEEDED', 'BATTERY_LOW']);
+    expect(alerts[0].threshold).toBe(80);
+    expect(alerts[1].threshold).toBe(20);
+  });
+
+  it('uses platform defaults when the device has none', () => {
+    const alerts = evaluateIngestAlerts({}, { speedKph: 86, batteryPct: 14 });
+    expect(alerts.map((a) => a.kind)).toEqual(['SPEED_EXCEEDED', 'BATTERY_LOW']);
+  });
+
+  it('stays quiet for healthy readings and absent sensors', () => {
+    expect(evaluateIngestAlerts({}, { speedKph: 60, batteryPct: 90 })).toEqual([]);
+    expect(evaluateIngestAlerts({}, {})).toEqual([]);
+  });
+
+  it('deduplicates an open alert within the window but re-raises after it', () => {
+    const openRecent = [{ kind: 'SPEED_EXCEEDED', status: 'OPEN', raisedAt: new Date('2026-10-12T11:45:00Z') }];
+    expect(shouldRaiseAlert(openRecent, 'SPEED_EXCEEDED', AS_OF)).toBe(false);
+    const openOld = [{ kind: 'SPEED_EXCEEDED', status: 'OPEN', raisedAt: new Date('2026-10-12T11:00:00Z') }];
+    expect(shouldRaiseAlert(openOld, 'SPEED_EXCEEDED', AS_OF)).toBe(true);
+    const acknowledged = [{ kind: 'SPEED_EXCEEDED', status: 'ACKNOWLEDGED', raisedAt: new Date('2026-10-12T11:45:00Z') }];
+    expect(shouldRaiseAlert(acknowledged, 'SPEED_EXCEEDED', AS_OF)).toBe(true);
+  });
+
+  it('treats never-seen and stale devices as silent', () => {
+    expect(isSilent(null, AS_OF)).toBe(true);
+    expect(isSilent(new Date('2026-10-12T11:00:00Z'), AS_OF)).toBe(false);
+    expect(isSilent('2026-10-12T04:00:00Z', AS_OF)).toBe(true);
+  });
+});
diff --git a/backend/src/rail/rail-telemetry.rules.ts b/backend/src/rail/rail-telemetry.rules.ts
new file mode 100644
index 0000000..e1baa58
--- /dev/null
+++ b/backend/src/rail/rail-telemetry.rules.ts
@@ -0,0 +1,167 @@
+/**
+ * Telemetry foundations — pure rules.
+ *
+ * Everything a device ingest can ever trigger lives here, deterministically:
+ * point validation (a bad coordinate must never reach the map), distance maths
+ * (haversine — the same formula navigation uses), health thresholds, and alert
+ * evaluation with dedupe windows so a jittering sensor cannot spam the console.
+ */
+
+export const MAX_INGEST_BATCH = 500;
+export const DEFAULT_SPEED_LIMIT_KPH = 85;
+export const DEFAULT_BATTERY_THRESHOLD_PCT = 15;
+export const SILENT_AFTER_HOURS = 6;
+export const CLOCK_SKEW_MINUTES = 5;
+export const MAX_POINT_AGE_DAYS = 90;
+export const ALERT_DEDUPE_MINUTES = 30;
+
+export interface RawPoint {
+  recordedAt?: string | Date;
+  lat?: unknown;
+  lng?: unknown;
+  speedKph?: unknown;
+  headingDeg?: unknown;
+  odometerKm?: unknown;
+  batteryPct?: unknown;
+  temperatureC?: unknown;
+  doorOpen?: unknown;
+  raw?: unknown;
+}
+
+export interface NormalisedPoint {
+  recordedAt: Date;
+  lat: number;
+  lng: number;
+  speedKph: number | null;
+  headingDeg: number | null;
+  odometerKm: number | null;
+  batteryPct: number | null;
+  temperatureC: number | null;
+  doorOpen: boolean | null;
+  raw: unknown;
+}
+
+const num = (v: unknown): number | null => {
+  if (v === null || v === undefined || v === '') return null;
+  const n = typeof v === 'number' ? v : Number(v);
+  return Number.isFinite(n) ? n : Number.NaN;
+};
+
+/** Validate one point. Returns the normalised point or the list of reasons it was refused. */
+export function normalisePoint(raw: RawPoint, asOf: Date = new Date()): { ok: true; point: NormalisedPoint } | { ok: false; reasons: string[] } {
+  const reasons: string[] = [];
+
+  const lat = num(raw.lat);
+  const lng = num(raw.lng);
+  if (lat === null || Number.isNaN(lat) || lat < -90 || lat > 90) reasons.push('lat must be a number between -90 and 90');
+  if (lng === null || Number.isNaN(lng) || lng < -180 || lng > 180) reasons.push('lng must be a number between -180 and 180');
+
+  const recordedAt = raw.recordedAt ? new Date(raw.recordedAt) : new Date(asOf);
+  if (Number.isNaN(recordedAt.getTime())) reasons.push('recordedAt is not a valid timestamp');
+  else {
+    if (recordedAt.getTime() > asOf.getTime() + CLOCK_SKEW_MINUTES * 60_000) reasons.push(`recordedAt is more than ${CLOCK_SKEW_MINUTES} minutes in the future`);
+    if (recordedAt.getTime() < asOf.getTime() - MAX_POINT_AGE_DAYS * 86_400_000) reasons.push(`recordedAt is older than ${MAX_POINT_AGE_DAYS} days`);
+  }
+
+  const speedKph = num(raw.speedKph);
+  if (speedKph !== null && (Number.isNaN(speedKph) || speedKph < 0 || speedKph > 1600)) reasons.push('speedKph must be between 0 and 1600');
+
+  const headingDeg = num(raw.headingDeg);
+  if (headingDeg !== null && (Number.isNaN(headingDeg) || headingDeg < 0 || headingDeg > 360)) reasons.push('headingDeg must be between 0 and 360');
+
+  const odometerKm = num(raw.odometerKm);
+  if (odometerKm !== null && (Number.isNaN(odometerKm) || odometerKm < 0)) reasons.push('odometerKm cannot be negative');
+
+  const batteryPct = num(raw.batteryPct);
+  if (batteryPct !== null && (Number.isNaN(batteryPct) || batteryPct < 0 || batteryPct > 100)) reasons.push('batteryPct must be between 0 and 100');
+
+  const temperatureC = num(raw.temperatureC);
+  if (temperatureC !== null && (Number.isNaN(temperatureC) || temperatureC < -80 || temperatureC > 150)) reasons.push('temperatureC must be between -80 and 150');
+
+  if (reasons.length) return { ok: false, reasons };
+
+  return {
+    ok: true,
+    point: {
+      recordedAt,
+      lat: lat as number,
+      lng: lng as number,
+      speedKph,
+      headingDeg,
+      odometerKm,
+      batteryPct,
+      temperatureC,
+      doorOpen: typeof raw.doorOpen === 'boolean' ? raw.doorOpen : null,
+      raw: raw.raw ?? undefined,
+    },
+  };
+}
+
+/** Great-circle distance in km (haversine, R = 6371.0088 — the IUGG mean Earth radius). */
+export function haversineKm(a: { lat: number; lng: number }, b: { lat: number; lng: number }): number {
+  const toRad = (d: number) => (d * Math.PI) / 180;
+  const dLat = toRad(b.lat - a.lat);
+  const dLng = toRad(b.lng - a.lng);
+  const s = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(a.lat)) * Math.cos(toRad(b.lat)) * Math.sin(dLng / 2) ** 2;
+  return 2 * 6371.0088 * Math.asin(Math.min(1, Math.sqrt(s)));
+}
+
+/** Distance travelled over an ordered (oldest → newest) trail. */
+export function distanceKmOver(points: ReadonlyArray<{ lat: number; lng: number }>): number {
+  let total = 0;
+  for (let i = 1; i < points.length; i += 1) total += haversineKm(points[i - 1], points[i]);
+  return Math.round(total * 100) / 100;
+}
+
+export interface AlertDeviceLike {
+  speedLimitKph?: number | null;
+  batteryThresholdPct?: number | null;
+}
+
+export interface ProposedAlert {
+  kind: 'SPEED_EXCEEDED' | 'BATTERY_LOW';
+  message: string;
+  value: number;
+  threshold: number;
+}
+
+/** Health alerts a single ingested point can justify. Silence is computed elsewhere (it needs time, not a point). */
+export function evaluateIngestAlerts(device: AlertDeviceLike, point: { speedKph?: number | null; batteryPct?: number | null }): ProposedAlert[] {
+  const out: ProposedAlert[] = [];
+  const speedLimit = device.speedLimitKph ?? DEFAULT_SPEED_LIMIT_KPH;
+  if (point.speedKph != null && point.speedKph > speedLimit) {
+    out.push({
+      kind: 'SPEED_EXCEEDED',
+      message: `Speed ${Math.round(point.speedKph)} kph exceeds the ${Math.round(speedLimit)} kph limit.`,
+      value: point.speedKph,
+      threshold: speedLimit,
+    });
+  }
+  const batteryFloor = device.batteryThresholdPct ?? DEFAULT_BATTERY_THRESHOLD_PCT;
+  if (point.batteryPct != null && point.batteryPct < batteryFloor) {
+    out.push({
+      kind: 'BATTERY_LOW',
+      message: `Battery at ${Math.round(point.batteryPct)}% is below the ${Math.round(batteryFloor)}% floor.`,
+      value: point.batteryPct,
+      threshold: batteryFloor,
+    });
+  }
+  return out;
+}
+
+/** A device that has not reported within the silence window is a coverage problem, not a crime. */
+export function isSilent(lastSeenAt: Date | string | null | undefined, asOf: Date = new Date()): boolean {
+  if (!lastSeenAt) return true;
+  const seen = typeof lastSeenAt === 'string' ? new Date(lastSeenAt) : lastSeenAt;
+  return asOf.getTime() - seen.getTime() > SILENT_AFTER_HOURS * 3_600_000;
+}
+
+/** Dedupe window: don't raise the same kind again while an open one is recent. */
+export function shouldRaiseAlert(
+  existing: ReadonlyArray<{ kind: string; status: string; raisedAt: Date | string }>,
+  kind: string,
+  asOf: Date = new Date(),
+): boolean {
+  return !existing.some((a) => a.kind === kind && a.status === 'OPEN'
+    && asOf.getTime() - new Date(a.raisedAt).getTime() < ALERT_DEDUPE_MINUTES * 60_000);
+}
