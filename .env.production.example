# ══════════════════════════════════════════════════════════════════════════
#  FlowOps — Production Environment Variables
#  Copy this file to .env and fill in every value marked CHANGE_ME.
#  NEVER commit the filled-in .env to git.
# ══════════════════════════════════════════════════════════════════════════

# ── Docker image tags ─────────────────────────────────────────────────────
IMAGE_TAG=latest

# ── Database ──────────────────────────────────────────────────────────────
# Internal service name "postgres" — this is the docker-compose service.
# Change only if you move Postgres outside of Docker (e.g. Supabase / RDS).
POSTGRES_USER=flowops
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=flowops

# ── Redis ─────────────────────────────────────────────────────────────────
# Internal — docker-compose resolves "redis" automatically.
# Uncomment REDIS_PASSWORD if you add auth to the redis service.
# REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Authentication ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_RUN_COMMAND_ABOVE
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Owner (platform super-admin) ──────────────────────────────────────────
OWNER_SEED_EMAIL=owner@flowops.example
OWNER_SEED_PASSWORD=CHANGE_ME_STRONG_OWNER_PASSWORD

# ── Domain / CORS ─────────────────────────────────────────────────────────
APP_URL=https://app.flowop.work
CORS_ORIGINS=https://app.flowop.work,https://www.flowop.work

# Public base URL of the BACKEND, including the /api/v1 prefix. Required for
# OAuth-style redirect URIs: Enterprise SSO builds its OIDC callback as
# <API_PUBLIC_URL>/sso/callback, and the accounting integrations use
# <API_PUBLIC_URL>/accounting/integrations/callback. On a single-host VPS the
# SPA proxies /api/ to the backend, so this is your public app host + /api/v1.
API_PUBLIC_URL=https://app.flowop.work/api/v1

# ── CLAW Autopilot (Enterprise) ───────────────────────────────────────────
# Default auto-execution aggression when a tenant hasn't overridden it.
# LOW | MEDIUM | HIGH. Optional — defaults to MEDIUM if unset.
CLAW_AGGRESSION_LEVEL=MEDIUM

# ── Frontend build-time vars (baked into the SPA bundle by Vite) ──────────
# IMPORTANT: must be /api/v1 (NOT /api). The SPA's axios client uses this value
# verbatim as its baseURL, and the backend mounts every route under the
# /api/v1 global prefix. The frontend nginx proxies `location /api/` straight
# through to the api service, so /api/v1/* resolves correctly. Setting this to
# just /api makes every request 404.
VITE_API_URL=/api/v1
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# ── Cloudflare R2 (file uploads — waybill scans, POD images) ─────────────
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Leave empty to use local disk storage (uploads/ folder) instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=flowops-waybills
CLOUDFLARE_R2_PUBLIC_URL=

# ── Email — SendGrid ──────────────────────────────────────────────────────
# Required for: waybill status notifications, password reset, trial warnings.
# Get from: SendGrid Dashboard → Settings → API Keys
SENDGRID_API_KEY=SG.CHANGE_ME
SENDGRID_FROM_EMAIL=noreply@flowop.work
SENDGRID_FROM_NAME=FlowOps

# ── Paystack (payments) ───────────────────────────────────────────────────
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME
PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME
PAYSTACK_PROFESSIONAL_PLAN_CODE=PLN_l3kobthzahnkpf3
PAYSTACK_ENTERPRISE_PLAN_CODE=PLN_9at9kn2ra8jtae0
PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220

# ── WhatsApp (optional — click-to-chat uses phone number, no API needed) ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=flowops-webhook-verify
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# ── Geocoding ─────────────────────────────────────────────────────────────
# "nominatim" is free (OpenStreetMap). Switch to "google" or "mapbox" for
# higher rate limits and better accuracy.
GEOCODER_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=
DEFAULT_COUNTRY=za

# ── Sentry (optional error tracking) ─────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
